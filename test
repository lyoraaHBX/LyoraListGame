local LogHistory = {}

local function AddConsoleLog(msg)
    local timestamp = string.format("[%05.2f]", os.clock() % 100)
    table.insert(LogHistory, timestamp .. " " .. msg)
    if #LogHistory > 6 then
        table.remove(LogHistory, 1)
    end
    ConsoleText.Text = table.concat(LogHistory, "\n")
end

local function FadeInHUD()
    TweenService:Create(MainHUD, TweenInfo.new(0.35), {BackgroundTransparency = 0}):Play()
    TweenService:Create(HUDStroke, TweenInfo.new(0.35), {Transparency = 0.3}):Play()
    TweenService:Create(BrandTitle, TweenInfo.new(0.35), {TextTransparency = 0}):Play()
    TweenService:Create(StatusLED, TweenInfo.new(0.35), {BackgroundTransparency = 0}):Play()
    TweenService:Create(SysStatusLbl, TweenInfo.new(0.35), {TextTransparency = 0}):Play()

-- Panggil UI Library dari URL Hosting Anda (GitHub / Pastebin)
local LunoLibrary = loadstring(game:HttpGet("https://raw.githubusercontent.com/lyoraaHBX/LibraryLyora-X/refs/heads/main/Lyora%20X"))()

LunoLibrary:Notify({
    Title = "LUNO Loaded",
    Content = "v8.0 Polish Edition Ready!",
    Duration = 3
})

local Window = LunoLibrary:CreateWindow({
    Title = "LUNO",
    SubTitle = "Universal Hub"
})

-- TAB 1: Main Farm
local MainTab = Window:CreateTab("Main Farm")

MainTab:CreateSection("Auto Farming Options")

MainTab:CreateToggle({
    Title = "Auto Farm Level",
    Default = false,
    Flag = "AutoFarmLevelFlag", -- Flag khusus untuk config
    Callback = function(State)
        print("Auto Farm Active:", State)
    end
})

MainTab:CreateSlider({
    Title = "Attack Speed",
    Min = 1,
    Max = 100,
    Default = 10,
    Suffix = " ms",
    Flag = "AttackSpeedFlag", -- Flag khusus untuk config
    Callback = function(Val)
        print("Attack Speed:", Val)
    end
})

-- TAB 2: Combat
local CombatTab = Window:CreateTab("Combat")

CombatTab:CreateSection("PvP Settings")

CombatTab:CreateDropdown({
    Title = "Weapon Weapon Target",
    Options = {"Melee", "Sword", "Fruit"},
    Default = "Melee",
    Flag = "WeaponTargetFlag", -- Flag khusus untuk config
    Callback = function(Sel)
        print("Selected Weapon:", Sel)
    end
})

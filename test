                    CopyBtn.Text = "📋 Copy"
                end)

                table.insert(CardsList, { Title = Title, Category = Category, CardFrame = Card })
                ScrollList.CanvasSize = UDim2.new(0, 0, 0, CardsLayout.AbsoluteContentSize.Y + 10)
            end

            return ScriptListObj
        end

        -- Standard UI Controls Container (For Config, Toggles, Sliders)
        local ScrollElements = Instance.new("ScrollingFrame")
        ScrollElements.Size = UDim2.new(1, 0, 1, 0)
        ScrollElements.BackgroundTransparency = 1
        ScrollElements.BorderSizePixel = 0
        ScrollElements.ScrollBarThickness = 3
        ScrollElements.ScrollBarImageColor3 = Color3.fromRGB(0, 102, 255)
        ScrollElements.Visible = true
        ScrollElements.Parent = TabPage

        local ElementsLayout = Instance.new("UIListLayout")
        ElementsLayout.Padding = UDim.new(0, 8)
        ElementsLayout.SortOrder = Enum.SortOrder.LayoutOrder
        ElementsLayout.Parent = ScrollElements

        -- Button Element
        function TabElements:CreateButton(Name, Callback)
            Callback = Callback or function() end
            local Btn = Instance.new("TextButton")
            Btn.Size = UDim2.new(1, -6, 0, 36)
            Btn.BackgroundColor3 = Color3.fromRGB(14, 20, 36)
            Btn.Text = Name
            Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
            Btn.TextSize = 12
            Btn.Font = Enum.Font.GothamBold
            Btn.Parent = ScrollElements

            local BtnCorner = Instance.new("UICorner")
            BtnCorner.CornerRadius = UDim.new(0, 6)
            BtnCorner.Parent = Btn

            Btn.MouseButton1Click:Connect(Callback)
            ScrollElements.CanvasSize = UDim2.new(0, 0, 0, ElementsLayout.AbsoluteContentSize.Y + 10)
        end

        -- Toggle Element
        function TabElements:CreateToggle(Name, Default, Callback)
            local Toggled = Default or false
            Callback = Callback or function() end

            local ToggleFrame = Instance.new("Frame")
            ToggleFrame.Size = UDim2.new(1, -6, 0, 36)
            ToggleFrame.BackgroundColor3 = Color3.fromRGB(14, 20, 36)
            ToggleFrame.Parent = ScrollElements

            local ToggleCorner = Instance.new("UICorner")
            ToggleCorner.CornerRadius = UDim.new(0, 6)
            ToggleCorner.Parent = ToggleFrame

            local ToggleLbl = Instance.new("TextLabel")
            ToggleLbl.Size = UDim2.new(1, -60, 1, 0)
            ToggleLbl.Position = UDim2.new(0, 12, 0, 0)
            ToggleLbl.Text = Name
            ToggleLbl.TextColor3 = Color3.fromRGB(255, 255, 255)
            ToggleLbl.TextSize = 12
            ToggleLbl.Font = Enum.Font.Gotham
            ToggleLbl.TextXAlignment = Enum.TextXAlignment.Left
            ToggleLbl.Parent = ToggleFrame

            local Switch = Instance.new("Frame")
            Switch.Size = UDim2.new(0, 36, 0, 18)
            Switch.Position = UDim2.new(1, -48, 0.5, -9)
            Switch.BackgroundColor3 = Toggled and Color3.fromRGB(0, 102, 255) or Color3.fromRGB(30, 40, 60)
            Switch.Parent = ToggleFrame

            local SwitchCorner = Instance.new("UICorner")
            SwitchCorner.CornerRadius = UDim.new(1, 0)
            SwitchCorner.Parent = Switch

            local Circle = Instance.new("Frame")
            Circle.Size = UDim2.new(0, 14, 0, 14)
            Circle.Position = Toggled and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)
            Circle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            Circle.Parent = Switch

            local CircleCorner = Instance.new("UICorner")
            CircleCorner.CornerRadius = UDim.new(1, 0)
            CircleCorner.Parent = Circle

            local TriggerBtn = Instance.new("TextButton")
            TriggerBtn.Size = UDim2.new(1, 0, 1, 0)
            TriggerBtn.BackgroundTransparency = 1
            TriggerBtn.Text = ""
            TriggerBtn.Parent = ToggleFrame

            TriggerBtn.MouseButton1Click:Connect(function()
                Toggled = not Toggled
                TweenService:Create(Switch, TweenInfo.new(0.2), {
                    BackgroundColor3 = Toggled and Color3.fromRGB(0, 102, 255) or Color3.fromRGB(30, 40, 60)
                }):Play()
                TweenService:Create(Circle, TweenInfo.new(0.2), {
                    Position = Toggled and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)
                }):Play()
                Callback(Toggled)
            end)

            ScrollElements.CanvasSize = UDim2.new(0, 0, 0, ElementsLayout.AbsoluteContentSize.Y + 10)
        end

        -- Slider Element
        function TabElements:CreateSlider(Name, Min, Max, Default, Callback)
            Default = math.clamp(Default or Min, Min, Max)
            Callback = Callback or function() end

            local SliderFrame = Instance.new("Frame")
            SliderFrame.Size = UDim2.new(1, -6, 0, 45)
            SliderFrame.BackgroundColor3 = Color3.fromRGB(14, 20, 36)
            SliderFrame.Parent = ScrollElements

            local SliderCorner = Instance.new("UICorner")
            SliderCorner.CornerRadius = UDim.new(0, 6)
            SliderCorner.Parent = SliderFrame

            local SliderLbl = Instance.new("TextLabel")
            SliderLbl.Size = UDim2.new(1, -60, 0, 20)
            SliderLbl.Position = UDim2.new(0, 12, 0, 4)
            SliderLbl.Text = Name
            SliderLbl.TextColor3 = Color3.fromRGB(255, 255, 255)
            SliderLbl.TextSize = 11
            SliderLbl.Font = Enum.Font.Gotham
            SliderLbl.TextXAlignment = Enum.TextXAlignment.Left
            SliderLbl.Parent = SliderFrame

            local ValLbl = Instance.new("TextLabel")
            ValLbl.Size = UDim2.new(0, 40, 0, 20)
            ValLbl.Position = UDim2.new(1, -50, 0, 4)
            ValLbl.Text = tostring(Default)
            ValLbl.TextColor3 = Color3.fromRGB(0, 140, 255)
            ValLbl.TextSize = 11
            ValLbl.Font = Enum.Font.GothamBold
            ValLbl.TextXAlignment = Enum.TextXAlignment.Right
            ValLbl.Parent = SliderFrame

            local Bar = Instance.new("Frame")
            Bar.Size = UDim2.new(1, -24, 0, 6)
            Bar.Position = UDim2.new(0, 12, 0, 28)
            Bar.BackgroundColor3 = Color3.fromRGB(30, 40, 60)
            Bar.Parent = SliderFrame

            local BarCorner = Instance.new("UICorner")
            BarCorner.CornerRadius = UDim.new(1, 0)
            BarCorner.Parent = Bar

            local Fill = Instance.new("Frame")
            Fill.Size = UDim2.new((Default - Min) / (Max - Min), 0, 1, 0)
            Fill.BackgroundColor3 = Color3.fromRGB(0, 102, 255)
            Fill.Parent = Bar

            local FillCorner = Instance.new("UICorner")
            FillCorner.CornerRadius = UDim.new(1, 0)
            FillCorner.Parent = Fill

            local DraggingSlider = false
            local function UpdateSlider(input)
                local pos = math.clamp((input.Position.X - Bar.AbsolutePosition.X) / Bar.AbsoluteSize.X, 0, 1)
                local val = math.floor(Min + (Max - Min) * pos)
                Fill.Size = UDim2.new(pos, 0, 1, 0)
                ValLbl.Text = tostring(val)
                Callback(val)
            end

            Bar.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    DraggingSlider = true
                    UpdateSlider(input)
                end
            end)

            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    DraggingSlider = false
                end
            end)

            UserInputService.InputChanged:Connect(function(input)
                if DraggingSlider and input.UserInputType == Enum.UserInputType.MouseMovement then
                    UpdateSlider(input)
                end
            end)

            ScrollElements.CanvasSize = UDim2.new(0, 0, 0, ElementsLayout.AbsoluteContentSize.Y + 10)
        end

        return TabElements
    end

    return LunoLibrary
end


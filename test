-- =========================================================================
-- LUNO STYLE - UI LIBRARY BASE TEMPLATE (V2)
-- Features: Close, Minimize (Toggle Button), Auto Device Detection
-- =========================================================================

local LunoLibrary = {}
local CoreGui = game:GetService("CoreGui")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

-- Deteksi Device (Mobile / PC)
local IsMobile = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled

-- Colors Theme
local Theme = {
    MainBackground = Color3.fromRGB(12, 14, 25),
    SidebarBackground = Color3.fromRGB(18, 22, 38),
    ElementBackground = Color3.fromRGB(25, 30, 50),
    AccentBlue = Color3.fromRGB(45, 125, 255),
    TextWhite = Color3.fromRGB(255, 255, 255),
    TextGray = Color3.fromRGB(160, 170, 190),
    CloseRed = Color3.fromRGB(255, 60, 60),
    MinYellow = Color3.fromRGB(255, 200, 0)
}

-- Destroy old instance if exists to prevent duplicates
if CoreGui:FindFirstChild("LunoUIBase") then
    CoreGui:FindFirstChild("LunoUIBase"):Destroy()
end

-- Universal Draggable Function (Support Touch & Mouse)
local function MakeDraggable(topbarobject, object)
    local Dragging = nil
    local DragInput = nil
    local DragStart = nil
    local StartPosition = nil

    topbarobject.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            Dragging = true
            DragStart = input.Position
            StartPosition = object.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then Dragging = false end
            end)
        end
    end)

    topbarobject.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            DragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == DragInput and Dragging then
            local delta = input.Position - DragStart
            object.Position = UDim2.new(StartPosition.X.Scale, StartPosition.X.Offset + delta.X, StartPosition.Y.Scale, StartPosition.Y.Offset + delta.Y)
        end
    end)
end

function LunoLibrary:CreateWindow(WindowName)
    local LunoUI = Instance.new("ScreenGui")
    LunoUI.Name = "LunoUIBase"
    LunoUI.Parent = CoreGui
    LunoUI.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

    -- ==================== TOGGLE BUTTON (MINIMIZED STATE) ====================
    local ToggleButton = Instance.new("TextButton")
    ToggleButton.Name = "ToggleButton"
    ToggleButton.Parent = LunoUI
    ToggleButton.BackgroundColor3 = Theme.AccentBlue
    ToggleButton.Position = UDim2.new(0.5, -25, 0, 20) -- Posisi atas tengah
    ToggleButton.Size = UDim2.new(0, 50, 0, 50)
    ToggleButton.Font = Enum.Font.GothamBold
    ToggleButton.Text = "L"
    ToggleButton.TextColor3 = Theme.TextWhite
    ToggleButton.TextSize = 24
    ToggleButton.Visible = false -- Sembunyi saat window utama terbuka
    
    local ToggleCorner = Instance.new("UICorner")
    ToggleCorner.CornerRadius = UDim.new(1, 0) -- Membuatnya bulat sempurna
    ToggleCorner.Parent = ToggleButton
    
    local ToggleStroke = Instance.new("UIStroke")
    ToggleStroke.Color = Theme.TextWhite
    ToggleStroke.Thickness = 2
    ToggleStroke.Parent = ToggleButton

    MakeDraggable(ToggleButton, ToggleButton)

    -- ==================== MAIN WINDOW ====================
    local MainFrame = Instance.new("Frame")
    MainFrame.Name = "MainFrame"
    MainFrame.Parent = LunoUI
    MainFrame.BackgroundColor3 = Theme.MainBackground
    
    -- Sesuaikan ukuran berdasarkan device (Jika mobile, agak lebih kecil)
    if IsMobile then
        MainFrame.Size = UDim2.new(0, 600, 0, 350)
        MainFrame.Position = UDim2.new(0.5, -300, 0.5, -175)
    else
        MainFrame.Size = UDim2.new(0, 900, 0, 550)
        MainFrame.Position = UDim2.new(0.5, -450, 0.5, -275)
    end
    MainFrame.ClipsDescendants = true
    
    local MainCorner = Instance.new("UICorner")
    MainCorner.CornerRadius = UDim.new(0, 15)
    MainCorner.Parent = MainFrame

    local MainStroke = Instance.new("UIStroke")
    MainStroke.Color = Theme.AccentBlue
    MainStroke.Thickness = 1
    MainStroke.Transparency = 0.5
    MainStroke.Parent = MainFrame

    -- ==================== TOPBAR (DRAG & CONTROLS) ====================
    local Topbar = Instance.new("Frame")
    Topbar.Name = "Topbar"
    Topbar.Parent = MainFrame
    Topbar.BackgroundColor3 = Color3.fromRGB(255,255,255)
    Topbar.BackgroundTransparency = 1
    Topbar.Size = UDim2.new(1, 0, 0, 40)
    Topbar.ZIndex = 5

    MakeDraggable(Topbar, MainFrame) -- Jadikan Topbar sebagai area untuk menggeser window

    -- Close Button
    local CloseBtn = Instance.new("TextButton")
    CloseBtn.Parent = Topbar
    CloseBtn.BackgroundColor3 = Theme.CloseRed
    CloseBtn.Position = UDim2.new(1, -35, 0.5, -8)
    CloseBtn.Size = UDim2.new(0, 16, 0, 16)
    CloseBtn.Text = ""
    local CloseCorner = Instance.new("UICorner")
    CloseCorner.CornerRadius = UDim.new(1, 0)
    CloseCorner.Parent = CloseBtn

    -- Minimize Button
    local MinBtn = Instance.new("TextButton")
    MinBtn.Parent = Topbar
    MinBtn.BackgroundColor3 = Theme.MinYellow
    MinBtn.Position = UDim2.new(1, -65, 0.5, -8)
    MinBtn.Size = UDim2.new(0, 16, 0, 16)
    MinBtn.Text = ""
    local MinCorner = Instance.new("UICorner")
    MinCorner.CornerRadius = UDim.new(1, 0)
    MinCorner.Parent = MinBtn

    -- Logika Tombol Close & Minimize
    CloseBtn.MouseButton1Click:Connect(function()
        LunoUI:Destroy() -- Menghapus script 100%
    end)

    MinBtn.MouseButton1Click:Connect(function()
        MainFrame.Visible = false
        ToggleButton.Visible = true
    end)

    ToggleButton.MouseButton1Click:Connect(function()
        MainFrame.Visible = true
        ToggleButton.Visible = false
    end)

    -- ==================== SIDEBAR ====================
    local Sidebar = Instance.new("Frame")
    Sidebar.Name = "Sidebar"
    Sidebar.Parent = MainFrame
    Sidebar.BackgroundColor3 = Theme.SidebarBackground
    Sidebar.Position = UDim2.new(0, 0, 0, 0)
    Sidebar.Size = UDim2.new(0, 200, 1, 0)
    
    local SidebarCorner = Instance.new("UICorner")
    SidebarCorner.CornerRadius = UDim.new(0, 15)
    SidebarCorner.Parent = Sidebar

    local LogoText = Instance.new("TextLabel")
    LogoText.Parent = Sidebar
    LogoText.BackgroundTransparency = 1
    LogoText.Position = UDim2.new(0, 20, 0, 20)
    LogoText.Size = UDim2.new(1, -40, 0, 40)
    LogoText.Font = Enum.Font.GothamBold
    LogoText.Text = WindowName .. (IsMobile and " (M)" or " (PC)") -- Indikator deteksi device
    LogoText.TextColor3 = Theme.TextWhite
    LogoText.TextSize = 22
    LogoText.TextXAlignment = Enum.TextXAlignment.Left

    local TabContainer = Instance.new("ScrollingFrame")
    TabContainer.Parent = Sidebar
    TabContainer.Active = true
    TabContainer.BackgroundTransparency = 1
    TabContainer.Position = UDim2.new(0, 10, 0, 80)
    TabContainer.Size = UDim2.new(1, -20, 1, -90)
    TabContainer.ScrollBarThickness = 0
    
    local TabListLayout = Instance.new("UIListLayout")
    TabListLayout.Parent = TabContainer
    TabListLayout.SortOrder = Enum.SortOrder.LayoutOrder
    TabListLayout.Padding = UDim.new(0, 8)

    -- ==================== CONTENT AREA ====================
    local ContentArea = Instance.new("Frame")
    ContentArea.Name = "ContentArea"
    ContentArea.Parent = MainFrame
    ContentArea.BackgroundTransparency = 1
    ContentArea.Position = UDim2.new(0, 210, 0, 40) -- Turun 40px karena ada topbar
    ContentArea.Size = UDim2.new(1, -230, 1, -60)

    local Window = {}
    local CurrentTab = nil

    function Window:MakeTab(TabName)
        local TabBtn = Instance.new("TextButton")
        TabBtn.Parent = TabContainer
        TabBtn.BackgroundColor3 = Theme.AccentBlue
        TabBtn.BackgroundTransparency = 1
        TabBtn.Size = UDim2.new(1, 0, 0, 40)
        TabBtn.Font = Enum.Font.GothamSemibold
        TabBtn.Text = "   " .. TabName
        TabBtn.TextColor3 = Theme.TextGray
        TabBtn.TextSize = 14
        TabBtn.TextXAlignment = Enum.TextXAlignment.Left
        
        local TabBtnCorner = Instance.new("UICorner")
        TabBtnCorner.CornerRadius = UDim.new(0, 8)
        TabBtnCorner.Parent = TabBtn

        local TabPage = Instance.new("ScrollingFrame")
        TabPage.Parent = ContentArea
        TabPage.Active = true
        TabPage.BackgroundTransparency = 1
        TabPage.Size = UDim2.new(1, 0, 1, 0)
        TabPage.ScrollBarThickness = IsMobile and 2 or 4 -- Scrollbar lebih tipis di mobile
        TabPage.ScrollBarImageColor3 = Theme.AccentBlue
        TabPage.Visible = false
        
        local PageLayout = Instance.new("UIListLayout")
        PageLayout.Parent = TabPage
        PageLayout.SortOrder = Enum.SortOrder.LayoutOrder
        PageLayout.Padding = UDim.new(0, 10)

        TabBtn.MouseButton1Click:Connect(function()
            for _, child in pairs(ContentArea:GetChildren()) do
                if child:IsA("ScrollingFrame") then child.Visible = false end
            end
            for _, child in pairs(TabContainer:GetChildren()) do
                if child:IsA("TextButton") then
                    TweenService:Create(child, TweenInfo.new(0.3), {BackgroundTransparency = 1, TextColor3 = Theme.TextGray}):Play()
                end
            end
            TabPage.Visible = true
            TweenService:Create(TabBtn, TweenInfo.new(0.3), {BackgroundTransparency = 0, TextColor3 = Theme.TextWhite}):Play()
        end)

        if CurrentTab == nil then
            CurrentTab = TabPage
            TabPage.Visible = true
            TabBtn.BackgroundTransparency = 0
            TabBtn.TextColor3 = Theme.TextWhite
        end

        local Tab = {}

        function Tab:AddScriptCard(GameName, Tags, Callback)
            local Card = Instance.new("Frame")
            Card.Parent = TabPage
            Card.BackgroundColor3 = Theme.ElementBackground
            Card.Size = UDim2.new(1, -10, 0, 70)
            
            local CardCorner = Instance.new("UICorner")
            CardCorner.CornerRadius = UDim.new(0, 10)
            CardCorner.Parent = Card
            
            local CardStroke = Instance.new("UIStroke")
            CardStroke.Color = Color3.fromRGB(40, 50, 80)
            CardStroke.Thickness = 1
            CardStroke.Parent = Card

            local Title = Instance.new("TextLabel")
            Title.Parent = Card
            Title.BackgroundTransparency = 1
            Title.Position = UDim2.new(0, 70, 0, 15)
            Title.Size = UDim2.new(0, 200, 0, 20)
            Title.Font = Enum.Font.GothamBold
            Title.Text = GameName
            Title.TextColor3 = Theme.TextWhite
            Title.TextSize = 16
            Title.TextXAlignment = Enum.TextXAlignment.Left

            local Desc = Instance.new("TextLabel")
            Desc.Parent = Card
            Desc.BackgroundTransparency = 1
            Desc.Position = UDim2.new(0, 70, 0, 35)
            Desc.Size = UDim2.new(0, 300, 0, 20)
            Desc.Font = Enum.Font.Gotham
            Desc.Text = Tags
            Desc.TextColor3 = Theme.TextGray
            Desc.TextSize = 12
            Desc.TextXAlignment = Enum.TextXAlignment.Left

            local IconPlaceholder = Instance.new("Frame")
            IconPlaceholder.Parent = Card
            IconPlaceholder.BackgroundColor3 = Theme.AccentBlue
            IconPlaceholder.Position = UDim2.new(0, 10, 0, 10)
            IconPlaceholder.Size = UDim2.new(0, 50, 0, 50)
            local IconCorner = Instance.new("UICorner")
            IconCorner.CornerRadius = UDim.new(0, 8)
            IconCorner.Parent = IconPlaceholder

            local ExecuteBtn = Instance.new("TextButton")
            ExecuteBtn.Parent = Card
            ExecuteBtn.BackgroundColor3 = Theme.AccentBlue
            ExecuteBtn.Position = UDim2.new(1, -110, 0, 15)
            ExecuteBtn.Size = UDim2.new(0, 90, 0, 40)
            ExecuteBtn.Font = Enum.Font.GothamBold
            ExecuteBtn.Text = "Execute"
            ExecuteBtn.TextColor3 = Theme.TextWhite
            ExecuteBtn.TextSize = 14
            
            local BtnCorner = Instance.new("UICorner")
            BtnCorner.CornerRadius = UDim.new(0, 8)
            BtnCorner.Parent = ExecuteBtn

            ExecuteBtn.MouseButton1Click:Connect(function()
                ExecuteBtn.Text = "Loading..."
                wait(0.2)
                pcall(Callback)
                ExecuteBtn.Text = "Executed!"
                wait(1)
                ExecuteBtn.Text = "Execute"
            end)
        end

        return Tab
    end

    return Window
end


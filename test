-- =================================================================
-- TAB 3: MOVEMENT & PLAYER (WALKSPEED, JUMP, FLY)
-- =================================================================
local MovementTab = Window:CreateTab("Movement")

-- Slider Pengatur Kecepatan Karakter (WalkSpeed)
MovementTab:CreateSlider("Player WalkSpeed", 16, 250, 16, function(Value)
    if game.Players.LocalPlayer.Character and game.Players.LocalPlayer.Character:FindFirstChild("Humanoid") then
        game.Players.LocalPlayer.Character.Humanoid.WalkSpeed = Value
    end
end)

-- Slider Pengatur Lompatan Karakter (JumpPower)
MovementTab:CreateSlider("Player JumpPower", 50, 300, 50, function(Value)
    if game.Players.LocalPlayer.Character and game.Players.LocalPlayer.Character:FindFirstChild("Humanoid") then
        game.Players.LocalPlayer.Character.Humanoid.JumpPower = Value
    end
end)

-- Toggle Infinite Jump
MovementTab:CreateToggle("Infinite Jump in Air", false, function(State)
    print("[MOVEMENT] Infinite Jump:", State)
end)

-- Button Respawn
MovementTab:CreateButton("Respawn / Reset Character", function()
    if game.Players.LocalPlayer.Character and game.Players.LocalPlayer.Character:FindFirstChild("Humanoid") then
        game.Players.LocalPlayer.Character.Humanoid.Health = 0
    end
end)



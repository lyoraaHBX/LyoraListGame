---------------------------------------------------------
-- ANIMATION FUNCTIONS
---------------------------------------------------------
local function FadeIn()
    TweenService:Create(Card, TweenInfo.new(0.4), {BackgroundTransparency = 0}):Play()
    TweenService:Create(CardStroke, TweenInfo.new(0.4), {Transparency = 0.4}):Play()
    TweenService:Create(TitleLbl, TweenInfo.new(0.4), {TextTransparency = 0}):Play()
    TweenService:Create(SubTitleLbl, TweenInfo.new(0.4), {TextTransparency = 0}):Play()
    TweenService:Create(StatusLbl, TweenInfo.new(0.4), {TextTransparency = 0}):Play()
    TweenService:Create(PercentLbl, TweenInfo.new(0.4), {TextTransparency = 0}):Play()
    TweenService:Create(Track, TweenInfo.new(0.4), {BackgroundTransparency = 0}):Play()
    task.wait(0.4)
end

local function UpdateProgress(percent, statusText)
    StatusLbl.Text = statusText
    PercentLbl.Text = tostring(math.floor(percent * 100)) .. "%"
    TweenService:Create(Fill, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Size = UDim2.new(percent, 0, 1, 0)}):Play()
    task.wait(0.35)
end

local function FadeOut()
    TweenService:Create(Card, TweenInfo.new(0.4), {BackgroundTransparency = 1}):Play()
    TweenService:Create(CardStroke, TweenInfo.new(0.4), {Transparency = 1}):Play()
    TweenService:Create(TitleLbl, TweenInfo.new(0.4), {TextTransparency = 1}):Play()
    TweenService:Create(SubTitleLbl, TweenInfo.new(0.4), {TextTransparency = 1}):Play()
    TweenService:Create(StatusLbl, TweenInfo.new(0.4), {TextTransparency = 1}):Play()
    TweenService:Create(PercentLbl, TweenInfo.new(0.4), {TextTransparency = 1}):Play()
    TweenService:Create(Track, TweenInfo.new(0.4), {BackgroundTransparency = 1}):Play()
    TweenService:Create(Fill, TweenInfo.new(0.4), {BackgroundTransparency = 1}):Play()
    task.wait(0.4)
    LoadingGui:Destroy()
end

---------------------------------------------------------
-- LOADER EXECUTION PIPELINE
---------------------------------------------------------
task.spawn(function()
    FadeIn()
    
    -- Step 1: Check Environment
    UpdateProgress(0.20, "Checking executor environment...")
    
    -- Step 2: Fetch LUNO Library
    UpdateProgress(0.45, "Fetching UI Framework...")
    local LunoLibrary = nil
    pcall(function()
        LunoLibrary = loadstring(game:HttpGet(LunoLibraryURL))()
    end)
    
    -- Step 3: Analyze Place ID
    UpdateProgress(0.70, "Analyzing Place ID: " .. tostring(PlaceId) .. "...")
    
    local TargetScriptURL = SupportedGames[PlaceId]
    
    if TargetScriptURL then
        -- Step 4A: Match Found
        UpdateProgress(1.00, "Game match found! Launching...")
        task.wait(0.5)
        FadeOut()
        
        pcall(function()
            loadstring(game:HttpGet(TargetScriptURL))()
        end)
    else
        -- Step 4B: No Match (Universal Fallback)
        UpdateProgress(1.00, "Unsupported Place. Loading Universal Mode...")
        task.wait(0.5)
        FadeOut()
        
        if LunoLibrary then
            local Window = LunoLibrary:CreateWindow({
                Title = "LUNO",
                SubTitle = "Universal",
                Discord = "https://discord.gg/lunar"
            })

            local MainTab = Window:CreateTab("Universal Mode")

            MainTab:CreateSection("System Info")
            MainTab:CreateButton({
                Title = "LUNO Universal Engine Running",
                Callback = function()
                    LunoLibrary:Notify({
                        Title = "Universal Mode",
                        Content = "This game is not in the custom supported list.",
                        Duration = 3
                    })
                end
            })

            MainTab:CreateSection("Universal Utilities")
            MainTab:CreateButton({
                Title = "Rejoin Server",
                Callback = function()
                    game:GetService("TeleportService"):TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer)
                end
            })
        end
    end
end)

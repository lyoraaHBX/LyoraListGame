    TweenService:Create(TermStroke, TweenInfo.new(0.35), {Transparency = 0}):Play()
    TweenService:Create(ConsoleText, TweenInfo.new(0.35), {TextTransparency = 0}):Play()
    TweenService:Create(MeterTrack, TweenInfo.new(0.35), {BackgroundTransparency = 0}):Play()
    TweenService:Create(ProgressPercent, TweenInfo.new(0.35), {TextTransparency = 0}):Play()
    TweenService:Create(ProgressStatus, TweenInfo.new(0.35), {TextTransparency = 0}):Play()
    task.wait(0.35)
end

local function UpdateTerminal(targetPercent, statusTag, consoleMsg)
    if consoleMsg then AddConsoleLog(consoleMsg) end
    ProgressStatus.Text = statusTag
    ProgressPercent.Text = tostring(math.floor(targetPercent * 100)) .. "%"
    TweenService:Create(MeterFill, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Size = UDim2.new(targetPercent, 0, 1, 0)}):Play()
    task.wait(0.28)
end

local function FadeOutHUD()
    TweenService:Create(MainHUD, TweenInfo.new(0.35), {BackgroundTransparency = 1}):Play()
    TweenService:Create(HUDStroke, TweenInfo.new(0.35), {Transparency = 1}):Play()

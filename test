    -- Toggle Menu Visibility Function
    local IsVisible = true
    local function ToggleUI()
        IsVisible = not IsVisible
        if IsVisible then
            MainFrame.Visible = true
            TweenService:Create(MainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                Size = UDim2.new(0, 860, 0, 520)
            }):Play()
        else
            local tween = TweenService:Create(MainFrame, TweenInfo.new(0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
                Size = UDim2.new(0, 860, 0, 0)
            })
            tween:Play()
            tween.Completed:Connect(function()
                if not IsVisible then MainFrame.Visible = false end
            end)
        end
    end


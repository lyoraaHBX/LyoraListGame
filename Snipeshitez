        CurrentStamina, MaxStamina = v, m
    end
    if BarNodeRefs.Health and BarNodeRefs.Health.Parent then
        local v, m = ReadNodeValue(BarNodeRefs.Health)
        CurrentHealth, MaxHealth = v, m
    end
end)


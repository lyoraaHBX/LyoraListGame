local function FormatDuration(seconds)
    local hrs = math.floor(seconds / 3600)
    local mins = math.floor((seconds % 3600) / 60)
    if hrs > 0 then
        return hrs .. "h " .. mins .. "m"
    else
        return mins .. "m"
    end
end


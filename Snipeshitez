-- =========================================================
-- AUTO OPERATIONS SYSTEM (BARU)
-- Slot: 1-4, tergantung Gamepass. User pilih Max Active Slots.
-- Slot yang melebihi limit otomatis OFF (visual & logic).
-- Alur per slot: Start -> Tunggu Durasi -> Collect -> Start Lagi.
-- Startup check: cek slot 1-4 sekali, siapa tau ada reward tertunda.
-- =========================================================
local StartOperationRemote = ReplicatedStorage:WaitForChild("MW"):WaitForChild("Remotes"):WaitForChild("StartOperation")
local CollectOperationRemote = ReplicatedStorage:WaitForChild("MW"):WaitForChild("Remotes"):WaitForChild("CollectOperation")
local OPERATION_HASH = "ca01587a32b24eb1a0527e8e595e8483"

local MaxOperationSlots = 1

local OperationSlotState = {}
for i = 1, 4 do
    OperationSlotState[i] = {
        Active = false,       -- apakah operation sedang berjalan di slot ini (local tracking)
        OpId = OPERATIONS[1].id, -- default operation biar gak nil
        StartTime = 0,
        Duration = 0,
        AutoEnabled = false,
        ToggleRef = nil,
    }
end

local function TryStartOperation(opId)
    local success, result = pcall(function()
        return StartOperationRemote:InvokeServer(OPERATION_HASH, opId)
    end)
    if success and type(result) == "table" then
        return result.ok == true, result
    end
    return false, nil
end

local function TryCollectOperation(slotIndex)
    local success, result = pcall(function()
        return CollectOperationRemote:InvokeServer(OPERATION_HASH, slotIndex)
    end)
    if success and type(result) == "table" then
        return result.ok == true, result
    end
    return false, nil
end

MainTab:CreateSection("Auto Operations")

MainTab:CreateDropdown({
    Title = "Max Active Operation Slots (Sesuai Gamepass)",
    Options = {"1", "2", "3", "4"},
    Multi = false,
    Flag = "MaxOperationSlots",
    Callback = function(Selected)
        local num = tonumber(Selected) or 1
        MaxOperationSlots = num

        -- Matikan slot yang melebihi limit baru (visual & logic)
        for i = 1, 4 do
            if i > MaxOperationSlots and OperationSlotState[i].AutoEnabled then
                OperationSlotState[i].AutoEnabled = false
                ForceSetToggleOff(OperationSlotState[i].ToggleRef, "AutoOperationSlot" .. i .. "Toggle")

                LunoLibrary:Notify({
                    Title = "Slot " .. i .. " OFF",
                    Content = "Slot ini melebihi Max Active Slots (" .. MaxOperationSlots .. "). Auto dimatikan otomatis.",
                    Duration = 3
                })
            end
        end
    end
})

for slotIndex = 1, 4 do
    MainTab:CreateSection("Operation Slot " .. slotIndex)

    MainTab:CreateDropdown({
        Title = "Select Operation for Slot " .. slotIndex,
        Options = OperationNamesList,
        Multi = false,
        Flag = "SelectedOperationSlot" .. slotIndex,
        Callback = function(Selected)
            if OperationMap[Selected] then
                OperationSlotState[slotIndex].OpId = OperationMap[Selected]
            end
        end
    })

    local toggleRef = MainTab:CreateToggle({
        Title = "Enable Auto Slot " .. slotIndex,
        Default = false,
        Flag = "AutoOperationSlot" .. slotIndex .. "Toggle",
        Callback = function(Value)
            -- Kalau slot ini melebihi Max Active Slots, paksa OFF & kasih tau
            if Value and slotIndex > MaxOperationSlots then
                LunoLibrary:Notify({
                    Title = "Slot " .. slotIndex .. " OFF",
                    Content = "Slot ini melebihi Max Active Slots (" .. MaxOperationSlots .. "). Naikkan limit dulu di dropdown atas.",
                    Duration = 4
                })
                OperationSlotState[slotIndex].AutoEnabled = false
                ForceSetToggleOff(OperationSlotState[slotIndex].ToggleRef, "AutoOperationSlot" .. slotIndex .. "Toggle")
                return
            end

            OperationSlotState[slotIndex].AutoEnabled = Value

            if Value then
                local opInfo = OPERATIONS_BY_ID[OperationSlotState[slotIndex].OpId]
                LunoLibrary:Notify({
                    Title = "Auto Slot " .. slotIndex .. " Started",
                    Content = "Operation: " .. (opInfo and opInfo.name or "Belum dipilih"),
                    Duration = 3
                })
            end
        end
    })

    OperationSlotState[slotIndex].ToggleRef = toggleRef
end

-- Startup check: cek slot 1-4 sekali, siapa tau ada reward tertunda dari sesi sebelumnya
task.spawn(function()
    task.wait(3)
    for i = 1, 4 do
        local success, result = TryCollectOperation(i)
        if success then
            LunoLibrary:Notify({
                Title = "Operation Collected (Startup Check)",
                Content = "Slot " .. i .. " ada reward tertunda, berhasil diklaim!\nCash: " .. tostring(result.cash) .. " | XP: " .. tostring(result.xp),
                Duration = 4
            })
        end
        task.wait(0.3)
    end
end)

-- Loop utama Auto Operations (interval 5 detik, tidak spam invoke)
local OPERATION_CHECK_INTERVAL = 5

task.spawn(function()
    while true do
        task.wait(OPERATION_CHECK_INTERVAL)

        for slotIndex = 1, MaxOperationSlots do
            local slot = OperationSlotState[slotIndex]

            if slot.AutoEnabled then
                if slot.Active then
                    -- Cek apakah durasi sudah selesai
                    if tick() - slot.StartTime >= slot.Duration then
                        local success, result = TryCollectOperation(slotIndex)

                        if success then
                            slot.Active = false

                            LunoLibrary:Notify({
                                Title = "Operation Collected!",
                                Content = "Slot " .. slotIndex .. " selesai.\nCash: " .. tostring(result.cash) .. " | XP: " .. tostring(result.xp),
                                Duration = 4
                            })
                        end
                        -- Kalau gagal collect, biarkan Active tetap true, dicek lagi loop berikutnya
                    end
                else
                    -- Belum ada operation jalan, coba start
                    if slot.OpId then
                        local success, result = TryStartOperation(slot.OpId)

                        if success then
                            local opInfo = OPERATIONS_BY_ID[slot.OpId]
                            slot.Active = true
                            slot.StartTime = tick()
                            slot.Duration = opInfo and opInfo.duration or 600

                            LunoLibrary:Notify({
                                Title = "Operation Started",
                                Content = "Slot " .. slotIndex .. ": " .. (opInfo and opInfo.name or slot.OpId),
                                Duration = 3
                            })
                        end
                        -- Kalau gagal start (cash/level kurang), skip, dicoba lagi loop berikutnya
                    end
                end
            end
        end
    end
end)


-- TOMBOL NOTIFIKASI LEVEL REAL-TIME
MainTab:CreateButton({
    Title = "Check Real-Time Level",
    Callback = function()
        local _, accurateLevel, jobName = GetHighestUnlockedJob()
        LunoLibrary:Notify({
            Title = "Real-Time Level Detected",
            Content = "Level: " .. tostring(accurateLevel) .. " | Current Job: " .. jobName,
            Duration = 5
        })
    end
})

MainTab:CreateSection("Auto Job Configurations")

local AutoJobEnabled = false
local AutoHighestMode = true
local SelectedJobId = "j_watch"
local JobDelay = 0.5

MainTab:CreateToggle({
    Title = "Enable Auto Job",
    Default = false,
    Flag = "AutoJobToggle",
    Callback = function(Value)
        AutoJobEnabled = Value
        if Value then
            local _, lvl, name = GetHighestUnlockedJob()
            LunoLibrary:Notify({
                Title = "Auto Job Started",
                Content = "Current Level: " .. lvl .. " | Active Job: " .. name,
                Duration = 3
            })
        end
    end
})

MainTab:CreateToggle({
    Title = "Auto Select Highest Unlocked Job",
    Default = true,
    Flag = "AutoHighestJobToggle",
    Callback = function(Value)
        AutoHighestMode = Value
    end
})

MainTab:CreateDropdown({
    Title = "Manual Select Job",
    Options = JobNamesList,
    Multi = false,
    Flag = "SelectedManualJob",
    Callback = function(Selected)
        if JobMap[Selected] then
            SelectedJobId = JobMap[Selected]
        end
    end
})

MainTab:CreateSlider({
    Title = "Job Delay Speed",
    Min = 0.1,
    Max = 3,
    Default = 0.5,
    Suffix = " sec",
    Flag = "JobDelaySlider",
    Callback = function(Value)
        JobDelay = Value
    end
})

-- =========================================================
-- MAIN AUTO JOB LOOP
-- =========================================================
task.spawn(function()
    while true do
        task.wait(JobDelay)
        if AutoJobEnabled then
            local targetJob = SelectedJobId
            
            if AutoHighestMode then
                local highestId = GetHighestUnlockedJob()
                targetJob = highestId
            end

            pcall(function()
                DoJobRemote:InvokeServer(JOB_HASH, targetJob)
            end)
        end
    end
end)

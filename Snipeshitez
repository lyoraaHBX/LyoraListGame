local PropsOwnedStripPath = {"PlayerGui", "MafiaWarsUI", "Root", "Content", "PropsPanel", "Scroller", "OwnedStrip"}

local function GetPropsCapInfo()
    local path = {}
    for _, p in ipairs(PropsOwnedStripPath) do table.insert(path, p) end
    table.insert(path, "CapText")

    local node = SafeFindPath(path)
    if not node then return 0, 0 end

    local raw = GetRawTextFromNode(node)
    local owned, max = string.match(tostring(raw), "(%d+)%s*/%s*(%d+)")
    return tonumber(owned) or 0, tonumber(max) or 0
end

local function GetOwnedPropertiesList()
    local path = {}
    for _, p in ipairs(PropsOwnedStripPath) do table.insert(path, p) end
    table.insert(path, "TileGrid")

    local tileGrid = SafeFindPath(path)
    if not tileGrid then return {} end

    local list = {}
    for _, child in ipairs(tileGrid:GetChildren()) do
        local propId, idx = string.match(child.Name, "^Tile_(.+)_(%d+)$")
        if propId then
            local earnNode = child:FindFirstChild("EarnRate")
            local earnRaw = earnNode and GetRawTextFromNode(earnNode) or nil
            local earnValue = earnRaw and ParseAbbreviatedNumber(earnRaw) or 0

            table.insert(list, {
                id = propId,
                index = tonumber(idx),
                earn = earnValue,
            })
        end
    end
    return list
end

local function GetBestAffordableProperty(cash, level)
    local best = nil
    for _, prop in ipairs(PROPERTIES) do
        if level >= prop.level and prop.baseCost <= cash then
            if not best or prop.baseCost > best.baseCost then
                best = prop
            end
        end
    end
    return best
end

local function GetEffectiveIncome(prop)
    if prop.incomePerHour then return prop.incomePerHour end
    if prop.goldPerDay then return math.huge end

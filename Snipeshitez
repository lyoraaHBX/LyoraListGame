    -- Cari 1 target valid baru, exclude userId yang sudah aktif
    local function FindNewValidTarget(list, myLevel, excludeSet)
        local bestTarget = nil
        for _, target in ipairs(list) do
            if target.level and (not excludeSet or not excludeSet[target.userId]) then
                local levelDiff = target.level - myLevel
                local isValidLevel = (levelDiff <= 0) or (levelDiff > 0 and levelDiff <= MAX_LEVEL_GAP_ABOVE)
                if isValidLevel and not target.shielded and (not target.stamina or target.stamina > 0) then
                    if not bestTarget or target.level > bestTarget.level then
                        bestTarget = target
                    end
                end
            end
        end
        return bestTarget
    end

    local function FormatBattleReport(battleResult)
        if not battleResult then return "Tidak ada data hasil pertarungan." end
        if battleResult.ok == false then
            return "GAGAL: " .. tostring(battleResult.msg or "Unknown error")
        end
        local status = battleResult.won and "MENANG" or "KALAH"
        local lines = {
            status .. " vs " .. tostring(battleResult.targetName) .. " (Lv." .. tostring(battleResult.targetLevel) .. ")",
            "DMG Dealt: " .. tostring(battleResult.dmgDealt) .. " | DMG Taken: " .. tostring(battleResult.dmgTaken),
            "XP: " .. tostring(battleResult.xp or battleResult.xpEstimate),
            "Respect: " .. tostring(battleResult.respectEstimate or battleResult.respect),
            "Cash: " .. tostring(battleResult.cashEstimate or battleResult.stolen),
        }
        if battleResult.knockout then table.insert(lines, "KNOCKOUT!") end
        return table.concat(lines, "\n")
    end

    local function FormatBossReport(bossId, bossResult)
        if not bossResult then return "Tidak ada data hasil serangan boss." end
        if bossResult.ok == false then
            return bossId .. " -> GAGAL: " .. tostring(bossResult.msg or "Unknown error")
        end
        local lines = { bossId .. " -> Serangan berhasil dikirim." }
        for key, val in pairs(bossResult) do
            if key ~= "ok" then table.insert(lines, tostring(key) .. ": " .. tostring(val)) end
        end
        return table.concat(lines, "\n")
    end

    ----------------------------------------------------------------
    -- AUTO ATTACK PLAYER - MULTI TARGET ROUND ROBIN SCHEDULER
    ----------------------------------------------------------------
    -- activeTargets: { {target=<hitlistEntry>, nextAttackTime=<clock>, winStreak=<int>}, ... }
    local AutoAttackEnabled = false
    local WasWaitingForStamina = false
    local WasWaitingForHealth = false

    local function AutoAttackLoop()
        local activeTargets = {}

        while AutoAttackEnabled do
            local myHealth = GetMyHealth(false)
            if myHealth ~= nil and myHealth < MIN_HEALTH_TO_RESUME then
                if not WasWaitingForHealth then
                    LunoLibrary:Notify({ Title = "Auto Attack", Content = "Health rendah (" .. tostring(myHealth) .. "), menunggu regen...", Duration = 3 })
                    WasWaitingForHealth = true
                end
                task.wait(ATTACK_DELAY)
                continue
            else
                if WasWaitingForHealth then
                    LunoLibrary:Notify({ Title = "Auto Attack", Content = "Health pulih! Melanjutkan.", Duration = 2 })
                    WasWaitingForHealth = false
                end
            end

            local myStamina = GetMyStamina(false)
            if myStamina ~= nil and myStamina <= 0 then
                if not WasWaitingForStamina then
                    LunoLibrary:Notify({ Title = "Auto Attack", Content = "Stamina habis! Menunggu...", Duration = 3 })
                    WasWaitingForStamina = true
                end
                task.wait(ATTACK_DELAY)
                continue
            else
                if WasWaitingForStamina then
                    LunoLibrary:Notify({ Title = "Auto Attack", Content = "Stamina terisi! Melanjutkan.", Duration = 2 })
                    WasWaitingForStamina = false
                end
            end

            local myLevel = GetMyLevel()
            if not myLevel then
                task.wait(ATTACK_DELAY)
                continue
            end

            local now = os.clock()
            local attackedThisTick = false

            -- 1. Serang semua target aktif yang cooldown-nya sudah habis
            for i = #activeTargets, 1, -1 do
                local entry = activeTargets[i]
                if now >= entry.nextAttackTime then
                    local invokeSuccess, battleResult = AttackPlayer(entry.target.userId)
                    attackedThisTick = true

                    if invokeSuccess and battleResult then
                        if IsHospitalized(battleResult) then
                            print("[AUTO ATTACK] Hospitalized saat retry " .. entry.target.name)
                            -- biarkan, health check global akan pause loop
                        elseif battleResult.ok == false then
                            print("[AUTO ATTACK] Error retry " .. entry.target.name .. ": " .. tostring(battleResult.msg))
                            table.remove(activeTargets, i)
                        else
                            print("[AUTO ATTACK] " .. FormatBattleReport(battleResult):gsub("\n", " | "))
                            if battleResult.won then
                                entry.winStreak = entry.winStreak + 1
                                if entry.winStreak >= MAX_WIN_STREAK then
                                    LunoLibrary:Notify({
                                        Title = "Auto Attack",
                                        Content = "Selesai " .. MAX_WIN_STREAK .. "x menang vs " .. entry.target.name,
                                        Duration = 3
                                    })
                                    table.remove(activeTargets, i)
                                else
                                    entry.nextAttackTime = now + ATTACK_REPEAT_DELAY
                                end
                            else
                                LunoLibrary:Notify({
                                    Title = "Auto Attack",
                                    Content = "Kalah vs " .. entry.target.name .. ", berhenti serang dia.",
                                    Duration = 3
                                })
                                table.remove(activeTargets, i)
                            end
                        end
                    else
                        table.remove(activeTargets, i)
                    end
                end
            end

            -- 2. Kalau tidak ada target aktif yang siap diserang tick ini, cari target BARU dan serang langsung
            if not attackedThisTick then
                local excludeSet = {}
                for _, e in ipairs(activeTargets) do excludeSet[e.target.userId] = true end

                local list = GetHitList(false)
                local newTarget = FindNewValidTarget(list, myLevel, excludeSet)

                if not newTarget then
                    list = GetHitList(true)
                    newTarget = FindNewValidTarget(list, myLevel, excludeSet)
                end

                if newTarget then
                    local invokeSuccess, battleResult = AttackPlayer(newTarget.userId)
                    if invokeSuccess and battleResult and battleResult.ok ~= false and not IsHospitalized(battleResult) then
                        print("[AUTO ATTACK NEW] " .. FormatBattleReport(battleResult):gsub("\n", " | "))
                        if battleResult.won then
                            table.insert(activeTargets, {
                                target = newTarget,
                                nextAttackTime = now + ATTACK_REPEAT_DELAY,
                                winStreak = 1
                            })
                        end
                    end
                end
            end

            task.wait(ATTACK_DELAY)
        end

        WasWaitingForStamina = false
        WasWaitingForHealth = false
    end

    ----------------------------------------------------------------
    -- BOT FARM - MULTI TARGET ROUND ROBIN SCHEDULER (UNLIMITED REPEAT)
    ----------------------------------------------------------------
    -- activeBots: { {bot=<botData>, nextAttackTime=<clock>}, ... }
    -- lostBots: set userId yang sudah kalah, permanen tidak diserang lagi
    local BotFarmEnabled = false
    local BotWasWaitingForStamina = false
    local BotWasWaitingForHealth = false
    local BotWasWaitingForPower = false

    local function BotFarmLoop()
        local activeBots = {}
        local lostBots = {}
        local botCursor = 1 -- pointer bot berikutnya yang belum pernah dicoba unlock

        while BotFarmEnabled do
            local myHealth = GetMyHealth(false)
            if myHealth ~= nil and myHealth < MIN_HEALTH_TO_RESUME then
                if not BotWasWaitingForHealth then
                    LunoLibrary:Notify({ Title = "Bot Farm", Content = "Health rendah, menunggu regen...", Duration = 3 })
                    BotWasWaitingForHealth = true
                end
                task.wait(ATTACK_DELAY)
                continue
            else
                if BotWasWaitingForHealth then
                    LunoLibrary:Notify({ Title = "Bot Farm", Content = "Health pulih! Melanjutkan.", Duration = 2 })
                    BotWasWaitingForHealth = false
                end
            end

            local myStamina = GetMyStamina(false)
            if myStamina ~= nil and myStamina <= 0 then
                if not BotWasWaitingForStamina then
                    LunoLibrary:Notify({ Title = "Bot Farm", Content = "Stamina habis! Menunggu...", Duration = 3 })
                    BotWasWaitingForStamina = true
                end
                task.wait(ATTACK_DELAY)
                continue
            else
                if BotWasWaitingForStamina then
                    LunoLibrary:Notify({ Title = "Bot Farm", Content = "Stamina terisi! Melanjutkan.", Duration = 2 })
                    BotWasWaitingForStamina = false
                end
            end

            local myPower = GetMyPower()
            local now = os.clock()
            local attackedThisTick = false

            -- 1. Serang semua bot aktif yang cooldown-nya sudah habis
            for i = #activeBots, 1, -1 do
                local entry = activeBots[i]
                if now >= entry.nextAttackTime then
                    local invokeSuccess, result = AttackPlayer(entry.bot.userId)
                    attackedThisTick = true

                    if invokeSuccess and result then
                        if IsHospitalized(result) then
                            print("[BOT FARM] Hospitalized saat retry bot " .. entry.bot.userId)
                        elseif result.ok == false then
                            print("[BOT FARM] Error retry bot " .. entry.bot.userId .. ": " .. tostring(result.msg))
                            table.remove(activeBots, i)
                            lostBots[entry.bot.userId] = true
                        else
                            print("[BOT FARM] " .. FormatBattleReport(result):gsub("\n", " | "))
                            if result.won then
                                -- UNLIMITED repeat, tetap aktif, jadwalkan ulang
                                entry.nextAttackTime = now + ATTACK_REPEAT_DELAY
                            else
                                LunoLibrary:Notify({
                                    Title = "Bot Farm",
                                    Content = "Kalah dari bot (userId: " .. tostring(entry.bot.userId) .. "), berhenti serang bot ini.",
                                    Duration = 3
                                })
                                table.remove(activeBots, i)
                                lostBots[entry.bot.userId] = true
                            end
                        end
                    end
                end
            end

            -- 2. Coba unlock bot baru berdasarkan power, cascade langsung serang begitu unlock
            while botCursor <= #BOT_LIST do
                local nextBotData = BOT_LIST[botCursor]

                if lostBots[nextBotData.userId] then
                    botCursor = botCursor + 1
                elseif myPower and nextBotData.def and myPower >= nextBotData.def then
                    local alreadyActive = false
                    for _, e in ipairs(activeBots) do
                        if e.bot.userId == nextBotData.userId then
                            alreadyActive = true
                            break
                        end
                    end

                    if not alreadyActive then
                        if BotWasWaitingForPower then
                            LunoLibrary:Notify({ Title = "Bot Farm", Content = "Power cukup! Unlock bot baru.", Duration = 2 })
                            BotWasWaitingForPower = false
                        end

                        local invokeSuccess, result = AttackPlayer(nextBotData.userId)
                        attackedThisTick = true

                        if invokeSuccess and result then
                            if IsHospitalized(result) then
                                print("[BOT FARM] Hospitalized saat unlock bot " .. nextBotData.userId)
                            elseif result.ok == false then
                                print("[BOT FARM] Error unlock bot " .. nextBotData.userId .. ": " .. tostring(result.msg))
                                lostBots[nextBotData.userId] = true
                            else
                                print("[BOT FARM NEW] " .. FormatBattleReport(result):gsub("\n", " | "))
                                if result.won then
                                    table.insert(activeBots, {
                                        bot = nextBotData,
                                        nextAttackTime = now + ATTACK_REPEAT_DELAY
                                    })
                                else
                                    LunoLibrary:Notify({
                                        Title = "Bot Farm",
                                        Content = "Kalah dari bot baru (userId: " .. tostring(nextBotData.userId) .. "), skip.",
                                        Duration = 3
                                    })
                                    lostBots[nextBotData.userId] = true
                                end
                            end
                        end
                    end
                    botCursor = botCursor + 1
                else
                    -- Power belum cukup untuk bot berikutnya -> stop unlock, tunggu power naik
                    if not BotWasWaitingForPower then
                        LunoLibrary:Notify({
                            Title = "Bot Farm",
                            Content = "Power (" .. tostring(myPower) .. ") belum cukup untuk bot berikutnya (Def: " .. tostring(nextBotData.def) .. "). Bot lain tetap jalan.",
                            Duration = 3
                        })
                        BotWasWaitingForPower = true
                    end
                    break
                end
            end

            -- Cek apakah semua bot sudah selesai (habis dari list, tidak ada yang aktif)
            if botCursor > #BOT_LIST and #activeBots == 0 then
                LunoLibrary:Notify({
                    Title = "Bot Farm",
                    Content = "Semua bot dalam list sudah diselesaikan!",
                    Duration = 4
                })
                BotFarmEnabled = false
                break
            end

            task.wait(ATTACK_DELAY)
        end

        BotWasWaitingForStamina = false
        BotWasWaitingForHealth = false
        BotWasWaitingForPower = false
    end

    ----------------------------------------------------------------
    -- AUTO BOSS LOOP (tidak berubah)
    ----------------------------------------------------------------
    local AutoBossEnabled = false
    local WasWaitingForBossHealth = false
    local WasWaitingForBossLevel = false

    local function AutoBossLoop()
        local bossIndex = 1

        while AutoBossEnabled do
            if bossIndex > #BOSS_LIST then
                LunoLibrary:Notify({ Title = "Auto Boss", Content = "Semua boss sudah diserang! Selesai.", Duration = 4 })
                AutoBossEnabled = false
                break
            end

            local currentBossData = BOSS_LIST[bossIndex]
            local currentBoss = currentBossData.id

            local myLevel = GetMyLevel()
            if myLevel and currentBossData.level and myLevel < currentBossData.level then
                if not WasWaitingForBossLevel then
                    LunoLibrary:Notify({
                        Title = "Auto Boss",
                        Content = currentBoss .. " requires level " .. currentBossData.level .. ". Level kamu: " .. myLevel .. ". Menunggu...",
                        Duration = 3
                    })
                    WasWaitingForBossLevel = true
                end
                task.wait(LEVEL_CHECK_INTERVAL)
                continue
            else
                if WasWaitingForBossLevel then
                    LunoLibrary:Notify({ Title = "Auto Boss", Content = "Level cukup! Melanjutkan.", Duration = 2 })
                    WasWaitingForBossLevel = false
                end
            end

            local myHealth = GetMyHealth(false)
            if myHealth ~= nil and myHealth < MIN_HEALTH_TO_RESUME then
                if not WasWaitingForBossHealth then
                    LunoLibrary:Notify({ Title = "Auto Boss", Content = "Health rendah, menunggu regen...", Duration = 3 })
                    WasWaitingForBossHealth = true
                end
                task.wait(ATTACK_DELAY)
                continue
            else
                if WasWaitingForBossHealth then
                    LunoLibrary:Notify({ Title = "Auto Boss", Content = "Health pulih! Melanjutkan.", Duration = 2 })
                    WasWaitingForBossHealth = false
                end
            end

            local invokeSuccess, bossResult = AttackBoss(currentBoss)

            if invokeSuccess and bossResult then
                local isRequireLevel, requiredLevel = GetRequiredLevel(bossResult)

                if isRequireLevel then
                    if not WasWaitingForBossLevel then
                        LunoLibrary:Notify({
                            Title = "Auto Boss",
                            Content = currentBoss .. " requires level " .. tostring(requiredLevel) .. ". Menunggu...",
                            Duration = 3
                        })
                        WasWaitingForBossLevel = true
                    end
                    task.wait(LEVEL_CHECK_INTERVAL)
                    continue
                elseif IsHospitalized(bossResult) then
                    LunoLibrary:Notify({
                        Title = "Auto Boss",
                        Content = "Dihospitalisasi saat lawan " .. currentBoss .. "!",
                        Duration = 3
                    })
                elseif IsBossRecovering(bossResult) then
                    LunoLibrary:Notify({
                        Title = "Auto Boss",
                        Content = currentBoss .. " recovering, skip ke boss berikutnya.",
                        Duration = 3
                    })
                    bossIndex = bossIndex + 1
                elseif bossResult.ok == false then
                    LunoLibrary:Notify({
                        Title = "Auto Boss",
                        Content = "Gagal: " .. tostring(bossResult.msg or "Unknown error"),
                        Duration = 3
                    })
                    bossIndex = bossIndex + 1
                else
                    LunoLibrary:Notify({ Title = "Auto Boss", Content = FormatBossReport(currentBoss, bossResult), Duration = 3 })
                    print("[AUTO BOSS] " .. FormatBossReport(currentBoss, bossResult):gsub("\n", " | "))
                end
            else
                bossIndex = bossIndex + 1
            end

            task.wait(ATTACK_DELAY)
        end

        WasWaitingForBossHealth = false
        WasWaitingForBossLevel = false
    end


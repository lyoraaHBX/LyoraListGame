-- ===== LOOP UTAMA PER SLOT (DENGAN GUARD UI) =====
-- Loop ini CUMA di-spawn kalau slot.AutoEnabled = true (lihat toggle callback di bawah).
-- Selama toggle OFF, slot ini TIDAK PERNAH dicek/dibaca sama sekali.
local function RunOperationSlotLoop(slotIndex)
    local slot = OperationSlotState[slotIndex]

    while slot.AutoEnabled do
        local timeLeft, rawInfo = GetSlotTimeLeft(slotIndex)

        if timeLeft and timeLeft > 0 then
            -- Operation masih berjalan (dibaca langsung dari UI game).
            -- JANGAN invoke Collect/Start sama sekali, cuma tunggu.
            local waitChunk = math.min(10, timeLeft)
            task.wait(waitChunk)
        else
            -- timeLeft == 0 (siap collect) ATAU nil (gak kebaca / slot kosong)
            local collectSuccess, collectResult = TryCollectOperation(slotIndex)

            if collectSuccess then
                QueueNotify({
                    Title = "Operation Collected!",
                    Content = "Slot " .. slotIndex .. " reward diklaim.\nCash: " .. tostring(collectResult.cash) .. " | XP: " .. tostring(collectResult.xp),
                    Duration = 3
                })
            end

            if not slot.AutoEnabled then break end

            local opInfo = OPERATIONS_BY_ID[slot.OpId]

            if not opInfo then
                task.wait(10)
            else
                local startSuccess = TryStartOperation(slot.OpId)

                if startSuccess then
                    QueueNotify({
                        Title = "Operation Started",
                        Content = "Slot " .. slotIndex .. ": " .. opInfo.name .. " (" .. FormatDuration(opInfo.duration) .. ")",
                        Duration = 3
                    })

                    -- Kasih jeda biar UI Progress sempat update ke countdown baru
                    task.wait(3)
                else
                    task.wait(8)
                end
            end
        end
    end

    slot.Running = false
end

for slotIndex = 1, 4 do
    OperationsTab:CreateSection("Operation Slot " .. slotIndex)

    OperationsTab:CreateDropdown({
        Title = "Select Operation for Slot " .. slotIndex,
        Options = OperationNamesList,

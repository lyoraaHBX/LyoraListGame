            pcall(function()
                LunoLibrary:Notify({ Title = title, Content = content, Duration = duration or 3 })
            end)
        end
    end

    -----------------------------------------------------------------
    -- Remotes
    -----------------------------------------------------------------
    local ok_remotes, DepositEvent, BuyShopEvent = pcall(function()
        local MWFolder = ReplicatedStorage:WaitForChild("MW", 10)
        local RemotesFolder = MWFolder:WaitForChild("Remotes", 10)
        local dep = RemotesFolder:WaitForChild("Deposit", 10)
        local buy = RemotesFolder:WaitForChild("BuyShopItem", 10)
        return dep, buy
    end)

    if not ok_remotes then
        warn("[BankShop][Debug] Gagal ambil remotes Deposit/BuyShopItem: " .. tostring(DepositEvent))
        return
    end
    print("[BankShop][Debug] Remotes Deposit & BuyShopItem berhasil diambil.")

    -----------------------------------------------------------------
    -- SECTION: BANK (SIMPLIFIED - Toggle Only, Auto Otomatis)
    -----------------------------------------------------------------
    Tab:CreateSection("Auto Deposit Bank")

    local DepositAmount = 1000
    Tab:CreateInput({
        Title = "Jumlah Deposit",
        Placeholder = "1000",
        Callback = function(text)
            local num = tonumber(text)
            if num and num > 0 then
                DepositAmount = math.floor(num)
                print("[BankShop][Debug] DepositAmount diset ke: " .. DepositAmount)
            else
                Notify("Bank", "Jumlah deposit tidak valid", 3)
            end
        end,
    })

    -- Delay internal aman, tidak perlu di-expose ke user (anti CPU/memory spike)
    local INTERNAL_DEPOSIT_DELAY = 1.5
    local INTERNAL_DEPOSIT_DELAY_ON_FAIL = 3

    local function DoDeposit()
        local ok, result = pcall(function()
            return table.pack(DepositEvent:InvokeServer(ACTION_HASH, DepositAmount))
        end)

        if not ok then
            warn("[BankShop][Debug] Error saat InvokeServer Deposit: " .. tostring(result))
            return false
        end

        if result and result[1] and result[1].ok then
            print(("[BankShop][Debug] Deposit sukses | fee=%s kept=%s"):format(
                tostring(result[1].fee), tostring(result[1].kept)
            ))
            return true
        end

        warn("[BankShop][Debug] Deposit gagal, response: " .. tostring(result and result[1]))
        return false
    end

    local AutoDepositEnabled = false

    Tab:CreateToggle({
        Title = "Auto Deposit",
        Default = false,
        Flag = "AutoDepositEnabled",
        Callback = function(value)
            AutoDepositEnabled = value

            if not value then
                Notify("Bank", "Auto Deposit dihentikan", 3)
                return
            end

            Notify("Bank", "Auto Deposit dimulai...", 3)

            task.spawn(function()
                while AutoDepositEnabled do
                    local success = DoDeposit()
                    task.wait(success and INTERNAL_DEPOSIT_DELAY or INTERNAL_DEPOSIT_DELAY_ON_FAIL)
                end
                print("[BankShop][Debug] Loop Auto Deposit berhenti.")
            end)
        end,
    })

    -----------------------------------------------------------------
    -- SECTION: SHOP (Dikategorikan per Prefix + Nama & Tier)
    -----------------------------------------------------------------
    Tab:CreateSection("Auto Buy Shop")

    -----------------------------------------------------------------
    -- Klasifikasi item berdasarkan prefix:
    -- w_  = Weapon | v_  = Vehicle | a_  = Armor
    -- b_  = Border | bg_ = Background | crate_ = Crate | lainnya = Other
    -----------------------------------------------------------------
    local function GetItemCategory(itemId)
        if itemId:sub(1, 3) == "bg_" then
            return "Background"
        end

        local prefix = itemId:match("^(%a+)_")
        if prefix == "w" then
            return "Weapon"
        elseif prefix == "v" then
            return "Vehicle"
        elseif prefix == "a" then
            return "Armor"
        elseif prefix == "b" then
            return "Border"
        elseif prefix == "crate" then
            return "Crate"
        else
            return "Other"
        end
    end

    local CategoryOrder = { "Weapon", "Vehicle", "Armor", "Border", "Background", "Crate", "Other" }

    local GroupedItems = {
        Weapon = {}, Vehicle = {}, Armor = {}, Border = {},
        Background = {}, Crate = {}, Other = {},
    }

    -- Format display: "[T3-Rare] Cane Field Machete"
    local function FormatDisplayName(data)
        local tierNum = data.tier or 0
        local tierLabel = TIER_NAMES[tierNum] or "Unknown"
        local displayName = data.name or data.item
        return ("[T%d-%s] %s"):format(tierNum, tierLabel, displayName)
    end

    local DisplayToId = {}   -- reverse lookup: displayName -> item id
    local IdToDisplay = {}   -- forward lookup: item id -> displayName (buat log/notify)

    for _, data in ipairs(SHOP) do
        local cat = GetItemCategory(data.item)
        local displayName = FormatDisplayName(data)

        DisplayToId[displayName] = data.item
        IdToDisplay[data.item] = displayName

        table.insert(GroupedItems[cat], { display = displayName, tier = data.tier or 0 })
    end

    -- Sort tiap kategori: tier makin tinggi (makin rare) taruh di bawah, alfabet dalam tier sama
    for _, catName in ipairs(CategoryOrder) do
        table.sort(GroupedItems[catName], function(a, b)
            if a.tier ~= b.tier then
                return a.tier < b.tier
            end
            return a.display < b.display
        end)
        print(("[BankShop][Debug] Kategori %s: %d item"):format(catName, #GroupedItems[catName]))
    end

    local SelectedByCategory = {}
    for _, catName in ipairs(CategoryOrder) do
        SelectedByCategory[catName] = {}
    end

    for _, catName in ipairs(CategoryOrder) do
        local items = GroupedItems[catName]
        if #items > 0 then
            local displayOptions = {}
            for _, entry in ipairs(items) do
                table.insert(displayOptions, entry.display)
            end

            Tab:CreateDropdown({
                Title = "Pilih Item: " .. catName,
                Options = displayOptions,
                Multi = true,
                Default = {},
                Flag = "ShopSelected_" .. catName,
                Callback = function(selectedDisplays)
                    local ids = {}
                    for _, disp in ipairs(selectedDisplays or {}) do
                        local id = DisplayToId[disp]
                        if id then table.insert(ids, id) end
                    end
                    SelectedByCategory[catName] = ids
                    print(("[BankShop][Debug] Selected %s: %s"):format(catName, table.concat(ids, ", ")))
                end,
            })
        end
    end

    local function GetAllSelectedItems()
        local combined = {}
        for _, catName in ipairs(CategoryOrder) do
            for _, itemId in ipairs(SelectedByCategory[catName]) do
                table.insert(combined, itemId)
            end
        end
        return combined
    end

    local BuyDelay = 0.5
    local AutoBuyEnabled = false

    local function BuyItem(itemId)
        local ok, result = pcall(function()
            return table.pack(BuyShopEvent:InvokeServer(ACTION_HASH, itemId, nil, nil))
        end)

        if not ok then
            warn("[BankShop][Debug] Error saat InvokeServer BuyShopItem: " .. tostring(result))
            return false
        end

        if result and result[1] and result[1].ok then
            print("[BankShop][Debug] Berhasil beli item: " .. (IdToDisplay[itemId] or itemId))
            return true
        end

        warn(("[BankShop][Debug] Gagal beli %s, response: %s"):format(itemId, tostring(result and result[1])))
        return false
    end

    local function TryBuySelected()
        local SelectedItems = GetAllSelectedItems()

        if #SelectedItems == 0 then
            print("[BankShop][Debug] Tidak ada item terpilih di kategori manapun.")
            return
        end

        task.spawn(function()
            print("[BankShop][Debug] Mulai proses beli " .. #SelectedItems .. " item terpilih...")
            for _, itemId in ipairs(SelectedItems) do
                local success = BuyItem(itemId)
                if success then
                    Notify("Shop", "Berhasil beli: " .. (IdToDisplay[itemId] or itemId), 3)
                end
                task.wait(BuyDelay)
            end
        end)
    end

    Tab:CreateToggle({
        Title = "Auto Buy saat Stock Baru",
        Default = false,
        Flag = "AutoBuyEnabled",
        Callback = function(value)
            AutoBuyEnabled = value
            if value then
                Notify("Shop", "Auto Buy aktif, sinkron dengan restock timer...", 3)
                TryBuySelected()
            else
                Notify("Shop", "Auto Buy dihentikan", 3)
            end
        end,
    })

    Tab:CreateButton({
        Title = "Buy Sekali (untuk testing manual)",
        Callback = function()
            TryBuySelected()
        end,
    })

    -----------------------------------------------------------------
    -- Monitor RestockText -> deteksi refresh stock via ContentText
    -- Hanya trigger buy PERSIS saat stock baru muncul (bukan spam tiap detik)
    -----------------------------------------------------------------
    local function GetRestockLabel()
        local ok, label = pcall(function()
            return LocalPlayer.PlayerGui.MafiaWarsUI.Root.Content.ShopPanel.RestockText
        end)
        if ok then return label end
        return nil
    end

    local function ParseRemainingSeconds(text)
        -- format contoh: "NEW STOCK IN 4:59"
        local m, s = text:match("(%d+):(%d+)")
        if m and s then
            return tonumber(m) * 60 + tonumber(s)
        end
        return nil
    end

    -- 1 thread ringan, cek tiap 1 detik saja (bukan busy loop) supaya CPU tetap adem
    task.spawn(function()
        local lastRemaining = nil
        print("[BankShop][Debug] Thread monitor RestockText dimulai.")

        while true do
            local label = GetRestockLabel()
            if label then
                local ok, text = pcall(function() return label.ContentText end)
                if ok and text then
                    local remaining = ParseRemainingSeconds(text)
                    if remaining then
                        -- Deteksi restock: waktu tiba2 melompat naik jauh dari sebelumnya
                        -- (misal dari 0:02 -> 4:59), artinya cycle baru dimulai
                        if lastRemaining and remaining > lastRemaining + 60 then
                            print("[BankShop][Debug] Restock terdeteksi! lastRemaining=" .. tostring(lastRemaining) .. " -> remaining=" .. tostring(remaining))
                            if AutoBuyEnabled then
                                TryBuySelected()
                            end
                        end
                        lastRemaining = remaining
                    end
                else
                    warn("[BankShop][Debug] Gagal baca ContentText RestockText: " .. tostring(text))
                end
            end
            task.wait(1)
        end
    end)

    Notify("Bank & Shop", "Module berhasil dimuat!", 3)
    print("[BankShop][Debug] Inisialisasi Bank & Shop inline selesai.")
end

--======================================================================
-- [[ CREW SYSTEM (FULL, GABUNGAN) - INLINE (DEBUG MODE) ]]
-- Auto Buy Slot, Auto Hire, Auto Reroll ALL SLOT (dari slot 2 sampai habis),
-- + Info Jumlah Crew & Detail List Member (gabungan dari Crew Upgrade lama)
-- Menggunakan CrewAction remote & hash yang SAMA PERSIS dengan Deposit/BuyShopItem
--======================================================================
do
    local Players = game:GetService("Players")
    local ReplicatedStorage = Context.ReplicatedStorage or game:GetService("ReplicatedStorage")
    local LocalPlayer = Players.LocalPlayer

    local ACTION_HASH = "ca01587a32b24eb1a0527e8e595e8483"

    print("[Crew][Debug] Mulai inisialisasi Crew System inline...")

    -----------------------------------------------------------------
    -- Pastikan LunoLibrary:CreateTab tersedia
    -----------------------------------------------------------------
    if type(LunoLibrary.CreateTab) ~= "function" then
        warn("[Crew][Debug] LunoLibrary:CreateTab tidak ditemukan!")
        return
    end

    local ok_tab, Tab = pcall(function()
        return LunoLibrary:CreateTab("Crew")
    end)

    if not ok_tab or not Tab then
        warn("[Crew][Debug] Gagal buat Tab 'Crew': " .. tostring(Tab))
        return
    end
    print("[Crew][Debug] Tab 'Crew' berhasil dibuat.")

    local function Notify(title, content, duration)
        print(("[Crew][Notify] %s: %s"):format(title, tostring(content)))
        local ok = pcall(function()
            if Context.QueueNotify then
                Context.QueueNotify({ Title = title, Content = content, Duration = duration or 3 })
            else
                LunoLibrary:Notify({ Title = title, Content = content, Duration = duration or 3 })
            end
        end)
        if not ok then
            pcall(function()
                LunoLibrary:Notify({ Title = title, Content = content, Duration = duration or 3 })
            end)
        end
    end

    -----------------------------------------------------------------
    -- Remote CrewAction
    -----------------------------------------------------------------
    local ok_remote, CrewActionEvent = pcall(function()
        local MWFolder = ReplicatedStorage:WaitForChild("MW", 10)
        local RemotesFolder = MWFolder:WaitForChild("Remotes", 10)
        return RemotesFolder:WaitForChild("CrewAction", 10)
    end)

    if not ok_remote then
        warn("[Crew][Debug] Gagal ambil remote CrewAction: " .. tostring(CrewActionEvent))
        return
    end
    print("[Crew][Debug] Remote CrewAction berhasil diambil.")

    -----------------------------------------------------------------
    -- Helper: baca panel crew utk hitung slot yg sudah ada (Member_1..Member_30)
    -----------------------------------------------------------------
    local MAX_SLOT_CAP = 30

    local function GetCrewScroller()
        local ok, scroller = pcall(function()
            return LocalPlayer.PlayerGui.MafiaWarsUI.Root.Content.CrewPanel.Scroller
        end)
        if ok then return scroller end
        return nil
    end

    local function CountExistingSlots()
        local scroller = GetCrewScroller()
        if not scroller then return 0 end

        local count = 0
        for i = 1, MAX_SLOT_CAP do
            local member = scroller:FindFirstChild("Member_" .. i)
            if member then
                count = count + 1
            else
                break
            end
        end
        return count
    end

    -- Scan detail tiap member (fallback: kumpulkan semua TextLabel di dalam frame Member_X)
    local function GetMemberInfo(memberFrame)
        local info = { raw = {} }
        for _, child in ipairs(memberFrame:GetDescendants()) do
            if child:IsA("TextLabel") and child.Text and #child.Text > 0 then
                table.insert(info.raw, child.Text)
            end
        end
        return info
    end

    local function ScanAllMembers()
        local scroller = GetCrewScroller()
        local members = {}

        if not scroller then
            return members
        end

        for i = 1, MAX_SLOT_CAP do
            local memberFrame = scroller:FindFirstChild("Member_" .. i)
            if memberFrame then
                local info = GetMemberInfo(memberFrame)
                info.index = i
                table.insert(members, info)
            else
                break
            end
        end

        return members
    end

    -----------------------------------------------------------------
    -- Low level action wrapper
    -----------------------------------------------------------------
    local function CrewAction(action, arg1, arg2, arg3)
        local ok, result = pcall(function()
            return table.pack(CrewActionEvent:InvokeServer(ACTION_HASH, action, arg1, arg2, arg3))
        end)

        if not ok then
            warn(("[Crew][Debug] Error InvokeServer CrewAction(%s): %s"):format(tostring(action), tostring(result)))
            return nil
        end

        return result and result[1]
    end

    -----------------------------------------------------------------
    -- SECTION: INFO CREW (Live Count) - Digabung dari Crew Upgrade lama
    -----------------------------------------------------------------
    Tab:CreateSection("Info Crew Saat Ini")

    Tab:CreateInput({
        Title = "Jumlah Crew (Live)",
        Placeholder = "Menghitung...",
        Callback = function() end, -- readonly, user gak perlu input apa2
    })

    local LastCrewCount = -1

    local function RefreshCrewInfo(showNotify)
        local members = ScanAllMembers()
        local count = #members

        if showNotify or count ~= LastCrewCount then
            Notify("Crew Info", ("Jumlah Crew: %d / %d slot"):format(count, MAX_SLOT_CAP), 3)
        end

        LastCrewCount = count
        return members
    end

    Tab:CreateButton({
        Title = "Refresh Info Jumlah Crew",
        Callback = function()
            RefreshCrewInfo(true)
        end,
    })

    -----------------------------------------------------------------
    -- SECTION: DETAIL LIST CREW - Digabung dari Crew Upgrade lama
    -----------------------------------------------------------------
    Tab:CreateSection("Detail Member Crew")

    local CrewListUI = Tab:CreateScriptList()

    local function RefreshCrewList()
        local members = ScanAllMembers()

        for _, memberInfo in ipairs(members) do
            local titleText = "Slot " .. memberInfo.index
            local descText = "-"

            if memberInfo.raw and #memberInfo.raw > 0 then
                descText = table.concat(memberInfo.raw, " | ")
            end

            CrewListUI:AddCard({
                Title = titleText,
                Description = descText,
                Icon = "rbxassetid://6031763426",
                Callback = function()
                    Notify("Crew Detail", titleText .. " -> " .. descText, 4)
                end,
            })
        end

        print("[Crew][Debug] Refresh list crew, total: " .. #members)
    end

    Tab:CreateButton({
        Title = "Refresh Detail List Crew",
        Callback = function()
            RefreshCrewList()
        end,
    })

    -----------------------------------------------------------------
    -- Auto-refresh info ringan tiap beberapa detik (background thread)
    -----------------------------------------------------------------
    task.spawn(function()
        print("[Crew][Debug] Thread auto-refresh info crew dimulai.")
        while true do
            RefreshCrewInfo(false)
            task.wait(5) -- cukup jarang biar gak spam notify & CPU tetap adem
        end
    end)

    -- Panggil sekali di awal biar langsung ada info pas tab dibuka
    RefreshCrewInfo(false)
    RefreshCrewList()

    -----------------------------------------------------------------
    -- SECTION: AUTO BUY SLOT (EXPAND)
    -----------------------------------------------------------------
    Tab:CreateSection("Auto Buy Slot")

    local AutoBuySlotEnabled = false

    local function StopAutoBuySlot(reason)
        AutoBuySlotEnabled = false
        LunoLibrary.Flags["AutoBuySlotEnabled"] = false
        if LunoLibrary.Elements["AutoBuySlotEnabled"] and LunoLibrary.Elements["AutoBuySlotEnabled"].Set then
            pcall(function() LunoLibrary.Elements["AutoBuySlotEnabled"].Set(false) end)
        end
        if reason then
            Notify("Crew - Buy Slot", reason, 4)
        end
        print("[Crew][Debug] Auto Buy Slot dihentikan. Alasan: " .. tostring(reason))
    end

    local function RunAutoBuySlot()
        local currentSlots = CountExistingSlots()
        print("[Crew][Debug] Slot terdeteksi saat ini: " .. currentSlots)
        Notify("Crew - Buy Slot", "Slot saat ini: " .. currentSlots .. ", mulai expand...", 3)

        task.spawn(function()
            while AutoBuySlotEnabled do
                local result = CrewAction("buyslot")

                if not result then
                    StopAutoBuySlot("Gagal komunikasi dengan server, auto buy slot dihentikan.")
                    break
                end

                if result.ok then
                    print("[Crew][Debug] Buy slot sukses | cost=" .. tostring(result.cost))
                    Notify("Crew - Buy Slot", "Slot baru dibeli! Cost: $" .. tostring(result.cost), 2)
                    task.wait(1)
                else
                    -- Contoh msg: "The next crew slot costs $26,797 in cash on hand."
                    StopAutoBuySlot(result.msg or "Gagal beli slot (kemungkinan uang tidak cukup).")
                    break
                end
            end
        end)
    end

    Tab:CreateToggle({
        Title = "Auto Buy Slot (Expand Terus Sampai Uang Habis)",
        Default = false,
        Flag = "AutoBuySlotEnabled",
        Callback = function(value)
            AutoBuySlotEnabled = value
            if value then
                RunAutoBuySlot()
            else
                Notify("Crew - Buy Slot", "Auto Buy Slot dihentikan (manual)", 3)
                print("[Crew][Debug] Auto Buy Slot dimatikan manual oleh user.")
            end
        end,
    })

    Tab:CreateButton({
        Title = "Cek Jumlah Slot Sekarang",
        Callback = function()
            local currentSlots = CountExistingSlots()
            Notify("Crew - Info", "Slot terisi/terdeteksi: " .. currentSlots .. " / " .. MAX_SLOT_CAP, 3)
        end,
    })

    -----------------------------------------------------------------
    -- SECTION: AUTO HIRE
    -----------------------------------------------------------------
    Tab:CreateSection("Auto Hire Crew")

    local HireType = "street"
    Tab:CreateInput({
        Title = "Tipe Crew (Hire)",
        Placeholder = "street",
        Callback = function(text)
            if text and #text > 0 then
                HireType = text
                print("[Crew][Debug] HireType diset ke: " .. HireType)
            end
        end,
    })

    local function DoHire(hireType)
        local result = CrewAction("hire", hireType)
        return result
    end

    Tab:CreateButton({
        Title = "Hire Sekali (Testing Manual)",
        Callback = function()
            local result = DoHire(HireType)
            if result and result.ok then
                local m = result.member
                Notify("Crew - Hire", ("Berhasil hire: %s (Rarity %s) di slot %s"):format(
                    tostring(m and m.name), tostring(m and m.rarity), tostring(result.index)
                ), 4)
            else
                Notify("Crew - Hire", (result and result.msg) or "Gagal hire crew.", 4)
            end
        end,
    })

    local AutoHireEnabled = false

    local function StopAutoHire(reason)
        AutoHireEnabled = false
        LunoLibrary.Flags["AutoHireEnabled"] = false
        if LunoLibrary.Elements["AutoHireEnabled"] and LunoLibrary.Elements["AutoHireEnabled"].Set then
            pcall(function() LunoLibrary.Elements["AutoHireEnabled"].Set(false) end)
        end
        if reason then
            Notify("Crew - Auto Hire", reason, 4)
        end
        print("[Crew][Debug] Auto Hire dihentikan. Alasan: " .. tostring(reason))
    end

    Tab:CreateToggle({
        Title = "Auto Hire (Isi Semua Slot Kosong)",
        Default = false,
        Flag = "AutoHireEnabled",
        Callback = function(value)
            AutoHireEnabled = value
            if not value then
                Notify("Crew - Auto Hire", "Auto Hire dihentikan (manual)", 3)
                return
            end

            Notify("Crew - Auto Hire", "Mulai auto hire dengan tipe: " .. HireType, 3)

            task.spawn(function()
                while AutoHireEnabled do
                    local result = DoHire(HireType)

                    if not result then
                        StopAutoHire("Gagal komunikasi dengan server, auto hire dihentikan.")
                        break
                    end

                    if result.ok then
                        local m = result.member
                        print(("[Crew][Debug] Hire sukses: %s (Rarity %s) index=%s"):format(
                            tostring(m and m.name), tostring(m and m.rarity), tostring(result.index)
                        ))
                        Notify("Crew - Auto Hire", ("Hire: %s (Rarity %s)"):format(
                            tostring(m and m.name), tostring(m and m.rarity)
                        ), 2)
                        task.wait(1)
                    else
                        -- Gagal karena slot penuh ATAU uang tidak cukup
                        StopAutoHire(result.msg or "Gagal hire (slot penuh / uang tidak cukup).")
                        break
                    end
                end
            end)
        end,
    })

    -----------------------------------------------------------------
    -- SECTION: AUTO REROLL ALL SLOTS (FIXED LOGIC)
    -- Mulai dari slot 2 sampai slot terakhir yang terdeteksi.
    -- Tiap slot direroll (dismiss+hire) berulang sampai dapat rarity >= target,
    -- baru lanjut ke slot berikutnya. Kalau semua slot sudah selesai, auto-stop.
    -----------------------------------------------------------------
    Tab:CreateSection("Auto Reroll Semua Slot (Mulai dari Slot 2)")

    local RarityOptions = {"1", "2", "3", "4", "5", "6", "7", "8"}
    local TargetRarity = 6

    Tab:CreateDropdown({
        Title = "Target Rarity Minimal (Per Slot)",
        Options = RarityOptions,
        Multi = false,
        Default = "6",
        Flag = "RerollTargetRarity",
        Callback = function(selected)
            local num = tonumber(selected)
            if num then
                TargetRarity = num
                print("[Crew][Debug] TargetRarity diset ke: " .. TargetRarity)
            end
        end,
    })

    local function DoDismiss(slotIndex)
        return CrewAction("dismiss", slotIndex)
    end

    local AutoRerollEnabled = false
    local REROLL_START_SLOT = 2 -- fixed: mulai dari slot nomor 2 (slot 1 dilewati/dianggap starter)

    local function StopAutoReroll(reason)
        AutoRerollEnabled = false
        LunoLibrary.Flags["AutoRerollEnabled"] = false
        if LunoLibrary.Elements["AutoRerollEnabled"] and LunoLibrary.Elements["AutoRerollEnabled"].Set then
            pcall(function() LunoLibrary.Elements["AutoRerollEnabled"].Set(false) end)
        end
        if reason then
            Notify("Crew - Auto Reroll", reason, 4)
        end
        print("[Crew][Debug] Auto Reroll dihentikan. Alasan: " .. tostring(reason))
    end

    Tab:CreateToggle({
        Title = "Auto Reroll Semua Slot (2 s/d Habis) Sampai Rarity Target",
        Default = false,
        Flag = "AutoRerollEnabled",
        Callback = function(value)
            AutoRerollEnabled = value
            if not value then
                Notify("Crew - Auto Reroll", "Auto Reroll dihentikan (manual)", 3)
                return
            end

            local totalSlot = CountExistingSlots()

            if totalSlot < REROLL_START_SLOT then
                Notify("Crew - Auto Reroll", ("Tidak ada slot untuk direroll (total slot saat ini: %d, minimal butuh slot %d)"):format(
                    totalSlot, REROLL_START_SLOT
                ), 4)
                StopAutoReroll(nil)
                return
            end

            Notify("Crew - Auto Reroll", ("Mulai reroll dari slot %d s/d %d, target rarity minimal %d, tipe %s"):format(
                REROLL_START_SLOT, totalSlot, TargetRarity, HireType
            ), 3)

            task.spawn(function()
                local currentSlot = REROLL_START_SLOT

                while AutoRerollEnabled and currentSlot <= totalSlot do
                    print("[Crew][Debug] Mulai reroll slot ke-" .. currentSlot)
                    Notify("Crew - Auto Reroll", "Sedang reroll slot " .. currentSlot .. "...", 2)

                    local slotDone = false

                    while AutoRerollEnabled and not slotDone do
                        local dismissResult = DoDismiss(currentSlot)

                        if not dismissResult then
                            StopAutoReroll("Gagal komunikasi dengan server saat dismiss slot " .. currentSlot .. ", auto reroll dihentikan.")
                            return
                        end

                        if not dismissResult.ok then
                            -- Slot mungkin kosong (belum ada member), lanjut coba hire langsung
                            print("[Crew][Debug] Dismiss gagal/slot kosong (slot " .. currentSlot .. "): " .. tostring(dismissResult.msg))
                        else
                            print("[Crew][Debug] Dismiss sukses (slot " .. currentSlot .. "): " .. tostring(dismissResult.msg))
                        end

                        task.wait(0.3)

                        local hireResult = DoHire(HireType)

                        if not hireResult then
                            StopAutoReroll("Gagal komunikasi dengan server saat hire slot " .. currentSlot .. ", auto reroll dihentikan.")
                            return
                        end

                        if not hireResult.ok then
                            StopAutoReroll(hireResult.msg or ("Gagal hire saat reroll slot " .. currentSlot .. " (uang tidak cukup / slot penuh)."))
                            return
                        end

                        local m = hireResult.member
                        print(("[Crew][Debug] Hasil reroll slot %d: %s (Rarity %s) index=%s"):format(
                            currentSlot, tostring(m and m.name), tostring(m and m.rarity), tostring(hireResult.index)
                        ))

                        if m and m.rarity and m.rarity >= TargetRarity then
                            Notify("Crew - Auto Reroll", ("Slot %d selesai! %s (Rarity %s) >= target %d"):format(
                                currentSlot, tostring(m.name), tostring(m.rarity), TargetRarity
                            ), 3)
                            slotDone = true
                        else
                            Notify("Crew - Auto Reroll", ("Slot %d: rarity %s belum sesuai target %d, ulangi..."):format(
                                currentSlot, tostring(m and m.rarity), TargetRarity
                            ), 1)
                            task.wait(0.4)
                        end
                    end

                    if not AutoRerollEnabled then
                        -- Dihentikan manual di tengah proses
                        return
                    end

                    currentSlot = currentSlot + 1

                    -- Re-scan total slot, in case jumlah slot berubah (misal auto buy slot jalan bareng)
                    totalSlot = CountExistingSlots()
                end

                if AutoRerollEnabled then
                    Notify("Crew - Auto Reroll", ("Semua slot dari %d s/d %d sudah selesai direroll dengan target rarity %d!"):format(
                        REROLL_START_SLOT, totalSlot, TargetRarity
                    ), 5)
                    StopAutoReroll(nil)
                end
            end)
        end,
    })

    Tab:CreateButton({
        Title = "Cek Total Slot Layak Reroll (2 s/d Habis)",
        Callback = function()
            local totalSlot = CountExistingSlots()
            if totalSlot < REROLL_START_SLOT then
                Notify("Crew - Info", "Belum ada slot yang layak direroll (total slot: " .. totalSlot .. ")", 3)
            else
                Notify("Crew - Info", ("Slot yang akan direroll: %d s/d %d (total %d slot)"):format(
                    REROLL_START_SLOT, totalSlot, (totalSlot - REROLL_START_SLOT + 1)
                ), 4)
            end
        end,
    })

    Notify("Crew", "Module Crew berhasil dimuat!", 3)
    print("[Crew][Debug] Inisialisasi Crew System inline selesai.")
end

-- [[ MAIN LOADER - CLEAN & OBFUSCATION FRIENDLY ]] --

local BASE_URL = "https://raw.githubusercontent.com/lyoraaHBX/Module-Lyora/refs/heads/main/"
local LIB_URL = "https://raw.githubusercontent.com/lyoraaHBX/LibraryLyora-X/refs/heads/main/Lyora%20X"

local function NoCacheUrl(url)
    return url .. "?t=" .. tostring(os.time()) .. tostring(math.random(1000, 9999))
end

local function LoadRemote(url)
    local ok, src = pcall(game.HttpGet, game, NoCacheUrl(url))
    if not ok then
        error("[Loader] Gagal fetch: " .. url .. " | " .. tostring(src))
    end

    local ok2, mod = pcall(loadstring(src))
    if not ok2 then
        error("[Loader] Gagal compile: " .. url .. " | " .. tostring(mod))
    end

    return mod
end

-- 1. Load Library UI
local LunoLibrary = LoadRemote(LIB_URL)

-- 2. Load Data Modules
local JobsData        = LoadRemote(BASE_URL .. "JobsData.lua")
local OperationsData  = LoadRemote(BASE_URL .. "OperationsData.lua")
local PropertiesData  = LoadRemote(BASE_URL .. "PropertiesData.lua")
local ShopData        = LoadRemote(BASE_URL .. "ShopData.lua")
local BossesData      = LoadRemote(BASE_URL .. "BossesData.lua")
local BotsData        = LoadRemote(BASE_URL .. "BotsData.lua")

-- 3. Load Shared Core
local SharedCore = LoadRemote(BASE_URL .. "SharedCore.lua")
local Context = SharedCore.Init(LunoLibrary)

-- 4. Load & Init tiap fitur sebagai module terpisah
local FeatureModules = {
    { url = BASE_URL .. "JobModule.lua",         args = { JobsData.JOBS } },
    { url = BASE_URL .. "PropertyModule.lua",    args = { PropertiesData.PROPERTIES } },
    { url = BASE_URL .. "AllocationModule.lua",  args = {} },
    { url = BASE_URL .. "DailyRewardModule.lua", args = {} },
    { url = BASE_URL .. "TaskModule.lua",        args = {} },
    { url = BASE_URL .. "OperationModule.lua",   args = { OperationsData.OPERATIONS } },
    { url = BASE_URL .. "CrewModule.lua",        args = { LunoLibrary } },
    { url = BASE_URL .. "BankShopModule.lua",    args = { ShopData, LunoLibrary } },
    { url = BASE_URL .. "FightBossModule.lua",   args = { LunoLibrary, BossesData.BOSSES, BotsData.BOTS } },
}

for i, feature in ipairs(FeatureModules) do
    local ok, mod = pcall(LoadRemote, feature.url)
    if ok and mod and mod.Init then
        local initOk, initErr = pcall(mod.Init, Context, table.unpack(feature.args))
        if not initOk then
            warn("[FeatureInit Error] " .. feature.url .. ": " .. tostring(initErr))
        end
    else
        warn("[FeatureLoad Error] " .. feature.url .. ": " .. tostring(mod))
    end
end

----------------------------------------------------------------
-- [[ AUTO HEIST - INLINE (BELUM MODULAR, UNTUK MEMPERMUDAH DEBUG) ]]
----------------------------------------------------------------
do
    local ReplicatedStorage = game:GetService("ReplicatedStorage")

    local JOB_HASH = "ca01587a32b24eb1a0527e8e595e8483"

    -- Konstanta (gampang diubah untuk debug)
    local HEIST_RETRY_DELAY      = 3   -- delay retry kalau start gagal
    local HEIST_COLLECT_INTERVAL = 10  -- interval polling collect
    local HEIST_DELAY_BETWEEN    = 2   -- delay antar siklus heist
    local MAX_HEIST_SLOT         = 4   -- range random slot/crew (1 s/d N), sesuaikan kalau perlu

    -- List heist: HANYA id (modular, gampang tambah/kurang)
    local HEIST_LIST = {
        { id = "heist_cornerstore" },
        { id = "heist_truck" },
        { id = "heist_museum" },
        { id = "heist_vault" },
        { id = "heist_bullion" },
        { id = "heist_firstoath" },
        { id = "heist_cistern" },
    }

    -- Dropdown pakai id langsung sebagai display text (tidak perlu mapping nama)
    local HeistIdList = {}
    for _, heistData in ipairs(HEIST_LIST) do
        table.insert(HeistIdList, heistData.id)
    end

    -- Set heist id yang dipilih user via dropdown (bisa lebih dari 1)
    local SelectedHeistIds = {} -- { [id] = true }

    local HeistTab = LunoLibrary:CreateTab("Heist")

    local MWRemotes, HeistActionEvent
    pcall(function()
        MWRemotes        = ReplicatedStorage:WaitForChild("MW"):WaitForChild("Remotes")
        HeistActionEvent = MWRemotes:WaitForChild("HeistAction")
    end)

    local function HeistAction(action, heistId, slot)
        if not HeistActionEvent then return false, nil end
        local ok, result = pcall(function()
            return table.pack(HeistActionEvent:InvokeServer(JOB_HASH, action, heistId, slot))
        end)
        if ok and result[1] then
            return true, result[1]
        end
        return false, nil
    end

    local function IsHeistOnBoard(result)
        if result and result.ok == true and result.msg then
            return tostring(result.msg):lower():find("on the board") ~= nil
        end
        return false
    end

    local function IsHeistLimitReached(result)
        if result and result.ok == false and result.msg then
            return tostring(result.msg):lower():find("already started") ~= nil
        end
        return false
    end

    local function IsHeistCollected(result)
        return result ~= nil and result.ok == true and result.collected == true
    end

    -- Ambil daftar id heist yang sedang dipilih (array, urutan sesuai HEIST_LIST)
    local function GetSelectedHeistList()
        local list = {}
        for _, heistData in ipairs(HEIST_LIST) do
            if SelectedHeistIds[heistData.id] then
                table.insert(list, heistData)
            end
        end
        return list
    end

    ----------------------------------------------------------------
    -- STATE
    ----------------------------------------------------------------
    local AutoHeistEnabled  = false
    local HeistLimitReached = false
    local AUTO_HEIST_FLAG   = "AutoHeistEnabled"

    -- FIX: CreateToggle di library ini TIDAK mengembalikan reference apapun (no return statement),
    -- jadi satu-satunya cara valid untuk mengontrol toggle secara programatic adalah lewat
    -- LunoLibrary.Elements[Flag].Set(value) -- yang di-set internal di dalam CreateToggle.
    local function ForceToggleOff()
        local toggleElement = LunoLibrary.Elements[AUTO_HEIST_FLAG]
        if toggleElement and toggleElement.Set then
            pcall(function() toggleElement.Set(false) end)
        end
    end

    local function StopAutoHeist(reason)
        AutoHeistEnabled  = false
        HeistLimitReached = true
        ForceToggleOff()
        LunoLibrary:Notify({
            Title = "Auto Heist",
            Content = "Limit harian tercapai: " .. tostring(reason),
            Duration = 5
        })
    end

    ----------------------------------------------------------------
    -- MAIN LOOP
    ----------------------------------------------------------------
    local function AutoHeistLoop()
        local heistIndex = 1

        while AutoHeistEnabled do
            if HeistLimitReached then
                AutoHeistEnabled = false
                ForceToggleOff()
                break
            end

            local selectedList = GetSelectedHeistList()

            if #selectedList == 0 then
                LunoLibrary:Notify({
                    Title = "Auto Heist",
                    Content = "Belum ada heist yang dipilih di dropdown!",
                    Duration = 4
                })
                AutoHeistEnabled = false
                ForceToggleOff()
                break
            end

            if heistIndex > #selectedList then
                heistIndex = 1
            end
            local heistData = selectedList[heistIndex]

            ----------------------------------------------------------------
            -- 1. START PHASE (retry sampai berhasil "on the board" / limit / stop)
            ----------------------------------------------------------------
            local started = false
            while AutoHeistEnabled and not started do
                local randomSlot = math.random(1, MAX_HEIST_SLOT)
                local invokeOk, result = HeistAction("start", heistData.id, randomSlot)

                if invokeOk and result then
                    if IsHeistOnBoard(result) then
                        LunoLibrary:Notify({
                            Title = "Auto Heist",
                            Content = "Heist dimulai: " .. heistData.id,
                            Duration = 3
                        })
                        started = true
                    elseif IsHeistLimitReached(result) then
                        StopAutoHeist(result.msg)
                        return
                    elseif result.ok == false then
                        task.wait(HEIST_RETRY_DELAY)
                    else
                        started = true
                    end
                else
                    task.wait(HEIST_RETRY_DELAY)
                end

                if not AutoHeistEnabled then break end
            end

            if not AutoHeistEnabled then break end

            ----------------------------------------------------------------
            -- 2. COLLECT PHASE (polling sampai selesai / limit / stop)
            ----------------------------------------------------------------
            local collected = false
            while AutoHeistEnabled and not collected do
                task.wait(HEIST_COLLECT_INTERVAL)

                local randomSlot = math.random(1, MAX_HEIST_SLOT)
                local invokeOk, result = HeistAction("collect", nil, randomSlot)

                if invokeOk and result then
                    if IsHeistLimitReached(result) then
                        StopAutoHeist(result.msg)
                        return
                    elseif IsHeistCollected(result) then
                        LunoLibrary:Notify({
                            Title = "Auto Heist",
                            Content = heistData.id .. " Collected! XP: " .. tostring(result.xp) .. " | Cash: " .. tostring(result.cash),
                            Duration = 4
                        })
                        collected = true
                    end
                end

                if not AutoHeistEnabled then break end
            end

            if not AutoHeistEnabled then break end

            heistIndex = heistIndex + 1
            task.wait(HEIST_DELAY_BETWEEN)
        end
    end

    ----------------------------------------------------------------
    -- UI
    ----------------------------------------------------------------
    HeistTab:CreateSection("Auto Heist")

    HeistTab:CreateDropdown({
        Title = "Pilih Heist (Multi-Select)",
        Options = HeistIdList,
        Multi = true,
        Default = {},
        Flag = "SelectedHeistIds",
        Callback = function(SelectedNames)
            SelectedHeistIds = {}
            if type(SelectedNames) == "table" then
                for _, heistId in ipairs(SelectedNames) do
                    SelectedHeistIds[heistId] = true
                end
            end
        end
    })

    HeistTab:CreateToggle({
        Title = "Auto Heist (Start & Collect Otomatis)",
        Default = false,
        Flag = AUTO_HEIST_FLAG,
        Callback = function(State)
            if State and HeistLimitReached then
                LunoLibrary:Notify({
                    Title = "Auto Heist",
                    Content = "Limit harian sudah tercapai, tidak bisa dinyalakan lagi hari ini.",
                    Duration = 4
                })
                AutoHeistEnabled = false
                ForceToggleOff()
                return
            end

            AutoHeistEnabled = State
            if State then task.spawn(AutoHeistLoop) end
        end
    })
end

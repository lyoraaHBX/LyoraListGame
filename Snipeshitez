-- [[ MAIN LOADER - CLEAN & OBFUSCATION FRIENDLY ]] --

local BASE_URL = "https://raw.githubusercontent.com/lyoraaHBX/Module-Lyora/refs/heads/main/"
local LIB_URL = "https://raw.githubusercontent.com/lyoraaHBX/LibraryLyora-X/refs/heads/main/Lyora%20X"

local function NoCacheUrl(url)
    return url .. "?t=" .. tostring(os.time()) .. tostring(math.random(1000, 9999))
end

local function LoadRemote(url)
    local ok, src = pcall(game.HttpGet, game, NoCacheUrl(url))
    if not ok then
        error("[Loader] Gagal fetch: " .. url .. " | " .. tostring(src))
    end

    local ok2, mod = pcall(loadstring(src))
    if not ok2 then
        error("[Loader] Gagal compile: " .. url .. " | " .. tostring(mod))
    end

    return mod
end

-- 1. Load Library UI
local LunoLibrary = LoadRemote(LIB_URL)

-- 2. Load Data Modules
local JobsData = LoadRemote(BASE_URL .. "JobsData.lua")
local OperationsData = LoadRemote(BASE_URL .. "OperationsData.lua")
local PropertiesData = LoadRemote(BASE_URL .. "PropertiesData.lua")
local ShopData = LoadRemote(BASE_URL .. "ShopData.lua")

-- 3. Load Shared Core
local SharedCore = LoadRemote(BASE_URL .. "SharedCore.lua")
local Context = SharedCore.Init(LunoLibrary)

-- 4. Load & Init tiap fitur sebagai module terpisah
local FeatureModules = {
    { url = BASE_URL .. "JobModule.lua",         args = { JobsData.JOBS } },
    { url = BASE_URL .. "PropertyModule.lua",    args = { PropertiesData.PROPERTIES } },
    { url = BASE_URL .. "AllocationModule.lua",  args = {} },
    { url = BASE_URL .. "DailyRewardModule.lua", args = {} },
    { url = BASE_URL .. "TaskModule.lua",        args = {} },
    { url = BASE_URL .. "OperationModule.lua",   args = { OperationsData.OPERATIONS } },
    { url = BASE_URL .. "CrewModule.lua",        args = { LunoLibrary } },
    { url = BASE_URL .. "BankShopModule.lua",    args = { ShopData, LunoLibrary } },
}

for i, feature in ipairs(FeatureModules) do
    local ok, mod = pcall(LoadRemote, feature.url)
    if ok and mod and mod.Init then
        local initOk, initErr = pcall(mod.Init, Context, table.unpack(feature.args))
        if not initOk then
            warn("[FeatureInit Error] " .. feature.url .. ": " .. tostring(initErr))
        end
    else
        warn("[FeatureLoad Error] " .. feature.url .. ": " .. tostring(mod))
    end
end

----------------------------------------------------------------
-- [[ FIGHT & BOSSES TAB - AUTO ATTACK SYSTEM ]]
----------------------------------------------------------------
do
    local Players           = game:GetService("Players")
    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local LocalPlayer       = Players.LocalPlayer

    local FightTab = LunoLibrary:CreateTab("Fight & Bosses")

    -- Cache remotes (pcall biar ga hard error kalau path beda)
    local MWRemotes, GetHitListEvent, AttackEvent
    pcall(function()
        MWRemotes       = ReplicatedStorage:WaitForChild("MW"):WaitForChild("Remotes")
        GetHitListEvent = MWRemotes:WaitForChild("GetHitList")
        AttackEvent     = MWRemotes:WaitForChild("Attack")
    end)

    -- Generate random session id (32 hex char) tiap request
    local function GenerateSessionId()
        local chars = "0123456789abcdef"
        local id = {}
        for i = 1, 32 do
            local idx = math.random(1, #chars)
            id[i] = chars:sub(idx, idx)
        end
        return table.concat(id)
    end

    -- Cari TextLabel/TextBox/TextButton bernama "ContentText" secara recursive
    local function FindContentText(inst)
        if not inst then return nil end
        for _, child in ipairs(inst:GetChildren()) do
            if child.Name == "ContentText" and (child:IsA("TextLabel") or child:IsA("TextBox") or child:IsA("TextButton")) then
                return child
            end
            local found = FindContentText(child)
            if found then return found end
        end
        return nil
    end

    -- Ambil level player dari UI
    local function GetMyLevel()
        local ok, result = pcall(function()
            local playerGui   = LocalPlayer:WaitForChild("PlayerGui")
            local mafiaUI     = playerGui:WaitForChild("MafiaWarsUI", 5)
            local levelBadge  = mafiaUI.Root.TopBar.AvatarCard.AvatarCluster.AvatarFrame.LevelBadge

            local contentText = FindContentText(levelBadge)
            if contentText then
                return tonumber(contentText.Text)
            end

            if levelBadge:IsA("TextLabel") then
                return tonumber(levelBadge.Text)
            end
            return nil
        end)
        if ok then return result end
        return nil
    end

    -- Ambil hit list dari server
    local function GetHitList(forceRefresh)
        if not GetHitListEvent then return {} end
        local sessionId = GenerateSessionId()
        local ok, result = pcall(function()
            return table.pack(GetHitListEvent:InvokeServer(sessionId, forceRefresh or false))
        end)
        if ok and result[1] and result[1].ok and result[1].list then
            return result[1].list
        end
        return {}
    end

    -- Serang target
    local function AttackPlayer(targetUserId)
        if not AttackEvent then return false end
        local sessionId = GenerateSessionId()
        local ok = pcall(function()
            AttackEvent:InvokeServer(sessionId, targetUserId)
        end)
        return ok
    end

    -- Cari target valid: level lebih rendah, tidak shielded, stamina > 0
    -- Ambil yang levelnya paling mendekati (tertinggi di bawah level kita) biar respect maksimal
    local function FindValidTarget(list, myLevel)
        local bestTarget = nil
        for _, target in ipairs(list) do
            if target.level and target.level < myLevel then
                if not target.shielded then
                    if not target.stamina or target.stamina > 0 then
                        if not bestTarget or target.level > bestTarget.level then
                            bestTarget = target
                        end
                    end
                end
            end
        end
        return bestTarget
    end

    local AutoAttackEnabled = false
    local AttackDelay = 3

    local function AutoAttackLoop()
        while AutoAttackEnabled do
            local myLevel = GetMyLevel()

            if not myLevel then
                LunoLibrary:Notify({
                    Title = "Fight & Bosses",
                    Content = "Level tidak ditemukan, mencoba lagi...",
                    Duration = 2
                })
                task.wait(AttackDelay)
                continue
            end

            local list = GetHitList(false)
            local target = FindValidTarget(list, myLevel)

            -- Kalau ga ketemu target valid, langsung force refresh
            if not target then
                list = GetHitList(true)
                target = FindValidTarget(list, myLevel)
            end

            if target then
                local success = AttackPlayer(target.userId)
                if success then
                    LunoLibrary:Notify({
                        Title = "Auto Attack",
                        Content = "Menyerang " .. tostring(target.name) .. " (Lv." .. tostring(target.level) .. ")",
                        Duration = 2
                    })
                else
                    LunoLibrary:Notify({
                        Title = "Auto Attack",
                        Content = "Gagal menyerang " .. tostring(target.name),
                        Duration = 2
                    })
                end
            else
                LunoLibrary:Notify({
                    Title = "Auto Attack",
                    Content = "Tidak ada target level rendah, menunggu...",
                    Duration = 2
                })
            end

            task.wait(AttackDelay)
        end
    end

    FightTab:CreateSection("Auto Attack")

    FightTab:CreateToggle({
        Title = "Auto Attack (Target Level Lebih Rendah)",
        Default = false,
        Flag = "AutoAttackLowerLevel",
        Callback = function(State)
            AutoAttackEnabled = State
            if State then
                task.spawn(AutoAttackLoop)
            end
        end
    })

    FightTab:CreateSlider({
        Title = "Attack Delay",
        Min = 1,
        Max = 15,
        Default = 3,
        Suffix = "s",
        Flag = "AttackDelayValue",
        Callback = function(Value)
            AttackDelay = Value
        end
    })

    FightTab:CreateSection("Info")

    FightTab:CreateButton({
        Title = "Cek Level Saya Sekarang",
        Callback = function()
            local lvl = GetMyLevel()
            LunoLibrary:Notify({
                Title = "Level Info",
                Content = lvl and ("Level kamu saat ini: " .. tostring(lvl)) or "Level tidak ditemukan!",
                Duration = 3
            })
        end
    })

    FightTab:CreateSection("Bosses")

    FightTab:CreateButton({
        Title = "Auto Boss (Coming Soon)",
        Callback = function()
            LunoLibrary:Notify({
                Title = "Bosses",
                Content = "Fitur Auto Boss belum tersedia.",
                Duration = 3
            })
        end
    })
end

-- =========================================================
-- AUTO POINT ALLOCATION (SKILL POINT) SYSTEM
-- =========================================================
local AllocateSkillPointRemote = ReplicatedStorage:WaitForChild("MW"):WaitForChild("Remotes"):WaitForChild("AllocateSkillPoint")
local ALLOCATE_HASH = "ca01587a32b24eb1a0527e8e595e8483"

local StatOptionsList = {"Energy", "Stamina", "Health", "Attack", "Defense", "Property Capacity"}

local StatKeyMap = {
    ["Energy"] = "energy",
    ["Stamina"] = "stamina",
    ["Health"] = "health",
    ["Attack"] = "attack",
    ["Defense"] = "defense",
    ["Property Capacity"] = "property"
}

local AutoAllocateEnabled = false
local SelectedStatKey = "energy"
local AutoAllocateToggleRef = nil

local function TryAllocatePoint(statKey)
    local success, result = pcall(function()
        return AllocateSkillPointRemote:InvokeServer(ALLOCATE_HASH, statKey, 1)
    end)

    if success and type(result) == "table" then
        if result.ok == true then
            return true, result
        else
            return false, result
        end
    end

    return false, nil
end

MainTab:CreateSection("Auto Point Allocation")

MainTab:CreateDropdown({
    Title = "Select Stat to Upgrade",
    Options = StatOptionsList,
    Multi = false,
    Flag = "SelectedStatUpgrade",
    Callback = function(Selected)
        if StatKeyMap[Selected] then
            SelectedStatKey = StatKeyMap[Selected]
        end
    end
})

AutoAllocateToggleRef = MainTab:CreateToggle({
    Title = "Auto Allocate Skill Point",
    Default = false,
    Flag = "AutoAllocateToggle",
    Callback = function(Value)
        AutoAllocateEnabled = Value
        if Value then
            QueueNotify({
                Title = "Auto Allocate Started",
                Content = "Sedang alokasi poin ke: " .. SelectedStatKey,
                Duration = 3
            })
        end
    end
})

MainTab:CreateButton({
    Title = "Allocate 1 Point Now",
    Callback = function()
        local success, result = TryAllocatePoint(SelectedStatKey)

        if success then
            QueueNotify({
                Title = "Point Allocated",
                Content = "Berhasil alokasi 1 poin ke: " .. SelectedStatKey,
                Duration = 3
            })
        else
            local msg = (result and result.msg) or "Gagal alokasi poin (mungkin poin habis)."
            QueueNotify({
                Title = "Allocate Failed",
                Content = msg,
                Duration = 3
            })
        end
    end
})

Scheduler:Add("AutoAllocate", 1.3, function()
    if not AutoAllocateEnabled then return end

    local success, result = TryAllocatePoint(SelectedStatKey)

    if success then
        QueueNotify({
            Title = "Point Allocated!",
            Content = "Berhasil alokasi 1 poin ke: " .. SelectedStatKey,
            Duration = 2
        })
    else
        AutoAllocateEnabled = false
        ForceSetToggleOff(AutoAllocateToggleRef, "AutoAllocateToggle")

        local msg = (result and result.msg) or "Poin sudah habis atau terjadi error."
        QueueNotify({
            Title = "Auto Allocate Stopped",
            Content = "Auto Allocate dimatikan otomatis.\nAlasan: " .. msg,
            Duration = 4
        })
    end
end)

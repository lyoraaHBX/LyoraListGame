-- =========================================================
-- GENERIC UI VALUE READER (LEVEL / ENERGY / HEALTH / STAMINA)
-- Support parsing format "current/max" (ex: "19/20")
-- =========================================================
local function SafeFindPath(pathParts)
    local current = LocalPlayer
    for _, partName in ipairs(pathParts) do
        if not current then return nil end
        current = current:FindFirstChild(partName)
    end
    return current
end

local function ReadNodeValue(node)
    if not node then return 0, 0, "N/A" end

    local rawValue = "N/A"

    local attrValue = node:GetAttribute("ContentText")
    if attrValue ~= nil then
        rawValue = tostring(attrValue)
    elseif node:IsA("ValueBase") then
        rawValue = tostring(node.Value)
    elseif node:IsA("TextLabel") or node:IsA("TextButton") then
        rawValue = node.Text
    else
        local childText = node:FindFirstChildOfClass("TextLabel")
        if childText then
            rawValue = childText.Text
        end
    end

    local current, max = string.match(tostring(rawValue), "(%-?%d+)%s*/%s*(%-?%d+)")
    if current and max then
        return tonumber(current), tonumber(max), rawValue
    end

    local single = tonumber(rawValue) or tonumber(string.match(tostring(rawValue), "%-?%d+"))
    if single then
        return single, single, rawValue
    end

    return 0, 0, rawValue
end

-- =========================================================
-- LEVEL MONITOR
-- =========================================================
local CurrentDetectedLevel = 1
local CurrentRawLevelText = "N/A"

local LevelPath = {"PlayerGui", "MafiaWarsUI", "Root", "TopBar", "AvatarCard", "AvatarCluster", "AvatarFrame", "LevelBadge"}

local function SetupLevelListener()
    local levelBadge = SafeFindPath(LevelPath)
    if not levelBadge then
        task.delay(2, SetupLevelListener)
        return
    end

    local function UpdateLevel()
        local val, _, raw = ReadNodeValue(levelBadge)
        CurrentDetectedLevel = val
        CurrentRawLevelText = raw
    end

    UpdateLevel()

    levelBadge:GetAttributeChangedSignal("ContentText"):Connect(UpdateLevel)

    local childText = levelBadge:FindFirstChildOfClass("TextLabel")
    if childText then
        childText:GetPropertyChangedSignal("Text"):Connect(UpdateLevel)
    end

    task.spawn(function()
        while levelBadge and levelBadge.Parent do
            UpdateLevel()
            task.wait(1)
        end
    end)
end

SetupLevelListener()

-- Cari job dengan level tertinggi yang <= level saat ini (handle gap level otomatis)
local function GetHighestUnlockedJob()
    local currentLvl = CurrentDetectedLevel
    local highestJobId = "j_watch"
    local highestJobName = "Keep Watch on the Corner"

    for _, job in ipairs(JOBS) do
        if currentLvl >= job.level then
            highestJobId = job.id
            highestJobName = job.name
        else
            break
        end
    end
    return highestJobId, currentLvl, highestJobName, CurrentRawLevelText
end


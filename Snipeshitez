-- [[ MAIN LOADER - LUNO / LYORA X UI ]] --

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local LocalPlayer = Players.LocalPlayer

-- Ganti sesuai lokasi repo kamu
local BaseModuleUrl = "https://raw.githubusercontent.com/lyoraaHBX/Module-Lyora/refs/heads/main/"

local function LoadModule(name)
    return loadstring(game:HttpGet(BaseModuleUrl .. name))()
end

-- 1. Load Library
local LunoLibrary = loadstring(game:HttpGet("https://raw.githubusercontent.com/lyoraaHBX/LibraryLyora-X/refs/heads/main/Lyora%20X"))()

-- 2. Load Core Modules
local Config = LoadModule("Config.lua")
local Utils = LoadModule("Utils.lua")
local Scheduler = LoadModule("Scheduler.lua")
local NotifyModule = LoadModule("NotifyQueue.lua")

local QueueNotify = NotifyModule.Create(LunoLibrary)

local function ForceSetToggleOff(toggleObject, flagName)
    Utils.ForceSetToggleOff(LunoLibrary, toggleObject, flagName)
end

-- 3. Load Data
local JobsData = LoadModule("JobsData.lua")
local OperationsData = LoadModule("OperationsData.lua")

-- 4. Load Feature Modules
local StateMonitor = LoadModule("StateMonitor.lua")
local JobManager = LoadModule("JobManager.lua")
local OperationsManager = LoadModule("OperationsManager.lua")
local DailyReward = LoadModule("DailyReward.lua")
local TasksManager = LoadModule("TasksManager.lua")
local SkillAllocation = LoadModule("SkillAllocation.lua")

-- 5. Init State Monitor (Level & Bars)
local State = StateMonitor.Init(Utils, Config, Scheduler)

-- 6. Build UI Window & Tabs
local Window = LunoLibrary:CreateWindow({
    Title = Config.WindowTitle,
    SubTitle = Config.WindowSubTitle,
    Discord = Config.DiscordUrl
})

local MainTab = Window:CreateTab("Auto Farm")
local OperationsTab = Window:CreateTab("Operations")

-- 7. Common Dependencies (dipakai hampir semua modul)
local CommonDeps = {
    ReplicatedStorage = ReplicatedStorage,
    Config = Config,
    Scheduler = Scheduler,
    QueueNotify = QueueNotify,
    ForceSetToggleOff = ForceSetToggleOff,
    Utils = Utils,
    State = State,
    LocalPlayer = LocalPlayer,
}

-- 8. Init Job Manager
local JobDeps = {}
for k, v in pairs(CommonDeps) do JobDeps[k] = v end
JobDeps.JOBS = JobsData.JOBS
JobManager.Init(MainTab, JobDeps)

-- 9. Init Operations Manager
local OpsDeps = {}
for k, v in pairs(CommonDeps) do OpsDeps[k] = v end
OpsDeps.OPERATIONS = OperationsData.OPERATIONS
OperationsManager.Init(OperationsTab, OpsDeps)

-- 10. Init Daily Reward
DailyReward.Init(MainTab, CommonDeps)

-- 11. Init Daily & Weekly Task
TasksManager.Init(MainTab, CommonDeps)

-- 12. Init Skill Allocation
SkillAllocation.Init(MainTab, CommonDeps)

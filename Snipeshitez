-- =========================================================
-- UNIFIED SCHEDULER (ANTI-LAG SYSTEM)
-- =========================================================
local Scheduler = {}
Scheduler.Tasks = {}

function Scheduler:Add(name, interval, callback)
    self.Tasks[name] = {
        interval = interval,
        lastRun = 0,
        callback = callback,
        busy = false,
    }
end

function Scheduler:Remove(name)
    self.Tasks[name] = nil
end

RunService.Heartbeat:Connect(function()
    local now = tick()
    for name, t in pairs(Scheduler.Tasks) do
        if not t.busy and (now - t.lastRun) >= t.interval then
            t.lastRun = now
            t.busy = true
            task.spawn(function()
                local ok, err = pcall(t.callback)
                if not ok then
                    warn("[Scheduler Error] " .. name .. ": " .. tostring(err))
                end
                t.busy = false
            end)
        end
    end
end)

-- =========================================================
-- NOTIFY THROTTLE (ANTI SPAM UI / ANTI FRAME FREEZE)
-- =========================================================
local NotifyQueue = {}
local NotifyProcessing = false

local function QueueNotify(data)
    data.Duration = data.Duration or 2.5
    table.insert(NotifyQueue, data)

    if not NotifyProcessing then
        NotifyProcessing = true
        task.spawn(function()
            while #NotifyQueue > 0 do
                local item = table.remove(NotifyQueue, 1)
                pcall(function()
                    LunoLibrary:Notify(item)
                end)
                task.wait(0.35)
            end
            NotifyProcessing = false
        end)
    end
end

-- =========================================================
-- GENERIC UI VALUE READER (BACKGROUND ONLY - NO UI BUTTON)
-- =========================================================
local function SafeFindPath(pathParts)
    local current = LocalPlayer
    for _, partName in ipairs(pathParts) do
        if not current then return nil end
        current = current:FindFirstChild(partName)
    end
    return current
end

local function GetRawTextFromNode(node)
    if not node then return nil end

    local attrValue = node:GetAttribute("ContentText")
    if attrValue ~= nil then
        return tostring(attrValue)
    elseif node:IsA("TextLabel") or node:IsA("TextButton") then
        return node.Text
    else
        local childText = node:FindFirstChildOfClass("TextLabel")
        if childText then
            return childText.Text
        end
    end

    return nil
end

local function ReadNodeValue(node)
    if not node then return 0, 0, "N/A" end

    local rawValue = GetRawTextFromNode(node)
    if rawValue == nil then
        if node:IsA("ValueBase") then
            rawValue = tostring(node.Value)
        else
            rawValue = "N/A"
        end
    end

    local current, max = string.match(tostring(rawValue), "(%-?%d+)%s*/%s*(%-?%d+)")
    if current and max then
        return tonumber(current), tonumber(max), rawValue
    end

    local single = tonumber(rawValue) or tonumber(string.match(tostring(rawValue), "%-?%d+"))
    if single then
        return single, single, rawValue
    end

    return 0, 0, rawValue
end


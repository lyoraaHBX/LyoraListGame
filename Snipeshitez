                    LunoLibrary:Notify({
                        Title = "Bot Farm",
                        Content = "Power kamu (" .. tostring(myPower) .. ") kurang untuk bot ini (Def: " .. tostring(currentBot.def) .. "). Menunggu power naik...",
                        Duration = 3
                    })
                    BotWasWaitingForPower = true
                end
                task.wait(ATTACK_DELAY)
                continue
            else
                if BotWasWaitingForPower then
                    LunoLibrary:Notify({
                        Title = "Bot Farm",
                        Content = "Power sudah cukup! Melanjutkan serangan.",
                        Duration = 2
                    })
                    BotWasWaitingForPower = false
                end
            end

            local now = os.clock()

            if now >= nextBotAttackTime then
                local invokeSuccess, result = AttackPlayer(currentBot.userId)

                if invokeSuccess and result then
                    if IsHospitalized(result) then
                        LunoLibrary:Notify({
                            Title = "Bot Farm",
                            Content = "Kamu dihospitalisasi saat lawan bot! " .. tostring(result.msg),
                            Duration = 3
                        })
                    elseif result.ok == false then
                        LunoLibrary:Notify({
                            Title = "Bot Farm",
                            Content = "Gagal menyerang bot: " .. tostring(result.msg or "Unknown error") .. ", skip bot ini.",
                            Duration = 3
                        })
                        botIndex = botIndex + 1
                    else
                        LunoLibrary:Notify({
                            Title = "Bot Farm",
                            Content = FormatBattleReport(result),
                            Duration = 3
                        })
                        print("[BOT FARM] " .. FormatBattleReport(result):gsub("\n", " | "))

                        if result.won then
                            -- UNLIMITED repeat: tidak ada cap, tetap di bot yang sama selamanya selama menang
                            -- (tidak pindah index otomatis)
                        else
                            -- Kalah -> pindah ke bot berikutnya
                            LunoLibrary:Notify({
                                Title = "Bot Farm",
                                Content = "Kalah melawan bot ini, lanjut ke bot berikutnya.",
                                Duration = 3
                            })
                            botIndex = botIndex + 1
                        end
                    end
                end

                nextBotAttackTime = os.clock() + ATTACK_REPEAT_DELAY
            end

            task.wait(ATTACK_DELAY)
        end

        BotWasWaitingForStamina = false
        BotWasWaitingForHealth = false
        BotWasWaitingForPower = false
    end

    ----------------------------------------------------------------
    -- AUTO BOSS LOOP
    ----------------------------------------------------------------
    local AutoBossEnabled = false
    local WasWaitingForBossHealth = false
    local WasWaitingForBossLevel = false

    local function AutoBossLoop()
        local bossIndex = 1

        while AutoBossEnabled do
            if bossIndex > #BOSS_LIST then
                LunoLibrary:Notify({
                    Title = "Auto Boss",
                    Content = "Semua boss dalam list sudah diserang! Auto Boss selesai.",
                    Duration = 4
                })
                AutoBossEnabled = false
                break
            end

            local currentBossData = BOSS_LIST[bossIndex]
            local currentBoss = currentBossData.id

            local myLevel = GetMyLevel()
            if myLevel and currentBossData.level and myLevel < currentBossData.level then
                if not WasWaitingForBossLevel then
                    LunoLibrary:Notify({
                        Title = "Auto Boss",
                        Content = currentBoss .. " requires level " .. currentBossData.level .. ". Level kamu: " .. myLevel .. ". Menunggu...",
                        Duration = 3
                    })
                    WasWaitingForBossLevel = true
                end
                task.wait(LEVEL_CHECK_INTERVAL)
                continue
            else
                if WasWaitingForBossLevel then
                    LunoLibrary:Notify({
                        Title = "Auto Boss",
                        Content = "Level sudah cukup untuk " .. currentBoss .. "! Melanjutkan serangan.",
                        Duration = 2
                    })
                    WasWaitingForBossLevel = false
                end
            end

            local myHealth = GetMyHealth(false)
            if myHealth ~= nil and myHealth < MIN_HEALTH_TO_RESUME then
                if not WasWaitingForBossHealth then
                    LunoLibrary:Notify({
                        Title = "Auto Boss",
                        Content = "Health rendah (" .. tostring(myHealth) .. "), menunggu regen ke atas " .. MIN_HEALTH_TO_RESUME .. "...",
                        Duration = 3
                    })
                    WasWaitingForBossHealth = true
                end
                task.wait(ATTACK_DELAY)
                continue
            else
                if WasWaitingForBossHealth then
                    LunoLibrary:Notify({
                        Title = "Auto Boss",
                        Content = "Health sudah pulih! Melanjutkan serangan boss.",
                        Duration = 2
                    })
                    WasWaitingForBossHealth = false
                end
            end

            local invokeSuccess, bossResult = AttackBoss(currentBoss)

            if invokeSuccess and bossResult then
                local isRequireLevel, requiredLevel = GetRequiredLevel(bossResult)

                if isRequireLevel then
                    if not WasWaitingForBossLevel then
                        LunoLibrary:Notify({
                            Title = "Auto Boss",
                            Content = currentBoss .. " requires level " .. tostring(requiredLevel) .. " (dari server). Menunggu level naik...",
                            Duration = 3
                        })
                        WasWaitingForBossLevel = true
                    end
                    task.wait(LEVEL_CHECK_INTERVAL)
                    continue
                elseif IsHospitalized(bossResult) then
                    LunoLibrary:Notify({
                        Title = "Auto Boss",
                        Content = "Kamu dihospitalisasi saat lawan " .. currentBoss .. "! " .. tostring(bossResult.msg),
                        Duration = 3
                    })
                elseif IsBossRecovering(bossResult) then
                    LunoLibrary:Notify({
                        Title = "Auto Boss",
                        Content = currentBoss .. " sedang recovering, skip ke boss berikutnya. (" .. tostring(bossResult.msg) .. ")",
                        Duration = 3
                    })
                    print("[AUTO BOSS] Skip " .. currentBoss .. " -> " .. tostring(bossResult.msg))
                    bossIndex = bossIndex + 1
                elseif bossResult.ok == false then
                    LunoLibrary:Notify({
                        Title = "Auto Boss",
                        Content = "Gagal menyerang " .. currentBoss .. ": " .. tostring(bossResult.msg or "Unknown error"),
                        Duration = 3
                    })
                    print("[AUTO BOSS] Error di " .. currentBoss .. " -> " .. tostring(bossResult.msg))
                    bossIndex = bossIndex + 1
                else
                    LunoLibrary:Notify({
                        Title = "Auto Boss",
                        Content = FormatBossReport(currentBoss, bossResult),
                        Duration = 3
                    })
                    print("[AUTO BOSS] " .. FormatBossReport(currentBoss, bossResult):gsub("\n", " | "))
                end
            else
                LunoLibrary:Notify({
                    Title = "Auto Boss",
                    Content = "Invoke gagal untuk " .. currentBoss,
                    Duration = 3
                })
                bossIndex = bossIndex + 1
            end

            task.wait(ATTACK_DELAY)
        end

        WasWaitingForBossHealth = false
        WasWaitingForBossLevel = false
    end


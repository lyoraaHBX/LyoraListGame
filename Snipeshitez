-- =========================================================
-- MAIN AUTO JOB LOOP (LOGIC BARU)
-- Alur: Cek Level -> Tentukan Job -> Cek Energy -> Invoke (kalau cukup)
-- Kalau Energy kurang, SKIP tanpa spam invoke, tunggu regen.
-- Interval check di-fix 1 detik (tidak bisa diatur user).
-- =========================================================
local AUTO_JOB_CHECK_INTERVAL = 1 -- fixed, tidak bisa diubah user

task.spawn(function()
    while true do
        task.wait(AUTO_JOB_CHECK_INTERVAL)

        if AutoJobEnabled then
            local targetJobId

            if AutoHighestMode then
                targetJobId = GetHighestUnlockedJob()
            else
                targetJobId = SelectedJobId
            end

            local jobInfo = JOBS_BY_ID[targetJobId]

            if jobInfo then
                -- Cek apakah job sudah unlock berdasarkan level (safety check untuk manual select)
                local levelOk = CurrentDetectedLevel >= jobInfo.level

                -- Cek apakah energy cukup untuk 1x job
                local energyOk = CurrentEnergy >= jobInfo.energy

                if levelOk and energyOk then
                    pcall(function()
                        DoJobRemote:InvokeServer(JOB_HASH, targetJobId)
                    end)
                end
                -- Kalau levelOk == false atau energyOk == false -> SKIP, tidak invoke apapun (no spam)
            end
        end
    end
end)

local LADDER_HASH = "ca01587a32b24eb1a0527e8e595e8483"

local AutoClaimEnabled = false
local ClaimedStatus = {false, false, false, false, false}
local AutoClaimToggleRef = nil

local function TryClaimReward(index)
    local success, result = pcall(function()
        return ClaimLadderRemote:InvokeServer(LADDER_HASH, index)
    end)

    if success and type(result) == "table" then
        if result.ok == true then
            ClaimedStatus[index] = true
            return true, result
        else
            if result.msg and string.find(tostring(result.msg), "Already claimed") then
                ClaimedStatus[index] = true
            end
            return false, result
        end
    end

    return false, nil
end

local function IsAllRewardsClaimed()
    for i = 1, 5 do
        if not ClaimedStatus[i] then
            return false
        end
    end
    return true
end

MainTab:CreateSection("Daily Playtime Reward")

AutoClaimToggleRef = MainTab:CreateToggle({
    Title = "Auto Claim Daily Playtime Reward",
    Default = false,
    Flag = "AutoClaimLadderToggle",
    Callback = function(Value)
        AutoClaimEnabled = Value
        if Value then
            QueueNotify({
                Title = "Auto Claim Started",
                Content = "Sedang mengecek Daily Playtime Reward 1-5...",
                Duration = 3
            })
        end
    end
})

MainTab:CreateButton({
    Title = "Claim All Available Rewards Now",
    Callback = function()
        local claimedCount = 0
        for i = 1, 5 do
            if not ClaimedStatus[i] then
                local success = TryClaimReward(i)
                if success then
                    claimedCount = claimedCount + 1
                end
                task.wait(0.5)
            end
        end

        QueueNotify({
            Title = "Claim Selesai",
            Content = "Berhasil claim " .. claimedCount .. " reward baru.",
            Duration = 3
        })

        if IsAllRewardsClaimed() then
            AutoClaimEnabled = false
            ForceSetToggleOff(AutoClaimToggleRef, "AutoClaimLadderToggle")
        end
    end
})

Scheduler:Add("DailyReward", 1.7, function()
    if not AutoClaimEnabled or IsAllRewardsClaimed() then return end

    for i = 1, 5 do
        if not ClaimedStatus[i] then
            local success = TryClaimReward(i)
            if success then
                QueueNotify({
                    Title = "Daily Reward Claimed!",
                    Content = "Berhasil claim reward Day " .. i .. ".",
                    Duration = 2.5
                })
            end
            task.wait(0.3)
        end
    end

    if IsAllRewardsClaimed() then
        AutoClaimEnabled = false
        ForceSetToggleOff(AutoClaimToggleRef, "AutoClaimLadderToggle")

        QueueNotify({
            Title = "All Daily Rewards Claimed",
            Content = "Semua reward 1-5 sudah diklaim. Auto Claim dimatikan otomatis.",
            Duration = 4
        })
    end
end)


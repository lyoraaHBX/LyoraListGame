OperationsTab:CreateDropdown({
    Title = "Max Active Operation Slots (Sesuai Gamepass)",
    Options = {"1", "2", "3", "4"},
    Multi = false,
    Flag = "MaxOperationSlots",
    Callback = function(Selected)
        local num = tonumber(Selected) or 1
        MaxOperationSlots = num

        for i = 1, 4 do
            if i > MaxOperationSlots and OperationSlotState[i].AutoEnabled then
                OperationSlotState[i].AutoEnabled = false
                ForceSetToggleOff(OperationSlotState[i].ToggleRef, "AutoOperationSlot" .. i .. "Toggle")

                QueueNotify({
                    Title = "Slot " .. i .. " OFF",
                    Content = "Slot ini melebihi Max Active Slots (" .. MaxOperationSlots .. "). Auto dimatikan otomatis.",
                    Duration = 3
                })
            end
        end
    end
})

local function RunOperationSlotLoop(slotIndex)
    local slot = OperationSlotState[slotIndex]

    while slot.AutoEnabled do
        local timeLeft = GetSlotTimeLeft(slotIndex)

        if timeLeft and timeLeft > 0 then
            local waitChunk = math.min(10, timeLeft)
            task.wait(waitChunk)
        else
            local collectSuccess, collectResult = TryCollectOperation(slotIndex)

            if collectSuccess then
                QueueNotify({
                    Title = "Operation Collected!",
                    Content = "Slot " .. slotIndex .. " reward diklaim.\nCash: " .. tostring(collectResult.cash) .. " | XP: " .. tostring(collectResult.xp),
                    Duration = 3
                })
            end

            if not slot.AutoEnabled then break end

            local opInfo = OPERATIONS_BY_ID[slot.OpId]

            if not opInfo then
                task.wait(10)
            else
                local startSuccess = TryStartOperation(slot.OpId)

                if startSuccess then
                    QueueNotify({
                        Title = "Operation Started",
                        Content = "Slot " .. slotIndex .. ": " .. opInfo.name .. " (" .. FormatDuration(opInfo.duration) .. ")",
                        Duration = 3
                    })

                    task.wait(3)
                else
                    task.wait(8)
                end
            end
        end
    end

    slot.Running = false
end

for slotIndex = 1, 4 do
    OperationsTab:CreateSection("Operation Slot " .. slotIndex)

    OperationsTab:CreateDropdown({
        Title = "Select Operation for Slot " .. slotIndex,
        Options = OperationNamesList,
        Multi = false,
        Flag = "SelectedOperationSlot" .. slotIndex,
        Callback = function(Selected)
            if OperationMap[Selected] then
                OperationSlotState[slotIndex].OpId = OperationMap[Selected]
            end
        end
    })

    local toggleRef = OperationsTab:CreateToggle({
        Title = "Enable Auto Slot " .. slotIndex,
        Default = false,
        Flag = "AutoOperationSlot" .. slotIndex .. "Toggle",
        Callback = function(Value)
            local slot = OperationSlotState[slotIndex]

            if Value and slotIndex > MaxOperationSlots then
                QueueNotify({
                    Title = "Slot " .. slotIndex .. " OFF",
                    Content = "Slot ini melebihi Max Active Slots (" .. MaxOperationSlots .. "). Naikkan limit dulu di dropdown atas.",
                    Duration = 4
                })
                slot.AutoEnabled = false
                ForceSetToggleOff(slot.ToggleRef, "AutoOperationSlot" .. slotIndex .. "Toggle")
                return
            end

            slot.AutoEnabled = Value

            if Value then
                local opInfo = OPERATIONS_BY_ID[slot.OpId]
                QueueNotify({
                    Title = "Auto Slot " .. slotIndex .. " Started",
                    Content = "Operation: " .. (opInfo and opInfo.name or "Belum dipilih"),
                    Duration = 3
                })

                if not slot.Running then
                    slot.Running = true
                    task.spawn(function()
                        RunOperationSlotLoop(slotIndex)
                    end)
                end
            end
        end
    })

    OperationSlotState[slotIndex].ToggleRef = toggleRef
end


local function SetupBarListener(pathParts, updateCallback)
    local node = SafeFindPath(pathParts)
    if not node then
        task.delay(2, function()
            SetupBarListener(pathParts, updateCallback)
        end)
        return
    end

    local function DoUpdate()
        local val, maxVal = ReadNodeValue(node)
        updateCallback(val, maxVal)
    end

    DoUpdate()

    node:GetAttributeChangedSignal("ContentText"):Connect(DoUpdate)

    if node:IsA("ValueBase") then
        node:GetPropertyChangedSignal("Value"):Connect(DoUpdate)
    end

    local childText = node:FindFirstChildOfClass("TextLabel")
    if childText then
        childText:GetPropertyChangedSignal("Text"):Connect(DoUpdate)
    end

    task.spawn(function()
        while node and node.Parent do
            DoUpdate()
            task.wait(0.5)
        end
    end)
end


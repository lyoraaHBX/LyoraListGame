local ClaimLadderRemote = ReplicatedStorage:WaitForChild("MW"):WaitForChild("Remotes"):WaitForChild("ClaimLadder")
local LADDER_HASH = "ca01587a32b24eb1a0527e8e595e8483"

local AutoClaimEnabled = false
local ClaimedStatus = {false, false, false, false, false}
local AutoClaimToggleRef = nil

local function TryClaimReward(index)
    local success, result = pcall(function()
        return ClaimLadderRemote:InvokeServer(LADDER_HASH, index)
    end)

    if success and type(result) == "table" then
        if result.ok == true then
            ClaimedStatus[index] = true
            return true, result
        else
            if result.msg and string.find(tostring(result.msg), "Already claimed") then
                ClaimedStatus[index] = true
            end
            return false, result
        end
    end

    return false, nil
end

local function IsAllRewardsClaimed()
    for i = 1, 5 do
        if not ClaimedStatus[i] then
            return false
        end
    end
    return true
end


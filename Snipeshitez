-- POOLS MONITOR (BACKGROUND - DIPAKAI AUTO JOB, TANPA UI)
-- =========================================================
local CurrentEnergy, MaxEnergy = 0, 0
local CurrentStamina, MaxStamina = 0, 0
local CurrentHealth, MaxHealth = 0, 0

local EnergyPath = {"PlayerGui", "MafiaWarsUI", "Root", "TopBar", "BarsCluster", "EnergyBar", "Value"}
local StaminaPath = {"PlayerGui", "MafiaWarsUI", "Root", "TopBar", "BarsCluster", "StaminaBar", "Value"}
local HealthPath = {"PlayerGui", "MafiaWarsUI", "Root", "TopBar", "BarsCluster", "HealthBar", "Value"}

local function SetupBarListener(pathParts, updateCallback)
    local node = SafeFindPath(pathParts)
    if not node then
        task.delay(2, function()
            SetupBarListener(pathParts, updateCallback)
        end)
        return
    end

    local function DoUpdate()
        local val, maxVal = ReadNodeValue(node)
        updateCallback(val, maxVal)
    end

    DoUpdate()

    node:GetAttributeChangedSignal("ContentText"):Connect(DoUpdate)

    if node:IsA("ValueBase") then
        node:GetPropertyChangedSignal("Value"):Connect(DoUpdate)
    end

    local childText = node:FindFirstChildOfClass("TextLabel")
    if childText then
        childText:GetPropertyChangedSignal("Text"):Connect(DoUpdate)
    end

    task.spawn(function()
        while node and node.Parent do
            DoUpdate()
            task.wait(0.5)
        end
    end)
end

SetupBarListener(EnergyPath, function(val, maxVal)
    CurrentEnergy = val
    MaxEnergy = maxVal
end)

SetupBarListener(StaminaPath, function(val, maxVal)
    CurrentStamina = val
    MaxStamina = maxVal
end)

SetupBarListener(HealthPath, function(val, maxVal)
    CurrentHealth = val
    MaxHealth = maxVal
end)


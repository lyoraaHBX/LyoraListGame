-- [[ MAIN LOADER - CLEAN & OBFUSCATION FRIENDLY ]] --

local BASE_URL = "https://raw.githubusercontent.com/lyoraaHBX/Module-Lyora/refs/heads/main/"
local LIB_URL = "https://raw.githubusercontent.com/lyoraaHBX/LibraryLyora-X/refs/heads/main/Lyora%20X"

local function NoCacheUrl(url)
    return url .. "?t=" .. tostring(os.time()) .. tostring(math.random(1000, 9999))
end

local function LoadRemote(url)
    local ok, src = pcall(game.HttpGet, game, NoCacheUrl(url))
    if not ok then
        error("[Loader] Gagal fetch: " .. url .. " | " .. tostring(src))
    end

    local ok2, mod = pcall(loadstring(src))
    if not ok2 then
        error("[Loader] Gagal compile: " .. url .. " | " .. tostring(mod))
    end

    return mod
end

-- 1. Load Library UI
local LunoLibrary = LoadRemote(LIB_URL)

-- 2. Load Data Modules
local JobsData = LoadRemote(BASE_URL .. "JobsData.lua")
local OperationsData = LoadRemote(BASE_URL .. "OperationsData.lua")
local PropertiesData = LoadRemote(BASE_URL .. "PropertiesData.lua")
local ShopData = LoadRemote(BASE_URL .. "ShopData.lua")

-- 3. Load Shared Core
local SharedCore = LoadRemote(BASE_URL .. "SharedCore.lua")
local Context = SharedCore.Init(LunoLibrary)

-- 4. Load & Init tiap fitur sebagai module terpisah
local FeatureModules = {
    { url = BASE_URL .. "JobModule.lua",         args = { JobsData.JOBS } },
    { url = BASE_URL .. "PropertyModule.lua",    args = { PropertiesData.PROPERTIES } },
    { url = BASE_URL .. "AllocationModule.lua",  args = {} },
    { url = BASE_URL .. "DailyRewardModule.lua", args = {} },
    { url = BASE_URL .. "TaskModule.lua",        args = {} },
    { url = BASE_URL .. "OperationModule.lua",   args = { OperationsData.OPERATIONS } },
    { url = BASE_URL .. "BankShopModule.lua",    args = { ShopData, LunoLibrary } },
}

for i, feature in ipairs(FeatureModules) do
    local ok, mod = pcall(LoadRemote, feature.url)
    if ok and mod and mod.Init then
        print("[Loader] Loading order #" .. i .. ": " .. feature.url)
        local initOk, initErr = pcall(mod.Init, Context, table.unpack(feature.args))
        if not initOk then
            warn("[FeatureInit Error] " .. feature.url .. ": " .. tostring(initErr))
        end
    else
        warn("[FeatureLoad Error] " .. feature.url .. ": " .. tostring(mod))
    end
end

--[[
    ============================================================
    CREW UPGRADE (INLINE - TIDAK DIPISAH JADI MODULE)
    Tab sendiri: "Crew Upgrade"

    STRUKTUR UI (mengikuti section header seperti contoh gambar):
      [AUTO EXPAND]
        - Auto Expand Crew Slot (Toggle)

      [AUTO ROLL CREW RARITY]
        - Auto Roll Crew Rarity (Toggle)
        - Roll Mode (Dropdown: One By One / All At Once)
        - Roll Speed (Dropdown: Slow/Normal/Fast)
        - Hire Tier (Dropdown: Street/Professional/Elite)
        - Target Rarity (Dropdown)
        - Keep Rarity (Dropdown)

      [SINGLE SLOT ROLL]
        - Auto Roll Single Slot (Toggle terpisah, independen)
        - Target Slot (Dropdown, auto-refresh sesuai HENCHMEN)
        (pakai Target Rarity & Keep Rarity yang SAMA dari section atas)

    LOGIC "SELESAI" UNTUK SATU SLOT (2 kondisi, mana saja duluan):
      1. EXACT MATCH  -> rarity PERSIS SAMA dengan Target Rarity.
      2. KEEP RARITY  -> rarity SUDAH >= Keep Rarity (safety net,
                          dianggap "hoki", auto stop & disimpan).

    SLOT DINAMIS (dari UI HENCHMEN):
      PlayerGui.MafiaWarsUI.Root.Content.CrewPanel.SummaryRow.BadgeMembers
      Format: "16 OF 16 HENCHMEN" -> slot 2..16

    AUTO EXPAND CREW SLOT:
      Spam invoke "buyslot" terus menerus. Kalau hasilnya:
        { ok = true, cost = ... }    -> lanjut beli lagi
        { ok = false, msg = "..." }  -> STOP, toggle dimatikan
                                         otomatis (logic & visual OFF)

    Rarity Mapping (Urut Rendah -> Tinggi):
      Common=1, Uncommon=2, Rare=3, Epic=4,
      Legendary=5, Mythic=6, Secret=7, Forbidden=8

    Hire Tier: street, professional, elite
    ============================================================
--]]

do
    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local Players = game:GetService("Players")
    local LocalPlayer = Players.LocalPlayer

    -- Sama persis dengan JOB_HASH di JobModule.lua
    local ACTION_HASH = "ca01587a32b24eb1a0527e8e595e8483"

    local okRemote, CrewEvent = pcall(function()
        return ReplicatedStorage:WaitForChild("MW"):WaitForChild("Remotes"):WaitForChild("CrewAction")
    end)

    if okRemote and CrewEvent then
        local CrewTab = LunoLibrary:CreateTab("Crew Upgrade")

        ------------------------------------------------------------
        -- KONSTANTA & MAPPING RARITY
        ------------------------------------------------------------
        local CREW_SLOTS_FALLBACK = {2, 3, 4, 5, 6}

        local RarityNameToValue = {
            ["Common"]    = 1,
            ["Uncommon"]  = 2,
            ["Rare"]      = 3,
            ["Epic"]      = 4,
            ["Legendary"] = 5,
            ["Mythic"]    = 6,
            ["Secret"]    = 7,
            ["Forbidden"] = 8,
        }

        local RarityValueToName = {}
        for name, val in pairs(RarityNameToValue) do
            RarityValueToName[val] = name
        end

        local RarityOptions = {"Common", "Uncommon", "Rare", "Epic", "Legendary", "Mythic", "Secret", "Forbidden"}

        local SpeedPresets = {
            ["Slow"]   = 0.6,
            ["Normal"] = 0.35,
            ["Fast"]   = 0.15,
        }

        ------------------------------------------------------------
        -- STATE
        ------------------------------------------------------------
        local Settings = {
            RollMode          = "OneByOne", -- "OneByOne" / "AllAtOnce"
            HireTier          = "street",
            MinRarity         = RarityNameToValue["Common"],
            KeepRarity        = RarityNameToValue["Forbidden"],
            ActionDelay       = SpeedPresets["Normal"],
            MaxAttemptsPerSlot = 500,
            MaxConsecutiveFailNotify = 10,
            RecheckIdleDelay  = 2,
            TargetSlotSingle  = 2, -- dipakai khusus untuk toggle "Auto Roll Single Slot"
        }

        local RollRunning = false
        local StopRollRequested = false

        local SingleSlotRunning = false
        local StopSingleSlotRequested = false

        local ExpandRunning = false
        local StopExpandRequested = false

        -- Menyimpan rarity terakhir yang kita ketahui per slot
        local KnownSlotRarity = {}

        ------------------------------------------------------------
        -- BACA JUMLAH HENCHMEN DARI UI GAME
        ------------------------------------------------------------
        local function GetCurrentHenchmenMax()
            local ok, result = pcall(function()
                local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
                if not playerGui then return nil end

                local mafiaUI = playerGui:FindFirstChild("MafiaWarsUI")
                if not mafiaUI then return nil end

                local root = mafiaUI:FindFirstChild("Root")
                if not root then return nil end

                local content = root:FindFirstChild("Content")
                if not content then return nil end

                local crewPanel = content:FindFirstChild("CrewPanel")
                if not crewPanel then return nil end

                local summaryRow = crewPanel:FindFirstChild("SummaryRow")
                if not summaryRow then return nil end

                local badgeMembers = summaryRow:FindFirstChild("BadgeMembers")
                if not badgeMembers then return nil end

                local textSource = nil

                if badgeMembers:IsA("TextLabel") or badgeMembers:IsA("TextButton") then
                    textSource = badgeMembers.Text
                end

                if not textSource then
                    local contentText = badgeMembers:FindFirstChild("ContentText")
                    if contentText and (contentText:IsA("TextLabel") or contentText:IsA("TextButton")) then
                        textSource = contentText.Text
                    end
                end

                if not textSource then
                    for _, desc in ipairs(badgeMembers:GetDescendants()) do
                        if desc:IsA("TextLabel") or desc:IsA("TextButton") then
                            if desc.Text and desc.Text:match("OF%s+%d+") then
                                textSource = desc.Text
                                break
                            end
                        end
                    end
                end

                if not textSource then return nil end

                local maxNum = textSource:match("OF%s+(%d+)")
                if maxNum then
                    return tonumber(maxNum)
                end
                return nil
            end)

            if ok then return result end
            return nil
        end

        ------------------------------------------------------------
        -- GENERATE SLOT LIST DINAMIS (2 sampai max HENCHMEN)
        ------------------------------------------------------------
        local function GetCrewSlots()
            local maxHenchmen = GetCurrentHenchmenMax()
            if not maxHenchmen or maxHenchmen < 2 then
                return CREW_SLOTS_FALLBACK
            end

            local slots = {}
            for i = 2, maxHenchmen do
                table.insert(slots, i)
            end
            return slots
        end

        local function GetSlotOptionsAsStrings()
            local slots = GetCrewSlots()
            local opts = {}
            for _, s in ipairs(slots) do
                table.insert(opts, tostring(s))
            end
            if #opts == 0 then
                opts = {"2"}
            end
            return opts
        end

        ------------------------------------------------------------
        -- HELPER: Safe Invoke
        ------------------------------------------------------------
        local function SafeInvoke(...)
            local args = { ... }
            local ok, result = pcall(function()
                return table.pack(CrewEvent:InvokeServer(table.unpack(args)))
            end)
            if ok then return result end
            return nil
        end

        local function DismissSlot(slot)
            return SafeInvoke(ACTION_HASH, "dismiss", slot, nil, nil)
        end

        local function HireCrew(hireType)
            return SafeInvoke(ACTION_HASH, "hire", hireType, nil, nil)
        end

        local function BuySlot()
            return SafeInvoke(ACTION_HASH, "buyslot", nil, nil, nil)
        end

        local function ExtractResult(packedResult)
            if packedResult and packedResult[1] and type(packedResult[1]) == "table" then
                local data = packedResult[1]
                if data.ok and data.member then
                    return true, data.member.rarity, data.index, data.member
                end
                return false, nil, nil, nil
            end
            return false, nil, nil, nil
        end

        local function ExtractBuySlotResult(packedResult)
            if packedResult and packedResult[1] and type(packedResult[1]) == "table" then
                local data = packedResult[1]
                return data.ok, data.cost, data.msg
            end
            return nil, nil, nil
        end

        ------------------------------------------------------------
        -- CEK APAKAH SLOT SUDAH DIPROTEKSI (dari rarity yang sudah diketahui)
        ------------------------------------------------------------
        local function IsSlotProtected(slot)
            local knownRarity = KnownSlotRarity[slot]
            if knownRarity and knownRarity >= Settings.KeepRarity then
                return true
            end
            return false
        end

        ------------------------------------------------------------
        -- CEK APAKAH RARITY TERTENTU SUDAH "SELESAI" (target/keep)
        ------------------------------------------------------------
        local function CheckIsDone(rarity)
            if rarity == Settings.MinRarity then
                return true, "target"
            elseif rarity >= Settings.KeepRarity then
                return true, "kept"
            end
            return false, nil
        end

        ------------------------------------------------------------
        -- REROLL SATU SLOT SEKALI (1 KALI DISMISS + HIRE)
        ------------------------------------------------------------
        local function RerollSlotOnce(slot)
            DismissSlot(slot)
            task.wait(Settings.ActionDelay)

            local hireResult = HireCrew(Settings.HireTier)
            task.wait(Settings.ActionDelay)

            local ok, rarity, index, member = ExtractResult(hireResult)
            if ok then
                KnownSlotRarity[slot] = rarity
                LunoLibrary:Notify({
                    Title = "Slot " .. tostring(slot),
                    Content = string.format("%s | Rarity: %s (%d)", tostring(member.name), RarityValueToName[rarity] or "?", rarity),
                    Duration = 1.2
                })
            end
            return ok, rarity
        end

        ------------------------------------------------------------
        -- REROLL 1 SLOT SAMPAI SELESAI (EXACT MATCH ATAU KEEP RARITY)
        -- Parameter stopFlagGetter: function yang return true kalau harus stop
        ------------------------------------------------------------
        local function RerollSlotUntilTarget(slot, stopFlagGetter)
            local attempts = 0
            local consecutiveFails = 0

            while not stopFlagGetter() and attempts < Settings.MaxAttemptsPerSlot do
                attempts = attempts + 1
                local ok, rarity = RerollSlotOnce(slot)

                if not ok then
                    consecutiveFails = consecutiveFails + 1
                    local backoff = math.min(0.5 + (consecutiveFails * 0.25), 3)
                    task.wait(backoff)

                    if consecutiveFails % Settings.MaxConsecutiveFailNotify == 0 then
                        LunoLibrary:Notify({
                            Title = "Invalid Invoke - Slot " .. slot,
                            Content = "Gagal " .. consecutiveFails .. "x beruntun, masih mencoba lagi...",
                            Duration = 1.5
                        })
                    end
                else
                    consecutiveFails = 0
                    local isDone, reason = CheckIsDone(rarity)
                    if isDone then
                        return true, reason
                    end
                end
            end

            return false, "maxattempts"
        end

        ------------------------------------------------------------
        -- MODE: REPLACE ONE BY ONE (DINAMIS + AUTO-EXTEND SLOT)
        ------------------------------------------------------------
        local function RunRollOneByOne()
            local processedSlots = {}

            while not StopRollRequested do
                local slots = GetCrewSlots()

                for _, slot in ipairs(slots) do
                    if StopRollRequested then break end

                    if not processedSlots[slot] then
                        if IsSlotProtected(slot) then
                            processedSlots[slot] = true
                            LunoLibrary:Notify({Title = "Slot " .. slot .. " Dilewati", Content = "Sudah memenuhi Keep Rarity sebelumnya.", Duration = 1.5})
                        else
                            local reached, reason = RerollSlotUntilTarget(slot, function() return StopRollRequested end)
                            processedSlots[slot] = true

                            if reached then
                                if reason == "kept" then
                                    LunoLibrary:Notify({Title = "Slot " .. slot .. " Selesai (Kept)", Content = "Rarity >= Keep Rarity tercapai, dipertahankan!", Duration = 2})
                                else
                                    LunoLibrary:Notify({Title = "Slot " .. slot .. " Selesai", Content = "Target Rarity tercapai persis!", Duration = 2})
                                end
                            elseif not StopRollRequested then
                                LunoLibrary:Notify({Title = "Slot " .. slot .. " Dilewati", Content = "Batas maksimal percobaan tercapai.", Duration = 2})
                            end
                        end
                    end
                end

                if StopRollRequested then break end

                local allProcessed = true
                for _, slot in ipairs(slots) do
                    if not processedSlots[slot] then
                        allProcessed = false
                        break
                    end
                end

                if allProcessed then
                    task.wait(Settings.RecheckIdleDelay)
                    local newSlots = GetCrewSlots()
                    if #newSlots <= #slots then
                        break
                    end
                end
            end
        end

        ------------------------------------------------------------
        -- MODE: REPLACE ALL AT ONCE (DINAMIS + AUTO-EXTEND SLOT)
        ------------------------------------------------------------
        local function RunRollAllAtOnce()
            local doneSlots = {}
            local round = 0

            while not StopRollRequested and round < Settings.MaxAttemptsPerSlot do
                round = round + 1
                local slots = GetCrewSlots()
                local allDone = true

                for _, slot in ipairs(slots) do
                    if StopRollRequested then break end

                    if not doneSlots[slot] then
                        local currentRarity = KnownSlotRarity[slot]

                        if currentRarity then
                            local isDone = CheckIsDone(currentRarity)
                            if isDone then
                                doneSlots[slot] = true
                            end
                        end

                        if not doneSlots[slot] then
                            allDone = false
                            local ok, rarity = RerollSlotOnce(slot)
                            if ok then
                                local isDone, reason = CheckIsDone(rarity)
                                if isDone then
                                    doneSlots[slot] = true
                                    if reason == "kept" then
                                        LunoLibrary:Notify({Title = "Slot " .. slot .. " Stop (Kept)", Content = "Rarity >= Keep Rarity, dipertahankan!", Duration = 1.5})
                                    else
                                        LunoLibrary:Notify({Title = "Slot " .. slot .. " Stop", Content = "Target Rarity tercapai persis!", Duration = 1.5})
                                    end
                                end
                            else
                                task.wait(0.6)
                            end
                        end
                    end
                end

                if allDone then
                    task.wait(Settings.RecheckIdleDelay)
                    local newSlots = GetCrewSlots()
                    if #newSlots <= #slots then
                        break
                    end
                end
            end
        end

        ------------------------------------------------------------
        -- MAIN RUNNER TOGGLE: Auto Roll Crew Rarity
        ------------------------------------------------------------
        local function StartAutoRoll()
            if RollRunning then return end
            RollRunning = true
            StopRollRequested = false

            task.spawn(function()
                if Settings.RollMode == "AllAtOnce" then
                    RunRollAllAtOnce()
                else
                    RunRollOneByOne()
                end

                RollRunning = false
                if LunoLibrary.Elements and LunoLibrary.Elements["CrewAutoRollToggle"] then
                    pcall(function() LunoLibrary.Elements["CrewAutoRollToggle"].Set(false) end)
                end

                LunoLibrary:Notify({Title = "Crew Roll", Content = "Proses selesai / dihentikan.", Duration = 2})
            end)
        end

        local function StopAutoRoll()
            StopRollRequested = true
        end

        ------------------------------------------------------------
        -- TOGGLE TERPISAH: AUTO ROLL SINGLE SLOT
        -- Independen dari toggle utama, pakai Target Rarity & Keep
        -- Rarity yang SAMA (Settings.MinRarity / Settings.KeepRarity).
        -- Otomatis berhenti (toggle off) kalau target sudah tercapai.
        ------------------------------------------------------------
        local function RunSingleSlotOnly()
            local slot = Settings.TargetSlotSingle

            if not slot then
                LunoLibrary:Notify({Title = "Error", Content = "Pilih Target Slot terlebih dahulu!", Duration = 2})
                return
            end

            local validSlots = GetCrewSlots()
            local isValid = false
            for _, s in ipairs(validSlots) do
                if s == slot then
                    isValid = true
                    break
                end
            end

            if not isValid then
                LunoLibrary:Notify({Title = "Error", Content = "Slot " .. tostring(slot) .. " tidak tersedia saat ini.", Duration = 2.5})
                return
            end

            if IsSlotProtected(slot) then
                LunoLibrary:Notify({Title = "Slot " .. slot .. " Dilewati", Content = "Sudah memenuhi Keep Rarity sebelumnya.", Duration = 2})
                return
            end

            local reached, reason = RerollSlotUntilTarget(slot, function() return StopSingleSlotRequested end)
            if reached then
                if reason == "kept" then
                    LunoLibrary:Notify({Title = "Slot " .. slot .. " Selesai (Kept)", Content = "Rarity >= Keep Rarity tercapai!", Duration = 2.5})
                else
                    LunoLibrary:Notify({Title = "Slot " .. slot .. " Selesai", Content = "Target Rarity tercapai persis!", Duration = 2.5})
                end
            elseif not StopSingleSlotRequested then
                LunoLibrary:Notify({Title = "Slot " .. slot .. " Dilewati", Content = "Batas maksimal percobaan tercapai.", Duration = 2.5})
            end
        end

        local function StartSingleSlotRoll()
            if SingleSlotRunning then return end
            SingleSlotRunning = true
            StopSingleSlotRequested = false

            task.spawn(function()
                RunSingleSlotOnly()

                SingleSlotRunning = false
                -- WAJIB: matikan toggle otomatis begitu target tercapai / proses selesai
                if LunoLibrary.Elements and LunoLibrary.Elements["CrewAutoRollSingleSlot"] then
                    pcall(function() LunoLibrary.Elements["CrewAutoRollSingleSlot"].Set(false) end)
                end
            end)
        end

        local function StopSingleSlotRoll()
            StopSingleSlotRequested = true
        end

        ------------------------------------------------------------
        -- AUTO EXPAND CREW SLOT
        -- Terus beli slot baru sampai server balikin ok=false.
        -- Setelah gagal, toggle WAJIB mati (logic + visual OFF).
        ------------------------------------------------------------
        local function StartAutoExpand()
            if ExpandRunning then return end
            ExpandRunning = true
            StopExpandRequested = false

            task.spawn(function()
                while not StopExpandRequested do
                    local result = BuySlot()
                    local ok, cost, msg = ExtractBuySlotResult(result)

                    if ok == true then
                        LunoLibrary:Notify({
                            Title = "Auto Expand Slot",
                            Content = "Slot baru berhasil dibeli! Cost: $" .. tostring(cost),
                            Duration = 2
                        })
                        task.wait(Settings.ActionDelay)
                    elseif ok == false then
                        LunoLibrary:Notify({
                            Title = "Auto Expand Slot Berhenti",
                            Content = msg or "Tidak bisa membeli slot baru lagi.",
                            Duration = 4
                        })
                        break
                    else
                        LunoLibrary:Notify({
                            Title = "Auto Expand Slot Error",
                            Content = "Invoke gagal / invalid, mencoba lagi...",
                            Duration = 1.5
                        })
                        task.wait(1)
                    end
                end

                ExpandRunning = false
                StopExpandRequested = false

                -- WAJIB: matikan toggle (logic & visual OFF) setelah selesai/gagal
                if LunoLibrary.Elements and LunoLibrary.Elements["CrewAutoExpandSlot"] then
                    pcall(function() LunoLibrary.Elements["CrewAutoExpandSlot"].Set(false) end)
                end
            end)
        end

        local function StopAutoExpand()
            StopExpandRequested = true
        end

        ------------------------------------------------------------
        -- UI ELEMENTS (DENGAN SECTION HEADER)
        ------------------------------------------------------------

        -- ===== SECTION: AUTO EXPAND (PALING ATAS) =====
        CrewTab:CreateSection("Auto Expand")

        CrewTab:CreateToggle({
            Title = "Auto Expand Crew Slot",
            Default = false,
            Flag = "CrewAutoExpandSlot",
            Callback = function(State)
                if State then
                    StartAutoExpand()
                else
                    StopAutoExpand()
                end
            end
        })

        -- ===== SECTION: AUTO ROLL CREW RARITY =====
        CrewTab:CreateSection("Auto Roll Crew Rarity")

        CrewTab:CreateToggle({
            Title = "Auto Roll Crew Rarity",
            Default = false,
            Flag = "CrewAutoRollToggle",
            Callback = function(State)
                if State then
                    StartAutoRoll()
                else
                    StopAutoRoll()
                end
            end
        })

        CrewTab:CreateDropdown({
            Title = "Roll Mode",
            Options = {"Replace One By One", "Replace All At Once"},
            Default = "Replace One By One",
            Flag = "CrewRollMode",
            Callback = function(Value)
                if Value == "Replace All At Once" then
                    Settings.RollMode = "AllAtOnce"
                else
                    Settings.RollMode = "OneByOne"
                end
            end
        })

        CrewTab:CreateDropdown({
            Title = "Roll Speed",
            Options = {"Slow", "Normal", "Fast"},
            Default = "Normal",
            Flag = "CrewRollSpeed",
            Callback = function(Value)
                Settings.ActionDelay = SpeedPresets[Value] or 0.35
            end
        })

        CrewTab:CreateDropdown({
            Title = "Hire Tier",
            Options = {"STREET", "PROFESSIONAL", "ELITE"},
            Default = "STREET",
            Flag = "CrewHireTier",
            Callback = function(Value)
                Settings.HireTier = string.lower(Value)
            end
        })

        CrewTab:CreateDropdown({
            Title = "Target Rarity",
            Options = RarityOptions,
            Default = "Common",
            Flag = "CrewMinRarity",
            Callback = function(Value)
                Settings.MinRarity = RarityNameToValue[Value] or 1
            end
        })

        CrewTab:CreateDropdown({
            Title = "Keep Rarity",
            Options = RarityOptions,
            Default = "Forbidden",
            Flag = "CrewKeepRarity",
            Callback = function(Value)
                Settings.KeepRarity = RarityNameToValue[Value] or 8
            end
        })

        -- ===== SECTION: SINGLE SLOT ROLL (TOGGLE TERPISAH) =====
        CrewTab:CreateSection("Single Slot Roll")

        CrewTab:CreateToggle({
            Title = "Auto Roll Single Slot",
            Default = false,
            Flag = "CrewAutoRollSingleSlot",
            Callback = function(State)
                if State then
                    StartSingleSlotRoll()
                else
                    StopSingleSlotRoll()
                end
            end
        })

        local SlotDropdownObj = CrewTab:CreateDropdown({
            Title = "Target Slot",
            Options = GetSlotOptionsAsStrings(),
            Default = tostring(Settings.TargetSlotSingle),
            Flag = "CrewTargetSlotSingle",
            Callback = function(Value)
                Settings.TargetSlotSingle = tonumber(Value)
            end
        })

        ------------------------------------------------------------
        -- BACKGROUND WATCHER: Auto-refresh KHUSUS dropdown "Target Slot"
        -- ketika jumlah HENCHMEN berubah. Tidak mempengaruhi mode lain
        -- karena One By One & All At Once sudah scan slot sendiri
        -- secara realtime lewat GetCrewSlots().
        ------------------------------------------------------------
        task.spawn(function()
            local lastSlotCount = #GetCrewSlots()
            while true do
                task.wait(3)
                local currentSlots = GetCrewSlots()
                if #currentSlots ~= lastSlotCount then
                    lastSlotCount = #currentSlots
                    if SlotDropdownObj then
                        SlotDropdownObj.Refresh(GetSlotOptionsAsStrings())
                    end
                end
            end
        end)
    else
        warn("[CrewUpgrade] Gagal menemukan CrewAction Remote.")
    end
end

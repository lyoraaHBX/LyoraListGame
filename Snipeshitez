local CurrentDetectedLevel = 1

local LevelPath = {"PlayerGui", "MafiaWarsUI", "Root", "TopBar", "AvatarCard", "AvatarCluster", "AvatarFrame", "LevelBadge"}

local function SetupLevelListener()
    local levelBadge = SafeFindPath(LevelPath)
    if not levelBadge then
        task.delay(2, SetupLevelListener)
        return
    end

    local function UpdateLevel()
        local val = ReadNodeValue(levelBadge)
        CurrentDetectedLevel = val
    end

    UpdateLevel()

    levelBadge:GetAttributeChangedSignal("ContentText"):Connect(UpdateLevel)

    local childText = levelBadge:FindFirstChildOfClass("TextLabel")
    if childText then
        childText:GetPropertyChangedSignal("Text"):Connect(UpdateLevel)
    end

    task.spawn(function()
        while levelBadge and levelBadge.Parent do
            UpdateLevel()
            task.wait(1)
        end
    end)
end

SetupLevelListener()

local function GetHighestUnlockedJob()
    local currentLvl = CurrentDetectedLevel
    local highestJobId = "j_watch"
    local highestJobName = "Keep Watch on the Corner"

    for _, job in ipairs(JOBS) do
        if currentLvl >= job.level then
            highestJobId = job.id
            highestJobName = job.name
        else
            break
        end
    end
    return highestJobId, currentLvl, highestJobName
end


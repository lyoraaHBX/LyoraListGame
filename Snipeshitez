-- [[ FIGHT & BOSSES TAB - AUTO ATTACK SYSTEM ]]
----------------------------------------------------------------
do
    local Players           = game:GetService("Players")
    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local LocalPlayer       = Players.LocalPlayer

    local JOB_HASH = "ca01587a32b24eb1a0527e8e595e8483"

    -- Konstanta fix (tidak bisa diubah via UI)
    local ATTACK_DELAY = 1
    local MAX_LEVEL_GAP_ABOVE = 1
    local MAX_WIN_STREAK = 5
    local MIN_HEALTH_TO_RESUME = 30

    local FightTab = LunoLibrary:CreateTab("Fight & Bosses")

    -- Cache remotes (pcall biar ga hard error kalau path beda)
    local MWRemotes, GetHitListEvent, AttackEvent
    pcall(function()
        MWRemotes       = ReplicatedStorage:WaitForChild("MW"):WaitForChild("Remotes")
        GetHitListEvent = MWRemotes:WaitForChild("GetHitList")
        AttackEvent     = MWRemotes:WaitForChild("Attack")
    end)

    -- Safe index chain (tidak error kalau salah satu step nil)
    local function SafeIndex(root, ...)
        local current = root
        for _, name in ipairs({...}) do
            if not current then return nil end
            local ok, nextInst = pcall(function() return current:FindFirstChild(name) end)
            if not ok or not nextInst then return nil end
            current = nextInst
        end
        return current
    end

    -- Cari descendant berdasarkan nama (fallback kalau path exact gagal)
    local function FindDescendantByName(root, name)
        if not root then return nil end
        local ok, descendants = pcall(function() return root:GetDescendants() end)
        if not ok then return nil end
        for _, child in ipairs(descendants) do
            if child.Name == name then
                return child
            end
        end
        return nil
    end

    -- Ambil level player dari UI dengan multi-fallback
    local function GetMyLevel()
        local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
        if not playerGui then return nil end

        local mafiaUI = playerGui:FindFirstChild("MafiaWarsUI")
        if not mafiaUI then return nil end

        local levelBadge = SafeIndex(mafiaUI, "Root", "TopBar", "AvatarCard", "AvatarCluster", "AvatarFrame", "LevelBadge")
        if not levelBadge then
            levelBadge = FindDescendantByName(mafiaUI, "LevelBadge")
            if not levelBadge then return nil end
        end

        local allDescendants = levelBadge:GetDescendants()

        local okSelf, selfText = pcall(function() return levelBadge.Text end)
        if okSelf and selfText then
            local num = tostring(selfText):match("^%s*(%d+)%s*$")
            if num then return tonumber(num) end
        end

        for _, desc in ipairs(allDescendants) do
            local ok, txt = pcall(function() return desc.Text end)
            if ok and txt then
                local num = tostring(txt):match("^%s*(%d+)%s*$")
                if num then return tonumber(num) end
            end
        end

        return nil
    end

    -- Generic function untuk baca bar format "X/Y" (dipakai untuk Stamina & Health)
    -- Return current value (angka depan slash), ignore max value (angka belakang)
    local function ReadBarValue(barName, debugMode)
        local debugLog = {}

        local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
        if not playerGui then
            table.insert(debugLog, "PlayerGui: NOT FOUND")
            if debugMode then return nil, debugLog end
            return nil
        end
        table.insert(debugLog, "PlayerGui: OK")

        local mafiaUI = playerGui:FindFirstChild("MafiaWarsUI")
        if not mafiaUI then
            table.insert(debugLog, "MafiaWarsUI: NOT FOUND")
            if debugMode then return nil, debugLog end
            return nil
        end
        table.insert(debugLog, "MafiaWarsUI: OK")

        local barValue = SafeIndex(mafiaUI, "Root", "TopBar", "BarsCluster", barName, "Value")

        if barValue then
            table.insert(debugLog, barName .. ".Value (exact path): OK")
        else
            table.insert(debugLog, barName .. ".Value (exact path): FAILED, trying fallback search...")
            local barRoot = FindDescendantByName(mafiaUI, barName)
            if barRoot then
                barValue = barRoot:FindFirstChild("Value") or barRoot
                table.insert(debugLog, barName .. " (fallback search): OK")
            else
                table.insert(debugLog, barName .. ": NOT FOUND")
                if debugMode then return nil, debugLog end
                return nil
            end
        end

        local candidates = {}

        local okSelf, selfText = pcall(function() return barValue.Text end)
        if okSelf and selfText then
            local currentStr, maxStr = tostring(selfText):match("^%s*(%d+)%s*/%s*(%d+)%s*$")
            if currentStr then
                table.insert(candidates, {name = "Value itself", text = selfText, current = tonumber(currentStr), max = tonumber(maxStr)})
            end
        end

        local allDescendants = barValue:GetDescendants()
        for _, desc in ipairs(allDescendants) do
            local ok, txt = pcall(function() return desc.Text end)
            if ok and txt then
                local currentStr, maxStr = tostring(txt):match("^%s*(%d+)%s*/%s*(%d+)%s*$")
                if currentStr then
                    table.insert(candidates, {name = desc.Name, text = txt, current = tonumber(currentStr), max = tonumber(maxStr)})
                end
            end
        end

        table.insert(debugLog, "Total 'X/Y' format candidates found: " .. #candidates)
        for _, cand in ipairs(candidates) do
            table.insert(debugLog, "  Candidate -> Name: " .. cand.name .. " | Text: '" .. tostring(cand.text) .. "' | Current: " .. cand.current .. " | Max: " .. cand.max)
        end

        if #candidates > 0 then
            local chosen = candidates[1]
            table.insert(debugLog, "Chosen Current Value: " .. chosen.current .. " (Max: " .. chosen.max .. ", from " .. chosen.name .. ")")
            if debugMode then return chosen.current, debugLog end
            return chosen.current
        end

        table.insert(debugLog, "No 'X/Y' format text found!")
        if debugMode then return nil, debugLog end
        return nil
    end

    local function GetMyStamina(debugMode)
        return ReadBarValue("StaminaBar", debugMode)
    end

    local function GetMyHealth(debugMode)
        return ReadBarValue("HealthBar", debugMode)
    end

    -- Ambil hit list dari server (pakai JOB_HASH sebagai session id)
    local function GetHitList(forceRefresh)
        if not GetHitListEvent then return {} end
        local ok, result = pcall(function()
            return table.pack(GetHitListEvent:InvokeServer(JOB_HASH, forceRefresh or false))
        end)
        if ok and result[1] and result[1].ok and result[1].list then
            return result[1].list
        end
        return {}
    end

    -- Serang target (pakai JOB_HASH sebagai session id)
    -- Return: invokeSuccess (boolean), battleResult (table lengkap termasuk ok, won, msg, dll)
    local function AttackPlayer(targetUserId)
        if not AttackEvent then return false, nil end
        local ok, result = pcall(function()
            return table.pack(AttackEvent:InvokeServer(JOB_HASH, targetUserId))
        end)
        if ok and result[1] then
            return true, result[1]
        end
        return false, nil
    end

    -- Cek apakah battleResult menunjukkan status hospitalized
    local function IsHospitalized(battleResult)
        if not battleResult then return false end
        if battleResult.ok == false and battleResult.msg then
            local msgLower = tostring(battleResult.msg):lower()
            if msgLower:find("hospitalized") then
                return true
            end
        end
        return false
    end

    -- Cari target valid berdasarkan aturan level:
    -- 1. Kalau target level <= level kita -> SELALU VALID, tanpa batas gap
    -- 2. Kalau target level > level kita -> VALID hanya jika selisih <= MAX_LEVEL_GAP_ABOVE (fix = 1)
    local function FindValidTarget(list, myLevel)
        local bestTarget = nil

        for _, target in ipairs(list) do
            if target.level then
                local levelDiff = target.level - myLevel
                local isValidLevel = false

                if levelDiff <= 0 then
                    isValidLevel = true
                elseif levelDiff > 0 and levelDiff <= MAX_LEVEL_GAP_ABOVE then
                    isValidLevel = true
                end

                if isValidLevel then
                    if not target.shielded then
                        if not target.stamina or target.stamina > 0 then
                            if not bestTarget or target.level > bestTarget.level then
                                bestTarget = target
                            end
                        end
                    end
                end
            end
        end

        return bestTarget
    end

    -- Format hasil battle report jadi string yang enak dibaca
    local function FormatBattleReport(battleResult)
        if not battleResult then return "Tidak ada data hasil pertarungan." end

        if battleResult.ok == false then
            return "GAGAL: " .. tostring(battleResult.msg or "Unknown error")
        end

        local status = battleResult.won and "MENANG" or "KALAH"
        local lines = {
            status .. " vs " .. tostring(battleResult.targetName) .. " (Lv." .. tostring(battleResult.targetLevel) .. ")",
            "DMG Dealt: " .. tostring(battleResult.dmgDealt) .. " | DMG Taken: " .. tostring(battleResult.dmgTaken),
            "XP: " .. tostring(battleResult.xp or battleResult.xpEstimate),
            "Respect: " .. tostring(battleResult.respectEstimate or battleResult.respect),
            "Cash: " .. tostring(battleResult.cashEstimate or battleResult.stolen),
            "Stamina Cost: " .. tostring(battleResult.staminaCost),
        }
        if battleResult.knockout then
            table.insert(lines, "KNOCKOUT!")
        end
        return table.concat(lines, "\n")
    end

    local AutoAttackEnabled = false
    local WasWaitingForStamina = false
    local WasWaitingForHealth = false

    local function AutoAttackLoop()
        local currentTarget = nil
        local winStreak = 0

        while AutoAttackEnabled do
            -- 1. Cek Health dulu (prioritas paling atas, kalau hospitalized semua harus berhenti)
            local myHealth = GetMyHealth(false)

            if myHealth ~= nil and myHealth < MIN_HEALTH_TO_RESUME then
                if not WasWaitingForHealth then
                    LunoLibrary:Notify({
                        Title = "Auto Attack",
                        Content = "Health rendah (" .. tostring(myHealth) .. "), menunggu regen ke atas " .. MIN_HEALTH_TO_RESUME .. "...",
                        Duration = 3
                    })
                    WasWaitingForHealth = true
                end
                task.wait(ATTACK_DELAY)
                continue
            else
                if WasWaitingForHealth then
                    LunoLibrary:Notify({
                        Title = "Auto Attack",
                        Content = "Health sudah pulih! Melanjutkan serangan.",
                        Duration = 2
                    })
                    WasWaitingForHealth = false
                end
            end

            -- 2. Cek Stamina
            local myStamina = GetMyStamina(false)

            if myStamina ~= nil and myStamina <= 0 then
                if not WasWaitingForStamina then
                    LunoLibrary:Notify({
                        Title = "Auto Attack",
                        Content = "Stamina habis (0)! Menunggu stamina terisi...",
                        Duration = 3
                    })
                    WasWaitingForStamina = true
                end
                task.wait(ATTACK_DELAY)
                continue
            else
                if WasWaitingForStamina then
                    LunoLibrary:Notify({
                        Title = "Auto Attack",
                        Content = "Stamina terisi kembali! Melanjutkan serangan.",
                        Duration = 2
                    })
                    WasWaitingForStamina = false
                end
            end

            local myLevel = GetMyLevel()
            if not myLevel then
                task.wait(ATTACK_DELAY)
                continue
            end

            -- 3. Kalau belum ada target aktif, cari target baru
            if not currentTarget then
                local list = GetHitList(false)
                local target = FindValidTarget(list, myLevel)

                if not target then
                    list = GetHitList(true)
                    target = FindValidTarget(list, myLevel)
                end

                if target then
                    currentTarget = target
                    winStreak = 0
                end
            end

            -- 4. Kalau ada target, serang
            if currentTarget then
                local invokeSuccess, battleResult = AttackPlayer(currentTarget.userId)

                if invokeSuccess and battleResult then
                    if IsHospitalized(battleResult) then
                        LunoLibrary:Notify({
                            Title = "Auto Attack",
                            Content = "Kamu dihospitalisasi! " .. tostring(battleResult.msg),
                            Duration = 3
                        })
                        -- Jangan reset currentTarget, biar lanjut nyerang target yang sama setelah heal
                        -- Health check di iterasi berikutnya akan menahan loop sampai pulih
                    elseif battleResult.ok == false then
                        -- Error lain (target invalid, dsb) -> reset, cari target baru
                        LunoLibrary:Notify({
                            Title = "Auto Attack",
                            Content = "Gagal menyerang: " .. tostring(battleResult.msg or "Unknown error"),
                            Duration = 3
                        })
                        currentTarget = nil
                        winStreak = 0
                    else
                        -- ok == true, cek won/lose
                        LunoLibrary:Notify({
                            Title = "Auto Attack",
                            Content = FormatBattleReport(battleResult),
                            Duration = 3
                        })
                        print("[AUTO ATTACK] " .. FormatBattleReport(battleResult):gsub("\n", " | "))

                        if battleResult.won then
                            winStreak = winStreak + 1
                            if winStreak >= MAX_WIN_STREAK then
                                LunoLibrary:Notify({
                                    Title = "Auto Attack",
                                    Content = "Sudah " .. MAX_WIN_STREAK .. "x menang vs " .. tostring(currentTarget.name) .. ", mencari lawan baru...",
                                    Duration = 3
                                })
                                currentTarget = nil
                                winStreak = 0
                            end
                            -- kalau belum capai 5x, currentTarget tetap sama -> loop berikutnya serang lagi
                        else
                            -- kalah -> cari lawan baru
                            currentTarget = nil
                            winStreak = 0
                        end
                    end
                else
                    -- Invoke gagal total (network error dll)
                    currentTarget = nil
                    winStreak = 0
                end
            else
                LunoLibrary:Notify({
                    Title = "Auto Attack",
                    Content = "Tidak ada target valid, menunggu...",
                    Duration = 2
                })
            end

            task.wait(ATTACK_DELAY)
        end

        WasWaitingForStamina = false
        WasWaitingForHealth = false
    end

    FightTab:CreateSection("Auto Attack")

    FightTab:CreateToggle({
        Title = "Auto Attack (Smart Level + Stamina + Health + Repeat 5x)",
        Default = false,
        Flag = "AutoAttackLowerLevel",
        Callback = function(State)
            AutoAttackEnabled = State
            if State then
                task.spawn(AutoAttackLoop)
            end
        end
    })

    FightTab:CreateButton({
        Title = "Test Attack (Manual Trigger Sekali Jalan)",
        Callback = function()
            local myHealth = GetMyHealth(false)
            if myHealth ~= nil and myHealth < MIN_HEALTH_TO_RESUME then
                LunoLibrary:Notify({
                    Title = "Test Attack",
                    Content = "Health kamu rendah (" .. tostring(myHealth) .. "), tunggu regen dulu!",
                    Duration = 3
                })
                return
            end

            local myStamina = GetMyStamina(false)
            if myStamina ~= nil and myStamina <= 0 then
                LunoLibrary:Notify({
                    Title = "Test Attack",
                    Content = "Stamina kamu 0! Tidak bisa menyerang sekarang.",
                    Duration = 3
                })
                return
            end

            local myLevel = GetMyLevel()
            if not myLevel then
                LunoLibrary:Notify({
                    Title = "Test Attack",
                    Content = "Gagal! Level kamu tidak terdeteksi.",
                    Duration = 3
                })
                return
            end

            LunoLibrary:Notify({
                Title = "Test Attack",
                Content = "Level: " .. tostring(myLevel) .. " | Stamina: " .. tostring(myStamina) .. " | Health: " .. tostring(myHealth) .. " | Mengambil hit list...",
                Duration = 2
            })

            local list = GetHitList(false)
            local target = FindValidTarget(list, myLevel)

            if not target then
                LunoLibrary:Notify({
                    Title = "Test Attack",
                    Content = "Tidak ada target valid, mencoba force refresh...",
                    Duration = 2
                })
                list = GetHitList(true)
                target = FindValidTarget(list, myLevel)
            end

            if not target then
                LunoLibrary:Notify({
                    Title = "Test Attack",
                    Content = "Tetap tidak ada target valid setelah refresh!",
                    Duration = 3
                })
                print("[TEST ATTACK] Tidak ada target. Total list: " .. #list)
                for _, t in ipairs(list) do
                    print("  -> " .. tostring(t.name) .. " | Lv." .. tostring(t.level) .. " | Shielded: " .. tostring(t.shielded) .. " | Stamina: " .. tostring(t.stamina))
                end
                return
            end

            print("[TEST ATTACK] Target ditemukan: " .. target.name .. " (Lv." .. target.level .. ", userId: " .. target.userId .. ")")

            local invokeSuccess, battleResult = AttackPlayer(target.userId)

            if invokeSuccess and battleResult then
                LunoLibrary:Notify({
                    Title = "Test Attack Result",
                    Content = FormatBattleReport(battleResult),
                    Duration = 5
                })
                print("========== TEST ATTACK RESULT ==========")
                print(FormatBattleReport(battleResult))
                print("=========================================")
            else
                LunoLibrary:Notify({
                    Title = "Test Attack Result",
                    Content = "GAGAL menyerang " .. target.name .. " (Invoke error atau server menolak)",
                    Duration = 4
                })
            end
        end
    })

    FightTab:CreateSection("Debug")

    FightTab:CreateButton({
        Title = "Debug Stamina Detection (Cek Console)",
        Callback = function()
            local stamina, log = GetMyStamina(true)
            print("========== LUNO STAMINA DEBUG ==========")
            for _, line in ipairs(log) do
                print(line)
            end
            print("=========================================")
            LunoLibrary:Notify({
                Title = "Debug Stamina",
                Content = stamina and ("Stamina saat ini: " .. tostring(stamina)) or "Gagal! Cek F9 Console untuk detail",
                Duration = 4
            })
        end
    })

    FightTab:CreateButton({
        Title = "Debug Health Detection (Cek Console)",
        Callback = function()
            local health, log = GetMyHealth(true)
            print("========== LUNO HEALTH DEBUG ==========")
            for _, line in ipairs(log) do
                print(line)
            end
            print("========================================")
            LunoLibrary:Notify({
                Title = "Debug Health",
                Content = health and ("Health saat ini: " .. tostring(health)) or "Gagal! Cek F9 Console untuk detail",
                Duration = 4
            })
        end
    })

    FightTab:CreateSection("Bosses")

    FightTab:CreateButton({
        Title = "Auto Boss (Coming Soon)",
        Callback = function()
            LunoLibrary:Notify({
                Title = "Bosses",
                Content = "Fitur Auto Boss belum tersedia.",
                Duration = 3
            })
        end
    })
end

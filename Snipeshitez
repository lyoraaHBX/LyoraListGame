local MaxOperationSlots = 1

local OperationSlotState = {}
for i = 1, 4 do
    OperationSlotState[i] = {
        AutoEnabled = false,
        Running = false,
        OpId = OPERATIONS[1].id,
        ToggleRef = nil,

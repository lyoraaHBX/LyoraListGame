    OperationSlotState[i] = {
        AutoEnabled = false,
        Running = false,
        OpId = OPERATIONS[1].id,
        ToggleRef = nil,
    }
end

-- ===== PARSER WAKTU DARI UI (SUPPORT BANYAK FORMAT) =====
local function ParseOperationTimeLeft(rawText)
    if not rawText then return nil end
    local text = tostring(rawText):lower()

    if string.find(text, "ready") or string.find(text, "collect") or string.find(text, "claim") or string.find(text, "complete") or string.find(text, "done") then
        return 0
    end

    local h, m, s = string.match(text, "(%d+):(%d+):(%d+)")
    if h and m and s then
        return tonumber(h) * 3600 + tonumber(m) * 60 + tonumber(s)
    end

    local m2, s2 = string.match(text, "(%d+):(%d+)")
    if m2 and s2 then
        return tonumber(m2) * 60 + tonumber(s2)
    end

    local hh, mm = string.match(text, "(%d+)h%s*(%d+)m")
    if hh and mm then
        return tonumber(hh) * 3600 + tonumber(mm) * 60
    end

    local mmOnly = string.match(text, "(%d+)m")
    if mmOnly then
        return tonumber(mmOnly) * 60
    end

    return nil
end

-- ===== BACA NODE PROGRESS UNTUK SLOT TERTENTU (DINAMIS 1-4) =====
local function GetSlotProgressNode(slotIndex)
    return SafeFindPath({
        "PlayerGui", "MafiaWarsUI", "Root", "Content",
        "OpsPanel", "SlotRow", "Slot" .. slotIndex, "Progress", "Value"
    })
end

-- ===== FUNGSI UTAMA GUARD: DAPATKAN SISA WAKTU SLOT =====
local function GetSlotTimeLeft(slotIndex)
    local node = GetSlotProgressNode(slotIndex)
    if not node then
        return nil, "NO_NODE"
    end

    local rawText = GetRawTextFromNode(node)
    if not rawText or rawText == "" or rawText == "N/A" then
        return nil, "NO_TEXT"
    end

    local seconds = ParseOperationTimeLeft(rawText)
    return seconds, rawText
end

local function TryStartOperation(opId)
    local success, result = pcall(function()
        return StartOperationRemote:InvokeServer(OPERATION_HASH, opId)
    end)
    if success and type(result) == "table" then
        return result.ok == true, result
    end
    return false, nil
end

local function TryCollectOperation(slotIndex)
    local success, result = pcall(function()
        return CollectOperationRemote:InvokeServer(OPERATION_HASH, slotIndex)
    end)
    if success and type(result) == "table" then
        return result.ok == true, result
    end
    return false, nil
end


-- [[ MAIN LOADER - CLEAN & OBFUSCATION FRIENDLY ]] --

local BASE_URL = "https://raw.githubusercontent.com/lyoraaHBX/Module-Lyora/refs/heads/main/"
local LIB_URL = "https://raw.githubusercontent.com/lyoraaHBX/LibraryLyora-X/refs/heads/main/Lyora%20X"

local function NoCacheUrl(url)
    return url .. "?t=" .. tostring(os.time()) .. tostring(math.random(1000, 9999))
end

local function LoadRemote(url)
    local ok, src = pcall(game.HttpGet, game, NoCacheUrl(url))
    if not ok then
        error("[Loader] Gagal fetch: " .. url .. " | " .. tostring(src))
    end

    local ok2, mod = pcall(loadstring(src))
    if not ok2 then
        error("[Loader] Gagal compile: " .. url .. " | " .. tostring(mod))
    end

    return mod
end

-- 1. Load Library UI
local LunoLibrary = LoadRemote(LIB_URL)

-- 2. Load Data Modules
local JobsData = LoadRemote(BASE_URL .. "JobsData.lua")
local OperationsData = LoadRemote(BASE_URL .. "OperationsData.lua")
local PropertiesData = LoadRemote(BASE_URL .. "PropertiesData.lua")
local ShopData = LoadRemote(BASE_URL .. "ShopData.lua")

-- 3. Load Shared Core
local SharedCore = LoadRemote(BASE_URL .. "SharedCore.lua")
local Context = SharedCore.Init(LunoLibrary)

-- 4. Load & Init tiap fitur sebagai module terpisah
local FeatureModules = {
    { url = BASE_URL .. "JobModule.lua",         args = { JobsData.JOBS } },
    { url = BASE_URL .. "PropertyModule.lua",    args = { PropertiesData.PROPERTIES } },
    { url = BASE_URL .. "AllocationModule.lua",  args = {} },
    { url = BASE_URL .. "DailyRewardModule.lua", args = {} },
    { url = BASE_URL .. "TaskModule.lua",        args = {} },
    { url = BASE_URL .. "OperationModule.lua",   args = { OperationsData.OPERATIONS } },
}

for i, feature in ipairs(FeatureModules) do
    local ok, mod = pcall(LoadRemote, feature.url)
    if ok and mod and mod.Init then
        print("[Loader] Loading order #" .. i .. ": " .. feature.url)
        local initOk, initErr = pcall(mod.Init, Context, table.unpack(feature.args))
        if not initOk then
            warn("[FeatureInit Error] " .. feature.url .. ": " .. tostring(initErr))
        end
    else
        warn("[FeatureLoad Error] " .. feature.url .. ": " .. tostring(mod))
    end
end

--======================================================================
-- [[ BANK & SHOP - INLINE (DEBUG MODE) ]]
-- FIX: Hook SEMPIT hanya ke GetHitList.InvokeServer (BUKAN __namecall global)
-- supaya tidak mengganggu method call lain yang dipakai UI Library.
--======================================================================
do
    local Players = game:GetService("Players")
    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local LocalPlayer = Players.LocalPlayer

    local SHOP = (ShopData and ShopData.SHOP) or {}

    print("[BankShop][Debug] Mulai inisialisasi Bank & Shop inline...")
    print("[BankShop][Debug] Jumlah item SHOP terload: " .. #SHOP)

    if type(LunoLibrary.CreateTab) ~= "function" then
        warn("[BankShop][Debug] LunoLibrary:CreateTab tidak ditemukan!")
        return
    end

    local ok_tab, Tab = pcall(function()
        return LunoLibrary:CreateTab("Bank & Shop")
    end)

    if not ok_tab or not Tab then
        warn("[BankShop][Debug] Gagal buat Tab 'Bank & Shop': " .. tostring(Tab))
        return
    end
    print("[BankShop][Debug] Tab 'Bank & Shop' berhasil dibuat.")

    local function Notify(title, content, duration)
        print(("[BankShop][Notify] %s: %s"):format(title, tostring(content)))
        pcall(function()
            LunoLibrary:Notify({ Title = title, Content = content, Duration = duration or 3 })
        end)
    end

    -----------------------------------------------------------------
    -- Remotes
    -----------------------------------------------------------------
    local ok_remotes, DepositEvent, BuyShopEvent, GetHitListEvent = pcall(function()
        local MWFolder = ReplicatedStorage:WaitForChild("MW", 10)
        local RemotesFolder = MWFolder:WaitForChild("Remotes", 10)
        local dep = RemotesFolder:WaitForChild("Deposit", 10)
        local buy = RemotesFolder:WaitForChild("BuyShopItem", 10)
        local hitlist = RemotesFolder:FindFirstChild("GetHitList")
        return dep, buy, hitlist
    end)

    if not ok_remotes then
        warn("[BankShop][Debug] Gagal ambil remotes: " .. tostring(DepositEvent))
        return
    end
    print("[BankShop][Debug] Remotes Deposit & BuyShopItem berhasil diambil.")

    -----------------------------------------------------------------
    -- ============================================================
    -- AUTO-CAPTURE CHARACTER ID (TARGETED HOOK - AMAN UNTUK UI)
    -- ============================================================
    -- Hanya hook InvokeServer milik remote "GetHitList" saja,
    -- BUKAN __namecall global. Ini jauh lebih aman karena tidak
    -- menyentuh method call lain (TweenService, Instance.new,
    -- drag/resize UI, dll) sehingga UI tidak akan rusak/gagal load.
    -----------------------------------------------------------------
    local CachedCharId = nil

    local function IsLikelyCharId(str)
        if type(str) ~= "string" then return false end
        if #str ~= 32 then return false end
        return str:match("^%x+$") ~= nil
    end

    local HookSuccess = false

    if GetHitListEvent then
        local ok_hook = pcall(function()
            local OldInvokeServer
            OldInvokeServer = hookfunction(GetHitListEvent.InvokeServer, function(self, ...)
                local args = {...}

                if not CachedCharId then
                    for _, arg in ipairs(args) do
                        if IsLikelyCharId(arg) then
                            CachedCharId = arg
                            print("[BankShop][Hook] Character ID tertangkap dari GetHitList: " .. arg)
                            break
                        end
                    end
                end

                return OldInvokeServer(self, ...)
            end)
        end)

        HookSuccess = ok_hook
        if ok_hook then
            print("[BankShop][Debug] Hook GetHitList.InvokeServer berhasil dipasang.")
        else
            warn("[BankShop][Debug] hookfunction gagal (executor mungkin tidak support). Fallback ke deteksi manual.")
        end
    else
        warn("[BankShop][Debug] Remote 'GetHitList' tidak ditemukan di MW.Remotes! Skip hook, pakai fallback.")
    end

    -----------------------------------------------------------------
    -- Fallback tambahan kalau hook tidak berhasil / belum ke-trigger
    -----------------------------------------------------------------
    local function TryFallbackDetection()
        if CachedCharId then return CachedCharId end

        local ok, id = pcall(function()
            return LocalPlayer:GetAttribute("ActiveCharacterId")
                or LocalPlayer:GetAttribute("CharacterId")
                or LocalPlayer:GetAttribute("CharId")
                or LocalPlayer:GetAttribute("SelectedCharacterId")
        end)
        if ok and id and id ~= "" then
            print("[BankShop][Debug] Fallback: CharacterId dari Player Attribute: " .. tostring(id))
            CachedCharId = tostring(id)
            return CachedCharId
        end

        local searchLocations = { LocalPlayer, LocalPlayer:FindFirstChild("PlayerGui") }
        local possibleNames = { "CharacterId", "ActiveCharacterId", "SelectedCharacterId", "CharId", "ActiveCharacter" }

        for _, location in ipairs(searchLocations) do
            if location then
                for _, name in ipairs(possibleNames) do
                    local found = location:FindFirstChild(name, true)
                    if found and (found:IsA("StringValue") or found:IsA("ObjectValue")) then
                        local val = found.Value
                        if val and tostring(val) ~= "" then
                            print(("[BankShop][Debug] Fallback: CharacterId ditemukan di %s.%s = %s"):format(location.Name, found.Name, tostring(val)))
                            CachedCharId = tostring(val)
                            return CachedCharId
                        end
                    end
                end
            end
        end

        return nil
    end

    local function GetCharacterId()
        if CachedCharId then return CachedCharId end
        return TryFallbackDetection()
    end

    -----------------------------------------------------------------
    -- Trigger manual: paksa panggil GetHitList sendiri kalau perlu
    -- (opsional, kalau game tidak auto-invoke remote ini saat idle)
    -----------------------------------------------------------------
    Tab:CreateButton({
        Title = "Trigger Cari ID (Panggil GetHitList Manual)",
        Callback = function()
            if not GetHitListEvent then
                Notify("Debug", "Remote GetHitList tidak ditemukan di game ini.", 3)
                return
            end
            -- Panggil dengan ID kosong hanya untuk memancing hook menangkap
            -- ID asli kalau game auto-melengkapi/mengoreksi di response,
            -- ATAU untuk sekadar memastikan remote ini reachable.
            local ok, result = pcall(function()
                return GetHitListEvent:InvokeServer("", false)
            end)
            print("[BankShop][Debug] Manual trigger GetHitList result: " .. tostring(ok) .. " | " .. tostring(result))
            Notify("Debug", "Trigger terkirim, cek console untuk hasil.", 3)
        end,
    })

    -----------------------------------------------------------------
    -- SECTION: BANK
    -----------------------------------------------------------------
    Tab:CreateSection("Auto Deposit Bank")

    local DepositAmount = 1000
    Tab:CreateInput({
        Title = "Jumlah Deposit",
        Placeholder = "1000",
        Callback = function(text)
            local num = tonumber(text)
            if num and num > 0 then
                DepositAmount = math.floor(num)
                print("[BankShop][Debug] DepositAmount diset ke: " .. DepositAmount)
            else
                Notify("Bank", "Jumlah deposit tidak valid", 3)
            end
        end,
    })

    local DepositDelay = 1.5
    Tab:CreateSlider({
        Title = "Delay Antar Deposit",
        Min = 1,
        Max = 50,
        Default = 15,
        Suffix = " (x0.1 detik)",
        Flag = "BankDepositDelay",
        Callback = function(val)
            DepositDelay = val / 10
            print("[BankShop][Debug] DepositDelay diset ke: " .. DepositDelay)
        end,
    })

    local function DoDeposit()
        local charId = GetCharacterId()
        if not charId then
            Notify("Bank", "Character ID belum terdeteksi! Klik 'Trigger Cari ID' atau buka panel Bank/Shop di game dulu.", 5)
            return false
        end

        local ok, result = pcall(function()
            return table.pack(DepositEvent:InvokeServer(charId, DepositAmount))
        end)

        if not ok then
            warn("[BankShop][Debug] Error saat InvokeServer Deposit: " .. tostring(result))
            return false
        end

        if result and result[1] and result[1].ok then
            print(("[BankShop][Debug] Deposit sukses | fee=%s kept=%s"):format(
                tostring(result[1].fee), tostring(result[1].kept)
            ))
            return true
        end

        warn("[BankShop][Debug] Deposit gagal, response: " .. tostring(result and result[1]))
        return false
    end

    local AutoDepositEnabled = false

    Tab:CreateToggle({
        Title = "Auto Deposit (Loop Aman dengan Delay)",
        Default = false,
        Flag = "AutoDepositEnabled",
        Callback = function(value)
            AutoDepositEnabled = value
            if not value then
                Notify("Bank", "Auto Deposit dihentikan", 3)
                return
            end

            Notify("Bank", "Auto Deposit dimulai...", 3)

            task.spawn(function()
                while AutoDepositEnabled do
                    local success = DoDeposit()
                    task.wait(success and DepositDelay or (DepositDelay * 2))
                end
                print("[BankShop][Debug] Loop Auto Deposit berhenti.")
            end)
        end,
    })

    Tab:CreateButton({
        Title = "Deposit Sekali (untuk testing manual)",
        Callback = function()
            local success = DoDeposit()
            Notify("Bank", success and "Deposit berhasil" or "Deposit gagal", 3)
        end,
    })

    -----------------------------------------------------------------
    -- SECTION: SHOP
    -----------------------------------------------------------------
    Tab:CreateSection("Auto Buy Shop")

    local ItemOptions = {}
    for _, data in ipairs(SHOP) do
        table.insert(ItemOptions, data.item)
    end
    if #ItemOptions == 0 then ItemOptions = {"No Items"} end

    local SelectedItems = {}

    Tab:CreateDropdown({
        Title = "Pilih Item untuk Auto Buy",
        Options = ItemOptions,
        Multi = true,
        Default = {},
        Flag = "ShopSelectedItems",
        Callback = function(options)
            SelectedItems = options or {}
            print("[BankShop][Debug] SelectedItems: " .. table.concat(SelectedItems, ", "))
        end,
    })

    local BuyDelay = 0.5
    local AutoBuyEnabled = false

    local function BuyItem(itemId)
        local charId = GetCharacterId()
        if not charId then
            Notify("Shop", "Character ID belum terdeteksi!", 4)
            return false
        end

        local ok, result = pcall(function()
            return table.pack(BuyShopEvent:InvokeServer(charId, itemId, nil, nil))
        end)

        if not ok then
            warn("[BankShop][Debug] Error saat InvokeServer BuyShopItem: " .. tostring(result))
            return false
        end

        if result and result[1] and result[1].ok then
            print("[BankShop][Debug] Berhasil beli item: " .. itemId)
            return true
        end

        warn(("[BankShop][Debug] Gagal beli %s, response: %s"):format(itemId, tostring(result and result[1])))
        return false
    end

    local function TryBuySelected()
        if #SelectedItems == 0 then
            print("[BankShop][Debug] Tidak ada item terpilih.")
            return
        end

        task.spawn(function()
            print("[BankShop][Debug] Mulai proses beli " .. #SelectedItems .. " item terpilih...")
            for _, itemId in ipairs(SelectedItems) do
                local success = BuyItem(itemId)
                if success then
                    Notify("Shop", "Berhasil beli: " .. itemId, 3)
                end
                task.wait(BuyDelay)
            end
        end)
    end

    Tab:CreateToggle({
        Title = "Auto Buy saat Stock Baru",
        Default = false,
        Flag = "AutoBuyEnabled",
        Callback = function(value)
            AutoBuyEnabled = value
            if value then
                Notify("Shop", "Auto Buy aktif, sinkron dengan restock timer...", 3)
                TryBuySelected()
            else
                Notify("Shop", "Auto Buy dihentikan", 3)
            end
        end,
    })

    Tab:CreateButton({
        Title = "Buy Sekali (untuk testing manual)",
        Callback = function()
            TryBuySelected()
        end,
    })

    Tab:CreateButton({
        Title = "Cek Status Character ID (Debug)",
        Callback = function()
            local id = GetCharacterId()
            if id then
                Notify("Debug", "Character ID aktif: " .. id, 5)
            else
                Notify("Debug", "Character ID BELUM ketemu.", 5)
            end
        end,
    })

    -----------------------------------------------------------------
    -- Monitor RestockText
    -----------------------------------------------------------------
    local function GetRestockLabel()
        local ok, label = pcall(function()
            return LocalPlayer.PlayerGui.MafiaWarsUI.Root.Content.ShopPanel.RestockText
        end)
        if ok then return label end
        return nil
    end

    local function ParseRemainingSeconds(text)
        local m, s = text:match("(%d+):(%d+)")
        if m and s then
            return tonumber(m) * 60 + tonumber(s)
        end
        return nil
    end

    task.spawn(function()
        local lastRemaining = nil
        print("[BankShop][Debug] Thread monitor RestockText dimulai.")

        while true do
            local label = GetRestockLabel()
            if label then
                local ok, text = pcall(function() return label.ContentText end)
                if ok and text then
                    local remaining = ParseRemainingSeconds(text)
                    if remaining then
                        if lastRemaining and remaining > lastRemaining + 60 then
                            print("[BankShop][Debug] Restock terdeteksi!")
                            if AutoBuyEnabled then
                                TryBuySelected()
                            end
                        end
                        lastRemaining = remaining
                    end
                end
            end
            task.wait(1)
        end
    end)

    Notify("Bank & Shop", "Module dimuat! " .. (HookSuccess and "Hook GetHitList aktif." or "Hook gagal, pakai fallback."), 5)
    print("[BankShop][Debug] Inisialisasi Bank & Shop inline selesai.")
end

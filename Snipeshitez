-- Function to get session ID from GetHitList
local function getSessionId()
    print("🔄 Fetching session ID from GetHitList...")
    
    -- Try different methods to get session ID
    local methods = {
        -- Method 1: Call with empty/nil args
        function()
            return Remotes.GetHitList:InvokeServer()
        end,
        -- Method 2: Call with false
        function()
            return Remotes.GetHitList:InvokeServer(false)
        end,
        -- Method 3: Call with empty string
        function()
            return Remotes.GetHitList:InvokeServer("")
        end,
    }
    
    for i, method in ipairs(methods) do
        local success, result = pcall(method)
        
        if success and result then
            print("📦 Raw result:", result)
            
            -- Check if result has the expected structure
            if type(result) == "table" and result.ok then
                print("✅ Valid response received!")
                
                -- Try to extract session ID
                -- Session ID might be in different places
                if result.sessionId then
                    sessionId = result.sessionId
                    print("✅ Session ID found:", sessionId)
                    hitListCache = result.list
                    isInitialized = true
                    return sessionId, result.list
                end
                
                -- Sometimes session ID is the first parameter we send back
                -- Let's try to use a generated one or extract from response
                sessionId = "auto_generated_" .. tostring(os.time())
                hitListCache = result.list
                isInitialized = true
                print("✅ Using generated session ID:", sessionId)
                return sessionId, result.list
            end
        else
            warn("❌ Method", i, "failed:", result)
        end
    end
    
    return nil, nil
end

-- Hook to intercept and learn session ID pattern
local originalGetHitList
local function hookGetHitList()
    originalGetHitList = hookfunction(Remotes.GetHitList.InvokeServer, function(...)
        local args = {...}
        print("🔍 GetHitList called with args:", table.concat(args, ", "))
        
        local result = originalGetHitList(...)
        
        if result and result.ok then
            print("✅ GetHitList success!")
            
            -- Store the session ID if it was passed
            if args[2] and type(args[2]) == "string" and args[2] ~= "" then
                sessionId = args[2]
                print("📌 Session ID captured:", sessionId)
            end
            
            hitListCache = result.list
            isInitialized = true
        end
        
        return result
    end)
end

-- Hook ScoutPlayer to bypass stamina
local originalScoutPlayer
local function hookScoutPlayer()
    originalScoutPlayer = hookfunction(Remotes.ScoutPlayer.InvokeServer, function(...)
        local args = {...}
        local targetUserId = args[2] or args[1]
        
        -- Check cache first
        if scoutCache[targetUserId] then
            print("📦 Using cached scout data for:", targetUserId)
            return scoutCache[targetUserId]
        end
        
        print("🔍 Scouting player:", targetUserId, "with session:", args[1])
        
        local result = originalScoutPlayer(...)
        
        if result and result.ok then
            scoutCache[targetUserId] = result
            print("✅ Scout successful and cached!")
        end
        
        return result
    end)
end

-- Initialize hooks
hookGetHitList()
hookScoutPlayer()

-- Function to initialize session
local function initializeSession()
    print("🔄 Initializing session...")
    
    local success, result = pcall(function()
        -- Call GetHitList without session ID to get one
        return Remotes.GetHitList:InvokeServer()
    end)
    
    if not success then
        -- Try with false parameter
        success, result = pcall(function()
            return Remotes.GetHitList:InvokeServer(false)
        end)
    end
    
    if success and result and result.ok then
        hitListCache = result.list
        isInitialized = true
        
        -- Session ID should be captured by hook
        if not sessionId then
            -- Generate a session ID if not captured
            sessionId = ""
        end
        
        print("✅ Session initialized! Found " .. #result.list .. " targets")
        return true, result.list
    else
        warn("❌ Failed to initialize session:", result)
        return false, nil
    end
end

-- Functions
local function getHitList()
    local success, result = pcall(function()
        if sessionId and sessionId ~= "" then
            return Remotes.GetHitList:InvokeServer(sessionId, false)
        else
            return Remotes.GetHitList:InvokeServer(false)
        end
    end)
    
    if success and result and result.ok then
        hitListCache = result.list
        return result.list
    end
    
    return hitListCache
end

local function getPlayerProfile(userId)
    if not isInitialized then
        warn("❌ Session not initialized!")
        return nil
    end
    
    local success, result = pcall(function()
        if sessionId and sessionId ~= "" then
            return Remotes.PlayerProfile:InvokeServer(sessionId, userId)
        else
            return Remotes.PlayerProfile:InvokeServer(userId)
        end
    end)
    
    if success and result and result.ok then
        return result.profile
    end
    return nil
end

local function scoutPlayer(userId)
    if not isInitialized then
        warn("❌ Session not initialized!")
        return nil
    end
    
    local success, result = pcall(function()
        if sessionId and sessionId ~= "" then
            return Remotes.ScoutPlayer:InvokeServer(sessionId, userId)
        else
            return Remotes.ScoutPlayer:InvokeServer(userId)
        end
    end)
    
    if success and result and result.ok then
        return result
    end
    return nil
end


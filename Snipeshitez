-- Display hit list
local function displayHitList()
    if not isInitialized then
        updateStatus("⏳ Initializing session...", Color3.fromRGB(255, 200, 100))
        local success = initializeSession()
        if not success then
            updateStatus("❌ Failed to initialize!", Color3.fromRGB(255, 100, 100))
            return
        end
        updateSessionInfo()
    end
    
    clearHitList()
    updateStatus("📜 Loading hit list...", Color3.fromRGB(255, 200, 100))
    
    local hitList = getHitList()
    
    if hitList then
        for i, target in ipairs(hitList) do
            createTargetCard(target, i)
        end
        
        RightPanel.CanvasSize = UDim2.new(0, 0, 0, ListLayout.AbsoluteContentSize.Y + 10)
        updateStatus(string.format("✅ Loaded %d targets", #hitList), Color3.fromRGB(100, 255, 100))
    else
        updateStatus("❌ Failed to load hit list!", Color3.fromRGB(255, 100, 100))
    end
end

-- Auto scout all
local autoScoutRunning = false
local function autoScoutAll()
    if not isInitialized then
        updateStatus("❌ Initialize session first!", Color3.fromRGB(255, 100, 100))
        return
    end
    
    if autoScoutRunning then
        updateStatus("⏸️ Auto scout already running!", Color3.fromRGB(255, 200, 100))
        return
    end
    
    autoScoutRunning = true
    updateStatus("🤖 Auto scouting...", Color3.fromRGB(100, 200, 255))
    
    task.spawn(function()
        local hitList = hitListCache or getHitList()
        if not hitList then
            updateStatus("❌ No hit list loaded!", Color3.fromRGB(255, 100, 100))
            autoScoutRunning = false
            return
        end
        
        local scouted = 0
        local total = 0
        
        for i, target in ipairs(hitList) do
            if not target.shielded and target.online then
                total = total + 1
                local scoutData = scoutPlayer(target.userId)
                if scoutData then
                    scouted = scouted + 1
                    print(string.format("✅ [%d/%d] %s - ATK:%d DEF:%d", 
                        i, #hitList, target.name, scoutData.atk, scoutData.def))
                end
                
                updateStatus(string.format("🤖 Scouting... [%d/%d]", i, #hitList), Color3.fromRGB(100, 200, 255))
                wait(0.5)
            end
        end
        
        updateStatus(string.format("✅ Done! %d/%d scouted", scouted, total), Color3.fromRGB(100, 255, 100))
        autoScoutRunning = false
        
        wait(1)
        displayHitList()
    end)
end


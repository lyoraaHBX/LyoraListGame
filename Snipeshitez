-- =========================================================
-- FUNGSI DETEKSI LEVEL REAL-TIME MENGGUNAKAN CONTENTTEXT
-- =========================================================
local function GetRealTimeLevel()
    local level = 1
    pcall(function()
        local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
        if playerGui then
            local mafiaUI = playerGui:FindFirstChild("MafiaWarsUI")
            local levelBadge = mafiaUI and mafiaUI.Root.TopBar.AvatarCard.AvatarCluster.AvatarFrame:FindFirstChild("LevelBadge")
            
            if levelBadge then
                -- Membaca properti ContentText (jika kosong, fallback ke Text)
                local contentText = levelBadge.ContentText ~= "" and levelBadge.ContentText or levelBadge.Text
                local extractedNum = string.match(contentText, "%d+")
                if extractedNum then
                    level = tonumber(extractedNum)
                end
            end
        end
    end)
    return level
end

-- Fungsi Mengambil Job Tertinggi Berdasarkan Level Real-Time
local function GetHighestUnlockedJob()
    local currentLvl = GetRealTimeLevel()
    local highestJobId = "j_watch"
    local highestJobName = "Keep Watch on the Corner"
    
    for _, job in ipairs(JOBS) do
        if currentLvl >= job.level then
            highestJobId = job.id
            highestJobName = job.name
        else
            break
        end
    end
    return highestJobId, currentLvl, highestJobName
end


local function displayHitList()
    clearHitList()
    updateStatus("📜 Loading hit list...", Color3.fromRGB(255, 200, 100))
    
    local hitList = getHitList()
    
    if hitList then
        for i, target in ipairs(hitList) do
            createTargetCard(target, i)
        end
        
        RightPanel.CanvasSize = UDim2.new(0, 0, 0, ListLayout.AbsoluteContentSize.Y + 10)
        updateStatus(string.format("✅ Loaded %d targets", #hitList), Color3.fromRGB(100, 255, 100))
        updateStats()
    else
        updateStatus("❌ Failed to load hit list!", Color3.fromRGB(255, 100, 100))
    end
end

-- Auto scout all
local autoScoutRunning = false
local function autoScoutAll()
    if autoScoutRunning then
        updateStatus("⏸️ Auto scout already running!", Color3.fromRGB(255, 200, 100))
        return
    end
    
    autoScoutRunning = true
    updateStatus("🤖 Auto scouting...", Color3.fromRGB(100, 200, 255))
    
    task.spawn(function()
        local hitList = hitListCache or getHitList()
        if not hitList then
            updateStatus("❌ No hit list loaded!", Color3.fromRGB(255, 100, 100))
            autoScoutRunning = false
            return
        end
        
        local scouted = 0
        local total = 0
        local cached = 0
        
        for i, target in ipairs(hitList) do
            if not target.shielded and target.online then
                total = total + 1
                local wasCached = scoutCache[target.userId] ~= nil
                
                local scoutData = scoutPlayer(target.userId)
                if scoutData then
                    scouted = scouted + 1
                    if wasCached then
                        cached = cached + 1
                        print(string.format("📦 [%d/%d] %s - FREE (Cached)", i, #hitList, target.name))
                    else
                        print(string.format("✅ [%d/%d] %s - ATK:%d DEF:%d (1 Stamina)", 
                            i, #hitList, target.name, scoutData.atk, scoutData.def))
                    end
                end
                
                updateStatus(string.format("🤖 Scouting... [%d/%d]", i, #hitList), Color3.fromRGB(100, 200, 255))
                wait(0.5)
            end
        end
        
        updateStatus(string.format("✅ Done! %d scouted (%d cached, %d new)", 
            scouted, cached, scouted - cached), Color3.fromRGB(100, 255, 100))
        autoScoutRunning = false
        
        updateStats()
        wait(1)
        displayHitList()
    end)
end

-- Function to create button
local function createButton(text, position, callback)
    local Button = Instance.new("TextButton")
    Button.Size = UDim2.new(1, -20, 0, 35)
    Button.Position = position
    Button.BackgroundColor3 = Color3.fromRGB(50, 120, 255)
    Button.Text = text
    Button.Font = Enum.Font.GothamBold
    Button.TextSize = 14
    Button.TextColor3 = Color3.fromRGB(255, 255, 255)
    Button.Parent = LeftPanel
    
    local ButtonCorner = Instance.new("UICorner")
    ButtonCorner.CornerRadius = UDim.new(0, 6)
    ButtonCorner.Parent = Button
    
    Button.MouseEnter:Connect(function()
        TweenService:Create(Button, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(60, 140, 255)}):Play()
    end)
    
    Button.MouseLeave:Connect(function()
        TweenService:Create(Button, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(50, 120, 255)}):Play()
    end)
    
    Button.MouseButton1Click:Connect(callback)
    
    return Button
end


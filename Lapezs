local function updateStats()
    local cached = 0
    for _ in pairs(scoutCache) do
        cached = cached + 1
    end
    
    local saved = 0
    for _, count in pairs(scoutCallCount) do
        if count > 1 then
            saved = saved + (count - 1)
        end
    end
    
    StatsText.Text = string.format("📦 Cached: %d targets\n⚡ Stamina Saved: %d", cached, saved)
end


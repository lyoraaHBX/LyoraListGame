--[[
    Auto Scouting Script with UI
    Hook ScoutPlayer to prevent stamina cost
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local TweenService = game:GetService("TweenService")

-- Services
local Remotes = ReplicatedStorage.MW.Remotes

-- Cache
local scoutCache = {}
local hitListCache = nil
local profileCache = {}

-- Hook GetHitList
local originalGetHitList = Remotes.GetHitList.InvokeServer
Remotes.GetHitList.InvokeServer = function(...)
    local result = originalGetHitList(...)
    if result and result.ok then
        hitListCache = result.list
        print("✅ Hit list cached:", #result.list, "targets")
    end
    return result
end

-- Hook ScoutPlayer to prevent stamina usage
local originalScoutPlayer = Remotes.ScoutPlayer.InvokeServer
local scoutCallCount = {}

Remotes.ScoutPlayer.InvokeServer = function(self, userId)
    -- Check if we have cached data for this user
    if scoutCache[userId] then
        print("📦 Using cached scout data for UserID:", userId, "(No Stamina Used)")
        return scoutCache[userId]
    end
    
    -- Track call count
    scoutCallCount[userId] = (scoutCallCount[userId] or 0) + 1
    
    print("🔍 First time scouting UserID:", userId, "(Will use 1 stamina)")
    
    -- Call original function (this will cost stamina on first call)
    local result = originalScoutPlayer(self, userId)
    
    -- Cache the result for future calls
    if result and result.ok then
        scoutCache[userId] = result
        print("✅ Scout data cached! Future scouts will be FREE")
    end
    
    return result
end

-- Hook PlayerProfile
local originalPlayerProfile = Remotes.PlayerProfile.InvokeServer
Remotes.PlayerProfile.InvokeServer = function(self, userId)
    if profileCache[userId] then
        print("📦 Using cached profile for UserID:", userId)
        return profileCache[userId]
    end
    
    local result = originalPlayerProfile(self, userId)
    
    if result and result.ok then
        profileCache[userId] = result
        print("✅ Profile cached for UserID:", userId)
    end
    
    return result
end

-- Functions
local function getHitList()
    local success, result = pcall(function()
        return Remotes.GetHitList:InvokeServer()
    end)
    
    if success and result and result.ok then
        return result.list
    end
    
    return hitListCache
end

local function getPlayerProfile(userId)
    local success, result = pcall(function()
        return Remotes.PlayerProfile:InvokeServer(userId)
    end)
    
    if success and result and result.ok then
        return result.profile
    end
    return nil
end

local function scoutPlayer(userId)
    local success, result = pcall(function()
        return Remotes.ScoutPlayer:InvokeServer(userId)
    end)
    
    if success and result and result.ok then
        return result
    end
    return nil
end


local PriorityChoices = { "Highest Luck", "Highest Rarity", "Nearest", "Farthest" }

local function collectedEgg(name)
	local attr = localPlayer:GetAttribute("CollectedEggs")
	return type(attr) == "string" and attr ~= "" and string.find(attr, tostring(name) .. ",", 1, true) ~= nil
end

local function autoEggs(origin)
	local list = {}
	local top = Util.PlotTop()
	local now = os.clock()

	for _, cfg in ipairs(ActiveEggs:GetChildren()) do
		local eggName = cfg:GetAttribute("Egg")
		local pos = cfg:GetAttribute("Position")
		local privateTo = cfg:GetAttribute("PrivateTo")
		local ban = blacklist[cfg.Name]
		local ok = type(eggName) == "string" and typeof(pos) == "Vector3" and (privateTo == nil or privateTo == localPlayer.UserId)
		if ok then
			ok = not (ban and ban > now)
		end
		if ok and not collectedEgg(eggName) then
			local rank = Util.EggRank(eggName)
			if rank >= minEggRank and (next(targetEggs) == nil or targetEggs[eggName]) then
				if (top and Util.TravelTime(pos, top) or 0) < 20 - TRAVEL_MARGIN - 2 then
					table.insert(list, {
						Config = cfg,
						Name = eggName,
						Position = pos,
						Rank = rank,
						Luck = Util.EggLuck(eggName) * (tonumber(cfg:GetAttribute("Weight")) or 1),
						Distance = (pos - origin).Magnitude,
					})
				end
			end
		end
	end

	table.sort(list, function(a, b)
		if collectPriority == "Nearest" then
			return a.Distance < b.Distance
		end
		if collectPriority == "Farthest" then
			return a.Distance > b.Distance
		end
		if collectPriority == "Highest Rarity" then
			if a.Rank ~= b.Rank then
				return a.Rank > b.Rank
			end
			if a.Luck ~= b.Luck then
				return a.Luck > b.Luck
			end
			return a.Distance < b.Distance
		end
		if a.Luck ~= b.Luck then
			return a.Luck > b.Luck
		end
		return a.Distance < b.Distance
	end)

	return list
end


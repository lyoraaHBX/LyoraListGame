-- Noclip + terbang (tween CFrame)
local noclipSaved = {}

function Util.SetNoclip(state)
	local char = localPlayer.Character
	if not char then
		return
	end
	for _, d in ipairs(char:GetDescendants()) do
		if d:IsA("BasePart") then
			if state then
				if noclipSaved[d] == nil then
					noclipSaved[d] = d.CanCollide
				end
				d.CanCollide = false
			elseif noclipSaved[d] ~= nil then
				d.CanCollide = noclipSaved[d]
			end
		end
	end
	if not state then
		table.clear(noclipSaved)
	end
end


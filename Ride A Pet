-- lepas telur dari basket lalu ambil lagi dekat base (supaya tidak expired saat terbang jauh)
local function repickNearBase(base, top, cancel)
	local root = Util.Root()
	local basket = localPlayer:FindFirstChild("Basket")
	if not root or not basket then
		return
	end
	local lp = base.CFrame:PointToObjectSpace(root.Position)
	local flat = Vector3.new(lp.X, 0, lp.Z)
	if flat.Magnitude < 1 then
		flat = Vector3.new(0, 0, 1)
	end
	local hx, hz = base.Size.X / 2, base.Size.Z / 2
	local unit = flat.Unit
	local scaled = unit / math.max(math.abs(unit.X) / (hx + 20), math.abs(unit.Z) / (hz + 20))
	local w = base.CFrame:PointToWorldSpace(Vector3.new(scaled.X, 0, scaled.Z))
	local hover = Vector3.new(w.X, top.Y + 4, w.Z)

	Util.FlyTo(hover, cancel, 4)
	local r = Util.Root()
	if not r or (r.Position - hover).Magnitude > 10 then
		return
	end

	Util.Status = "Re-picking eggs near base"
	local untilT = os.clock() + 0.3
	while os.clock() < untilT do
		local rr = Util.Root()
		if rr then
			pcall(function()
				rr.CFrame = CFrame.new(hover) * rr.CFrame.Rotation
				rr.AssemblyLinearVelocity = Vector3.zero
			end)
		end
		RunService.Heartbeat:Wait()
	end

	local known = {}
	for _, child in ipairs(ActiveEggs:GetChildren()) do
		known[child] = true
	end

	local names = {}
	for _, child in ipairs(basket:GetChildren()) do
		local e = child:GetAttribute("Egg")
		if type(e) == "string" then
			table.insert(names, e)
		end
	end

	local dropped = {}
	Farm.Relaying = true
	for _, e in ipairs(names) do
		Util.Fire("BasketDrop", e)
	end

	local deadline = os.clock() + 3
	while #dropped < #names and os.clock() < deadline do
		for _, child in ipairs(ActiveEggs:GetChildren()) do
			if not known[child] and child:GetAttribute("OriginPosition") ~= nil and typeof(child:GetAttribute("Position")) == "Vector3" then
				known[child] = true
				table.insert(dropped, child)
			end
		end
		RunService.Heartbeat:Wait()
	end

	for _, egg in ipairs(dropped) do
		local pos = egg:GetAttribute("Position")
		for _ = 1, 3 do
			if egg.Parent ~= nil then
				if typeof(pos) == "Vector3" then
					Util.FlyTo(pos + Vector3.new(0, 3, 0), nil, 5)
				end
				local before = Util.BasketCount()
				Farm.LastPickupAt = os.clock()
				Util.Fire("EggPickup", egg.Name)
				local t = os.clock() + 1.5
				while Util.BasketCount() == before and os.clock() < t do
					RunService.Heartbeat:Wait()
				end
				if not (before < Util.BasketCount()) then
					continue
				end
			end
			break
		end
		if egg.Parent ~= nil and not table.find(Farm.Manual, egg.Name) then
			table.insert(Farm.Manual, 1, egg.Name)
		end
	end

	Farm.Relaying = false
end

function Farm.Deliver(cancel)
	if Util.BasketCount() <= 0 then
		return true
	end
	local top = Util.PlotTop()
	local base = Util.PlotBase()
	if not top or not base then
		return false
	end

	Util.Status = "Bringing eggs home"
	local root = Util.Root()
	local pickupPos = Farm.PickupPos or (root and root.Position)
	if pickupPos and (pickupPos - top).Magnitude > FAR_DISTANCE then
		repickNearBase(base, top, cancel)
		Util.Status = "Bringing eggs home"
	end

	Util.FlyTo(top + Vector3.new(0, 4, 0), cancel, 4)
	local t = os.clock() + 3
	while Util.BasketCount() > 0 and os.clock() < t do
		RunService.Heartbeat:Wait()
	end

	if Util.BasketCount() == 0 then
		table.clear(Farm.Carried)
		Farm.PickupPos = nil
	end
	return Util.BasketCount() == 0
end

function Farm.CollectStep(shouldStop)
	if not Util.Root() then
		return false
	end
	local capacity = Util.BasketCapacity()
	local collectedAny = false

	while Util.BasketCount() < capacity do
		if shouldStop() then
			break
		end

		-- jangan ambil telur baru kalau telur di basket hampir pecah
		local deadline = Util.BasketDeadline()
		local top = Util.PlotTop()
		if deadline and top then
			local r = Util.Root()
			local remaining = deadline - workspace:GetServerTimeNow() - (r and Util.TravelTime(r.Position, top) or 0)
			if remaining < TRAVEL_MARGIN + 4 then
				break
			end
		end

		local root = Util.Root()
		if not root then
			break
		end

		local target = nextManualEgg()
		if not target and On("AutoCollectEggs") then
			for _, cand in ipairs(autoEggs(root.Position)) do
				if not table.find(Farm.Manual, cand.Config.Name) then
					target = cand
					break
				end
			end
		end

		if not target then
			if not collectedAny then
				Util.Status = "No egg matches the filters"
			end
			break
		end

		local uid = target.Config.Name
		Farm.Target = uid
		Farm.TargetManual = target.Manual == true
		Farm.Dropped = nil
		Util.Status = string.format("Collecting %s", target.Name)

		local reached = Util.FlyTo(target.Position + Vector3.new(0, 3, 0), function()
			return shouldStop() or target.Config.Parent == nil or Farm.Dropped == uid
		end, 6)

		if Farm.Dropped == uid then
			Farm.Target = nil
			Farm.Dropped = nil
			continue
		end

		if target.Config.Parent == nil and not reached then
			removeManual(uid)
			Farm.Target = nil
			continue
		elseif not reached then
			blacklist[uid] = os.clock() + 20
			removeManual(uid)
			Farm.Target = nil
			break
		end

		local before = Util.BasketCount()
		Farm.LastPickupAt = os.clock()
		if before == 0 then
			Farm.PickupPos = target.Position
		end

		Util.Fire("EggPickup", uid)
		local t = os.clock() + 1.2
		while Util.BasketCount() == before do
			local now = os.clock()
			if now >= t and (target.Config.Parent ~= nil or now >= t + 1.5) then
				break
			end
			RunService.Heartbeat:Wait()
		end

		removeManual(uid)
		Farm.Target = nil

		if before < Util.BasketCount() then
			Farm.Carried[uid] = target.Config
			collectedAny = true
		else
			blacklist[uid] = os.clock() + 20
		end
	end

	Farm.Target = nil
	if Util.BasketCount() > 0 then
		Farm.Deliver(nil)
	end
	return collectedAny
end


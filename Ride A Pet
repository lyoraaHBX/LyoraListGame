-- UI : FARM TAB (pindahan dari Player) - Instant Pickup
---------------------------------------------------------------------
FarmTab:CreateSection("Pickup", { Box = true })

do
	local original = {}
	local conns = {}

	local function apply(prompt)
		if not prompt:IsA("ProximityPrompt") then
			return
		end
		if original[prompt] == nil then
			original[prompt] = prompt.HoldDuration
		end
		if prompt.HoldDuration ~= 0 then
			prompt.HoldDuration = 0
		end
	end

	local function stop()
		for _, c in ipairs(conns) do
			c:Disconnect()
		end
		table.clear(conns)
		for prompt, value in pairs(original) do
			if prompt.Parent then
				pcall(function()
					prompt.HoldDuration = value
				end)
			end
		end
		table.clear(original)
	end

	local function start()
		stop()
		for _, d in ipairs(workspace:GetDescendants()) do
			if d:IsA("ProximityPrompt") then
				apply(d)
			end
		end
		table.insert(conns, workspace.DescendantAdded:Connect(function(d)
			if d:IsA("ProximityPrompt") then
				task.defer(apply, d)
			end
		end))
		table.insert(conns, ProximityPromptService.PromptShown:Connect(apply))
	end

	OnCleanup(stop)

	FarmTab:CreateToggle({
		Title = "Instant Pickup",
		Default = false,
		Flag = "InstantPickup",
		Callback = function(state)
			if state then
				start()
			else
				stop()
			end
		end,
	})
end


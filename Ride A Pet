function Util.RandomPlotPoint(margin, avoid, minDist)
	local base = Util.PlotBase()
	if not base then
		return nil
	end
	local hx = math.max(1, base.Size.X / 2 - margin)
	local hz = math.max(1, base.Size.Z / 2 - margin)
	local topY = base.Position.Y + base.Size.Y / 2
	local fallback = nil
	for _ = 1, 24 do
		local localPoint = Vector3.new(rng:NextNumber(-hx, hx), 0, rng:NextNumber(-hz, hz))
		local w = base.CFrame:PointToWorldSpace(localPoint)
		local point = Vector3.new(w.X, topY, w.Z)
		local ok = true
		if avoid then
			for _, other in ipairs(avoid) do
				if Vector3.new(other.X - point.X, 0, other.Z - point.Z).Magnitude < minDist then
					ok = false
					break
				end
			end
		end
		if ok then
			return point
		end
		fallback = fallback or point
	end
	return fallback
end


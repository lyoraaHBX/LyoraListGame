local function buildEggLabels()
	manualMap = {}
	local entries = {}
	local root = Util.Root()
	local origin = root and root.Position or Vector3.zero

	for _, cfg in ipairs(ActiveEggs:GetChildren()) do
		local eggName = cfg:GetAttribute("Egg")
		local pos = cfg:GetAttribute("Position")
		local privateTo = cfg:GetAttribute("PrivateTo")
		if type(eggName) == "string" and typeof(pos) == "Vector3" and (privateTo == nil or privateTo == localPlayer.UserId) then
			table.insert(entries, {
				Uid = cfg.Name,
				Name = eggName,
				Rarity = Util.EggRarity(eggName),
				Rank = Util.EggRank(eggName),
				Luck = Util.EggLuck(eggName) * (tonumber(cfg:GetAttribute("Weight")) or 1),
				Distance = (pos - origin).Magnitude,
			})
		end
	end

	table.sort(entries, function(a, b)
		if a.Rank ~= b.Rank then
			return a.Rank > b.Rank
		end
		if a.Luck ~= b.Luck then
			return a.Luck > b.Luck
		end
		return a.Distance < b.Distance
	end)

	local labels = {}
	for i, e in ipairs(entries) do
		if i > 40 then
			break
		end
		local label = string.format("%s | %s | %dm | #%s", e.Name, e.Rarity, math.floor(e.Distance), string.sub(e.Uid, 1, 4))
		manualMap[label] = e.Uid
		table.insert(labels, label)
	end

	if #labels == 0 then
		labels = { "No Eggs" }
	end
	manualLabels = labels
	return labels
end


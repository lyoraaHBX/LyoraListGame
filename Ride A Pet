local foodSelected = {}
local feedCooldown = {}

local foodChoices = {}
do
	if type(Data.Foods) == "table" then
		local tmp = {}
		for name, food in pairs(Data.Foods) do
			if type(food) == "table" then
				table.insert(tmp, { Name = name, Cost = tonumber(food.Cost) or 0 })
			end
		end
		table.sort(tmp, function(a, b)
			return a.Cost < b.Cost
		end)
		for _, f in ipairs(tmp) do
			table.insert(foodChoices, f.Name)
		end
	end
end

local function maxPets()
	return math.max(1, tonumber(localPlayer:GetAttribute("MaxPets")) or tonumber(Util.Saved("MaxPets")) or 5)
end

local function placedPetScore(pet)
	return Util.PetScore(pet:GetAttribute("PetName") or pet.Name, pet:GetAttribute("Weight"), pet:GetAttribute("Mutation"))
end

local function toolPetScore(tool)
	return Util.PetScore(Util.PetNameOf(tool), tool:GetAttribute("Weight"), tool:GetAttribute("Mutation"))
end

local function bestInventoryPet()
	local bestScore, best = -1, nil
	for _, tool in ipairs(Util.Tools("Pet")) do
		local s = toolPetScore(tool)
		if s > bestScore then
			bestScore, best = s, tool
		end
	end
	return best, bestScore
end

local function weakestPlacedPet()
	local weakScore, weak = math.huge, nil
	for _, pet in ipairs(plotPets()) do
		local s = placedPetScore(pet)
		if s < weakScore then
			weakScore, weak = s, pet
		end
	end
	return weak, weakScore
end

function Farm.PlaceWanted()
	if not On("AutoPlaceBestPets") then
		return false
	end
	local best, bestScore = bestInventoryPet()
	if not best then
		return false
	end
	if #plotPets() < maxPets() then
		return true
	end
	if On("SwapWeakerPets") then
		local _, weakScore = weakestPlacedPet()
		return bestScore > weakScore * 1.05
	end
	return false
end

local function placePet(tool, cancel)
	local key = tool:GetAttribute("PetKey")
	if not key then
		return false
	end
	local top = Util.PlotTop()
	if top then
		Util.FlyTo(top + Vector3.new(0, 4, 0), cancel, 20)
	end
	if not Util.Equip(tool) then
		return false
	end
	local pos = Util.RandomPlotPoint(10, nil, 0)
	if not pos then
		return false
	end
	local before = #plotPets()
	Util.Fire("PlacePet", key, pos + Vector3.new(0, 2, 0))
	task.wait(0.35)
	Util.Unequip()
	local t = os.clock() + 1.5
	while os.clock() < t and #plotPets() == before do
		RunService.Heartbeat:Wait()
	end
	return #plotPets() > before
end

function Farm.PlaceStep(cancel)
	local placed = 0
	for _ = 1, maxPets() do
		if cancel() or not Farm.PlaceWanted() then
			break
		end
		local tool = bestInventoryPet()
		if not tool then
			break
		end

		if #plotPets() < maxPets() then
			Util.Status = string.format("Placing %s", Util.PetNameOf(tool))
			if placePet(tool, cancel) then
				placed += 1
				continue
			end
			break
		end

		local weak = weakestPlacedPet()
		local key = weak and weak:GetAttribute("PetKey")
		if not key then
			break
		end
		Util.Status = "Swapping in a stronger pet"
		local top = Util.PlotTop()
		if top then
			Util.FlyTo(top + Vector3.new(0, 4, 0), cancel, 20)
		end
		Util.Fire("PickupPet", key)
		local t = os.clock() + 1.5
		while os.clock() < t and weak.Parent do
			RunService.Heartbeat:Wait()
		end
		if not weak.Parent then
			Util.Status = string.format("Placing %s", Util.PetNameOf(tool))
			if placePet(tool, cancel) then
				placed += 1
				continue
			end
		end
		break
	end
	return placed > 0
end

local function cheapestFoodTool()
	local bestCost, best = math.huge, nil
	for _, tool in ipairs(Util.Tools("Food")) do
		local amount = tool:FindFirstChild("Amount", true)
		if (amount and tonumber(amount.Value) or 1) > 0 and (next(foodSelected) == nil or foodSelected[tool.Name]) then
			local d = type(Data.Foods) == "table" and Data.Foods[tool.Name] or nil
			local cost = type(d) == "table" and tonumber(d.Cost) or 0
			if cost < bestCost then
				bestCost, best = cost, tool
			end
		end
	end
	return best
end

function Farm.FeedWanted()
	if not On("AutoFeedPets") or not cheapestFoodTool() then
		return false
	end
	local now = os.clock()
	for _, pet in ipairs(plotPets()) do
		local key = pet:GetAttribute("PetKey")
		if key and (feedCooldown[key] or 0) <= now then
			return true
		end
	end
	return false
end

function Farm.FeedStep(cancel)
	local pets = plotPets()
	table.sort(pets, function(a, b)
		return placedPetScore(a) > placedPetScore(b)
	end)

	local fed = 0
	for _, pet in ipairs(pets) do
		if cancel() then
			break
		end
		local key = pet:GetAttribute("PetKey")
		local food = cheapestFoodTool()
		if not food then
			break
		end
		if key and (feedCooldown[key] or 0) <= os.clock() then
			local ok, pos = pcall(function()
				return pet:GetPivot().Position
			end)
			if ok then
				Util.Status = string.format("Feeding %s", tostring(pet:GetAttribute("PetName") or pet.Name))
				Util.FlyTo(pos + Vector3.new(0, 4, 4), cancel, 8)
				if Util.Equip(food) then
					local age = pet:GetAttribute("Age")
					Util.Fire("FeedPet", key, food.Name)
					local t = os.clock() + 1.2
					while os.clock() < t and pet:GetAttribute("Age") == age do
						RunService.Heartbeat:Wait()
					end
					feedCooldown[key] = os.clock() + 2
					fed += 1
				end
			end
		end
	end
	Util.Unequip()
	return fed > 0
end

---------------------------------------------------------------------
-- MAIN FARM LOOP
---------------------------------------------------------------------
do
	local wake = false

	Farm.Wake = function()
		wake = true
	end

	local function carrying()
		if Util.BasketCount() <= 0 then
			return false
		end
		return next(Farm.Carried) ~= nil or os.clock() - Farm.LastPickupAt < 30
	end

	local function anythingWanted()
		return Farm.CollectActive() or carrying() or On("AutoPlantEggs") or On("AutoHatchEggs") or On("AutoPlaceBestPets") or On("AutoFeedPets")
	end

	local function shouldStop()
		return not running or not anythingWanted()
	end

	local function stopUnless(flag)
		return function()
			return shouldStop() or not On(flag)
		end
	end

	task.spawn(function()
		while running do
			local didWork = false

			if anythingWanted() and Util.Root() and Util.Plot() then
				Farm.Busy = true

				local ok = pcall(function()
					if Util.BasketCount() > 0 then
						Farm.Deliver(shouldStop)
						didWork = true
					end
					if On("AutoPlantEggs") and not shouldStop() then
						if Farm.PlantStep(stopUnless("AutoPlantEggs")) then
							didWork = true
						end
					end
					if Farm.HatchWanted() and not shouldStop() then
						if Farm.HatchStep(stopUnless("AutoHatchEggs")) then
							didWork = true
						end
					end
					if Farm.PlaceWanted() and not shouldStop() then
						if Farm.PlaceStep(stopUnless("AutoPlaceBestPets")) then
							didWork = true
						end
					end
					if Farm.FeedWanted() and not shouldStop() then
						if Farm.FeedStep(stopUnless("AutoFeedPets")) then
							didWork = true
						end
					end
					if Farm.CollectActive() and not shouldStop() then
						if Farm.CollectStep(function()
							return shouldStop() or not Farm.CollectActive()
						end) then
							didWork = true
						end
					end
				end)

				if not ok then
					Util.Unequip()
				end

				Farm.Busy = false

				if not didWork and not On("AutoCollectEggs") then
					Util.Status = "Waiting for work"
				end
			elseif not anythingWanted() then
				Util.Status = "Idle"
			end

			local waitTime = didWork and 0.15 or 1
			local untilT = os.clock() + waitTime
			while running and os.clock() < untilT and not wake do
				RunService.Heartbeat:Wait()
			end
			wake = false
		end
	end)
end


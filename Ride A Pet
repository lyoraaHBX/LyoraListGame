HomeTab:CreateSection("Egg Inventory")
local function cleanEggName(name)
    local n = tostring(name or "")
    n = n:gsub("%s+%d+%s*[Kk][Gg]?%s*$", "")
    return n:gsub("%s+%d+%s*$", ""):gsub("%s+$", "")
end
local function countEggs()
    local counts = {}
    local containers = {}
    local bp = pl:FindFirstChildOfClass("Backpack")
    if bp then table.insert(containers, bp) end
    if pl.Character then table.insert(containers, pl.Character) end
    for _, c in ipairs(containers) do
        for _, item in ipairs(c:GetChildren()) do
            if item:IsA("Tool") and item.Name:lower():find("egg", 1, true) then
                local base = cleanEggName(item.Name)
                counts[base] = (counts[base] or 0) + 1
            end
        end
    end
    return counts
end
local invText = "(belum discan)"
local function refreshInv()
    local counts = countEggs()
    local sorted, total = {}, 0
    for name, count in pairs(counts) do table.insert(sorted, { name = name, count = count }) total = total + count end
    table.sort(sorted, function(a, b) if a.count == b.count then return a.name < b.name end return a.count > b.count end)
    if #sorted == 0 then
        invText = "(no eggs in inventory)"
        return
    end
    local lines = {}
    for _, item in ipairs(sorted) do lines[#lines + 1] = item.name .. "  x  " .. item.count end
    invText = "Total: " .. total .. "\n" .. table.concat(lines, "\n")
end
pcall(refreshInv)
HomeTab:CreateButton({ Title = "Show Inventory", Callback = function() pcall(refreshInv) info(invText) end })
task.spawn(function()
    while not K do
        task.wait(3); if K then break end
        pcall(refreshInv)
    end
end)


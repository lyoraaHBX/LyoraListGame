local function findPlot(ownerPlayer)
    if not ownerPlayer then return nil end
    local ps = workspace:FindFirstChild("Plots")
    if not ps then return nil end
    for _, p in ipairs(ps:GetChildren()) do
        local d = p:FindFirstChild("Data")
        local o = d and d:FindFirstChild("Owner")
        if o then
            local m = false
            if o:IsA("ObjectValue") then m = o.Value == ownerPlayer
            elseif o:IsA("StringValue") then m = o.Value == ownerPlayer.Name or o.Value == ownerPlayer.DisplayName
            elseif o:IsA("IntValue") or o:IsA("NumberValue") then m = o.Value == ownerPlayer.UserId end
            if m then return p end
        end
    end
    return nil
end


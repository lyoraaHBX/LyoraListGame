local EO = {}
local function GEP(e)
    if e:IsA("Model") then return e:GetPivot().Position end
    if e:IsA("BasePart") then return e.Position end
    local p = e:FindFirstChildWhichIsA("BasePart", true)
    return p and p.Position
end
local function GKG(e)
    local A = {"KG","Kg","kg","Weight","weight"}
    for _, a in ipairs(A) do local v = e:GetAttribute(a) if v ~= nil then return tostring(v).." KG" end end
    for _, n in ipairs(A) do local v = e:FindFirstChild(n, true) if v and v:IsA("ValueBase") then return tostring(v.Value).." KG" end end
    return "KG: ?"
end
local function SESP(e)
    local en = normKey(e.Name) if en == "" then return false end
    for k, v in pairs(AE) do
        if v then
            local kn = normKey(k)
            if kn ~= "" and (en == kn or en:find(kn, 1, true) or kn:find(en, 1, true)) then return true end
        end
    end
    for k in pairs(SE) do
        local kn = normKey(k)
        if kn ~= "" and en:find(kn, 1, true) then return true end
    end
    return false
end

function normKey(name)
    local s = tostring(name or ""):lower()
    s = s:gsub("%s+", " "):gsub("^%s+", ""):gsub("%s+$", "")
    return s:gsub(" egg$", "")
end

local FIXED_ORDER = {volcanic=1, cherub=2, solaris=3, blackhole=4}
function resortList(lst)
    local fixed, others, seen = {}, {}, {}
    for _, k in ipairs(lst) do
        local n = normKey(k)
        if n ~= "" and not seen[n] then
            seen[n] = true
            if FIXED_ORDER[n] then fixed[#fixed+1] = {key=n, rank=FIXED_ORDER[n]}
            else others[#others+1] = n end
        end
    end
    table.sort(fixed, function(a,b) return a.rank < b.rank end)
    local out = {}
    for _, item in ipairs(fixed) do out[#out+1] = item.key end
    for _, n in ipairs(others) do out[#out+1] = n end
    return out
end


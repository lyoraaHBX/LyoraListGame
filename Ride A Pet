local WBEF, HD, RC = 3, 0, 3
local pend = {}
local function FP(e) for _, o in ipairs(e:GetDescendants()) do if o:IsA("ProximityPrompt") then return o end end end
local function GPP(p, e)
    if not p or not p.Parent then return nil end
    if p.Parent:IsA("BasePart") then return p.Parent end
    if e:IsA("BasePart") then return e end
    return e:FindFirstChildWhichIsA("BasePart", true)
end
local function CL(e, p)
    if not e or not p then return end
    for _ = 1, RC do
        if (not SYS and not AG_TARGET) or K or not e.Parent or not p.Parent then return end
        local r = RT() local pp = GPP(p, e)
        if not r or not pp then return end
        if (r.Position - pp.Position).Magnitude > PR then return end
        if p.Enabled then p:InputHoldBegin() task.wait(HD) if p.Parent then p:InputHoldEnd() end end
        task.wait(0.1)
    end
end
task.spawn(function()
    while task.wait(0.1) do
        if K then break end
        if not SYS and not AG_TARGET then continue end
        local r = RT() if not r then continue end
        for _, e in ipairs(EF:GetChildren()) do
            if e.Parent then
                local p = FP(e)
                if p then
                    local pp = GPP(p, e)
                    if pp and (r.Position - pp.Position).Magnitude <= PR and not pend[e] then
                        pend[e] = true
                        task.spawn(function()
                            task.wait(WBEF)
                            if (not SYS and not AG_TARGET) or K or not e.Parent or not p.Parent then pend[e] = nil return end
                            local cr = RT() local cp = GPP(p, e)
                            if not cr or not cp then pend[e] = nil return end
                            if (cr.Position - cp.Position).Magnitude <= PR then CL(e, p) end
                            pend[e] = nil
                        end)
                    end
                end
            end
        end
    end
end)

local function rebirthCost()
	local rebirths = Data.Rebirths
	local current = tonumber(Util.Saved("Rebirths")) or 0
	if type(rebirths) ~= "table" then
		return nil
	end
	local cap = tonumber(rebirths.Cap)
	if cap and current >= cap then
		return nil
	end
	if type(rebirths.GetCost) == "function" then
		local ok, result = pcall(rebirths.GetCost, current)
		if ok and tonumber(result) then
			return tonumber(result)
		end
	end
	return nil
end

task.spawn(function()
	local nextRebirth, nextIndex = 0, 0
	while running do
		local now = os.clock()
		if On("AutoRebirth") and now >= nextRebirth then
			local cost = rebirthCost()
			if cost and Util.Cash() >= cost then
				Util.Fire("Rebirth")
				nextRebirth = now + 15
			else
				nextRebirth = now + 3
			end
		end
		if On("AutoClaimIndex") and now >= nextIndex then
			Util.Fire("ClaimIndexReward")
			nextIndex = now + 60
		end
		task.wait(1)
	end
end)


local function plotEggs()
	local plot = Util.Plot()
	local eggs = plot and plot:FindFirstChild("Eggs")
	return eggs and eggs:GetChildren() or {}
end

local function plotPets()
	local plot = Util.Plot()
	local pets = plot and plot:FindFirstChild("Pets")
	return pets and pets:GetChildren() or {}
end

local function occupiedPoints()
	local points = {}
	for _, egg in ipairs(plotEggs()) do
		local ok, p = pcall(function()
			return egg:GetPivot().Position
		end)
		if ok then
			table.insert(points, p)
		end
	end
	for _, pet in ipairs(plotPets()) do
		local ok, p = pcall(function()
			return pet:GetPivot().Position
		end)
		if ok then
			table.insert(points, p)
		end
	end
	return points
end

function Farm.PlantStep(cancel)
	if os.clock() < plantBackoffUntil and #plotEggs() >= plantBackoffCount then
		return false
	end

	local tools = {}
	for _, tool in ipairs(Util.Tools("Egg")) do
		if plantMinRank <= Util.EggRank(tool.Name) then
			table.insert(tools, tool)
		end
	end
	if #tools == 0 then
		return false
	end

	table.sort(tools, function(a, b)
		return Util.EggLuck(a.Name) > Util.EggLuck(b.Name)
	end)

	local placed = 0
	for _, tool in ipairs(tools) do
		if cancel() then
			break
		end
		if not tool.Parent then
			continue
		end
		local pos = Util.RandomPlotPoint(8, occupiedPoints(), 5)
		if not pos then
			break
		end
		Util.Status = string.format("Planting %s", tool.Name)
		if not Util.Equip(tool) then
			break
		end
		local before = #plotEggs()
		Util.Fire("EggPlaced", { PlantPosition = pos })
		local t = os.clock() + 1.2
		while os.clock() < t and #plotEggs() == before do
			RunService.Heartbeat:Wait()
		end
		if before < #plotEggs() then
			placed += 1
		else
			plantBackoffUntil = os.clock() + 15
			plantBackoffCount = #plotEggs()
			break
		end
	end

	Util.Unequip()
	return placed > 0
end

local function readyEggs()
	local list = {}
	for _, egg in ipairs(plotEggs()) do
		local timer = egg:FindFirstChild("Timer", true)
		local hatch = egg:FindFirstChild("Hatch", true)
		if hatch and hatch:IsA("ProximityPrompt") and hatch.Enabled and timer and timer:IsA("TextLabel") and timer.Text == "Ready" then
			table.insert(list, { Egg = egg, Prompt = hatch })
		end
	end
	return list
end

function Farm.HatchWanted()
	return On("AutoHatchEggs") and #readyEggs() > 0
end

function Farm.HatchStep(cancel)
	local hatched = 0
	for _, item in ipairs(readyEggs()) do
		if cancel() then
			break
		end
		if item.Egg.Parent then
			local ok, pos = pcall(function()
				return item.Egg:GetPivot().Position
			end)
			if ok then
				Util.Status = "Hatching eggs"
				Util.FlyTo(pos + Vector3.new(0, 3, 3), cancel, 5)
				Util.FirePrompt(item.Prompt)
				local t = os.clock() + 2
				while os.clock() < t and item.Egg.Parent do
					RunService.Heartbeat:Wait()
				end
				if not item.Egg.Parent then
					hatched += 1
				end
			end
		end
	end
	if hatched > 0 then
		task.wait(0.5)
		Util.Unequip()
	end
	return hatched > 0
end


	Util.SetNoclip(false)
end)

local function PathPoints(from, to)
	if Vector3.new(to.X - from.X, 0, to.Z - from.Z).Magnitude < 80 and math.abs(to.Y - from.Y) < 30 then
		return { to }
	end
	local h = math.max(from.Y, to.Y) + Util.CruiseHeight
	return { Vector3.new(from.X, h, from.Z), Vector3.new(to.X, h, to.Z), to }
end

function Util.TravelTime(from, to)
	local total = 0
	local cur = from
	for _, p in ipairs(PathPoints(from, to)) do
		total += (p - cur).Magnitude
		cur = p
	end
	return total / math.max(Util.FlySpeed, 20)
end

function Util.FlyTo(target, cancel, tolerance)
	local root = Util.Root()
	if not root or typeof(target) ~= "Vector3" then
		return false
	end
	local tol = tolerance or 3
	if (root.Position - target).Magnitude <= tol then
		return true
	end
	local points = PathPoints(root.Position, target)
	local timeout = os.clock() + Util.TravelTime(root.Position, target) + 6
	Util.SetNoclip(true)

	local stepConn = RunService.Stepped:Connect(function()
		local char = localPlayer.Character
		if not char then
			return
		end
		for _, d in ipairs(char:GetDescendants()) do
			if d:IsA("BasePart") and d.CanCollide then
				d.CanCollide = false
			end
		end
	end)

	local idx = 1
	local arrived = false

	while os.clock() < timeout do
		if cancel and cancel() then
			break
		end
		local dt = RunService.Heartbeat:Wait()
		local r = Util.Root()
		if not r then
			break
		end
		local isLast = idx == #points
		local delta = points[idx] - r.Position
		local mag = delta.Magnitude
		if mag <= (isLast and tol or 2) then
			if isLast then
				arrived = true
				break
			else
				idx += 1
			end
		else
			local step = math.min(mag, math.max(Util.FlySpeed, 20) * dt)
			local flat = Vector3.new(delta.X, 0, delta.Z)
			local rot = flat.Magnitude > 0.1 and CFrame.lookAt(Vector3.zero, flat.Unit) or r.CFrame.Rotation
			pcall(function()
				r.CFrame = CFrame.new(r.Position + delta.Unit * step) * rot
				r.AssemblyLinearVelocity = Vector3.zero
				r.AssemblyAngularVelocity = Vector3.zero
			end)
		end
	end

	stepConn:Disconnect()
	Util.SetNoclip(false)

	local result = arrived
	local r = Util.Root()
	if r then
		pcall(function()
			r.AssemblyLinearVelocity = Vector3.zero
		end)
		if (r.Position - target).Magnitude <= tol + 1 then
			result = true
		end
	end
	return result
end


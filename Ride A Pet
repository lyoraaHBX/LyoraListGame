-- UI : FARM TAB (pindahan dari Player) - ESP
---------------------------------------------------------------------
FarmTab:CreateSection("ESP", { Box = true })

do
	local font = Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.ExtraBold, Enum.FontStyle.Normal)
	local espMinRank = 0
	local folder = nil
	local entries = {}
	local conns = {}

	local function styleLabel(label, height)
		label.BackgroundTransparency = 1
		label.FontFace = font
		label.TextScaled = true
		label.TextStrokeTransparency = 1
		label.TextColor3 = Color3.fromRGB(255, 255, 255)
		label.Size = UDim2.new(1, 0, 0, height)
		local stroke = Instance.new("UIStroke")
		stroke.Name = RandName()
		stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
		stroke.LineJoinMode = Enum.LineJoinMode.Round
		stroke.Color = Color3.fromRGB(0, 0, 0)
		stroke.Thickness = 1.8
		stroke.Transparency = 0.05
		stroke.Parent = label
	end

	local function removeEntry(cfg)
		local e = entries[cfg]
		if e then
			entries[cfg] = nil
			pcall(function()
				e.Gui:Destroy()
			end)
		end
	end

	local function addEntry(cfg)
		if entries[cfg] or not folder then
			return
		end
		local eggName = cfg:GetAttribute("Egg")
		local pos = cfg:GetAttribute("Position")
		if type(eggName) ~= "string" or typeof(pos) ~= "Vector3" then
			return
		end
		local privateTo = cfg:GetAttribute("PrivateTo")
		if privateTo ~= nil and privateTo ~= localPlayer.UserId then
			return
		end
		if Util.EggRank(eggName) < espMinRank then
			return
		end

		local rarity = Util.EggRarity(eggName)
		local gui = Instance.new("BillboardGui")
		gui.Name = RandName()
		gui.AlwaysOnTop = true
		gui.LightInfluence = 0
		gui.Size = UDim2.fromOffset(170, 46)
		gui.Adornee = workspace.Terrain
		gui.StudsOffsetWorldSpace = pos + Vector3.new(0, 4, 0)
		gui.MaxDistance = 100000

		local frame = Instance.new("Frame")
		frame.Name = RandName()
		frame.BackgroundTransparency = 1
		frame.Size = UDim2.fromScale(1, 1)
		frame.Parent = gui

		local layout = Instance.new("UIListLayout")
		layout.Name = RandName()
		layout.SortOrder = Enum.SortOrder.LayoutOrder
		layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
		layout.Parent = frame

		local title = Instance.new("TextLabel")
		title.Name = RandName()
		title.LayoutOrder = 1
		styleLabel(title, 24)
		title.Text = eggName
		title.TextColor3 = RarityColors[rarity] or Color3.fromRGB(255, 255, 255)
		title.Parent = frame

		local info = Instance.new("TextLabel")
		info.Name = RandName()
		info.LayoutOrder = 2
		styleLabel(info, 18)
		info.TextColor3 = Color3.fromRGB(230, 232, 240)
		info.Parent = frame

		gui.Parent = folder
		entries[cfg] = {
			Gui = gui,
			Info = info,
			Rarity = rarity,
			Position = pos,
			Weight = tonumber(cfg:GetAttribute("Weight")) or 1,
		}
	end

	local function stopESP()
		for _, c in ipairs(conns) do
			c:Disconnect()
		end
		table.clear(conns)
		for cfg in pairs(entries) do
			removeEntry(cfg)
		end
		if folder then
			pcall(function()
				folder:Destroy()
			end)
			folder = nil
		end
	end

	local function startESP()
		stopESP()
		folder = Instance.new("Folder")
		folder.Name = RandName()
		folder.Parent = GuiParent

		local children = ActiveEggs:GetChildren()
		task.spawn(function()
			local i = 1
			while folder and i <= #children do
				local budget = os.clock() + 0.004
				while i <= #children and os.clock() < budget do
					addEntry(children[i])
					i += 1
				end
				RunService.Heartbeat:Wait()
			end
		end)

		table.insert(conns, ActiveEggs.ChildAdded:Connect(function(child)
			task.defer(addEntry, child)
		end))
		table.insert(conns, ActiveEggs.ChildRemoved:Connect(removeEntry))

		local acc = 0
		table.insert(conns, RunService.Heartbeat:Connect(function(dt)
			acc += dt
			if acc < 0.5 then
				return
			end
			acc = 0
			local root = Util.Root()
			if not root then
				return
			end
			for _, e in pairs(entries) do
				e.Info.Text = string.format("%s  %.2fkg  %dm", e.Rarity, e.Weight, math.floor((e.Position - root.Position).Magnitude))
			end
		end))
	end

	OnCleanup(stopESP)

	FarmTab:CreateToggle({
		Title = "ESP Eggs",
		Default = false,
		Flag = "ESPEggs",
		Callback = function(state)
			if state then
				startESP()
			else
				stopESP()
			end
		end,
	})

	FarmTab:CreateDropdown({
		Title = "ESP Min Rarity",
		Options = RarityChoices,
		Default = RarityChoices[1],
		Flag = "ESPMinRarity",
		Callback = function(value)
			espMinRank = RarityRank[tostring(value)] or 0
			if On("ESPEggs") then
				startESP()
			end
		end,
	})
end

